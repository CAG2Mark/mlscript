:js


let rcd = { x: 0, y: undefined, z: null}
//│ rcd = {x: 0, y: undefined, z: null}

rcd.constructor
//│ = class Object

typeof(rcd.constructor)
//│ = "function"

Object.entries of rcd
//│ = [["x", 0], ["y", undefined], ["z", null]]


