fun f(x) = if x is
  Some(x) and x > 0 then 42
  None then "ok"
  else print("oops")
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f4;
//│ f4 = function f(x2) {
//│   let scrut1, arg$Some$0$1;
//│   if (x2 instanceof Some1.class) {
//│     arg$Some$0$1 = x2.value;
//│     scrut1 = arg$Some$0$1 > 0;
//│     if (scrut1 === true) {
//│       return 42
//│     }
//│     return Predef.print("oops");
//│   } else if (x2 instanceof None1.class) { return "ok" }
//│   return Predef.print("oops");
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(Some(0))
//│ > oops

f(Some(1))
//│ = 42

f(None)
//│ = "ok"

f(0)
//│ > oops


