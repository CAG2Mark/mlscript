data class C(a)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:C⁰
//│   sym = member:C¹
//│   ctorSym = S of term:C²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a¹
//│       _2 = term:C⁰/a²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:C⁰/a²
//│       sym = member:a¹
//│       rhs = SimpleRef of a⁰

fun f(x) = if x is C(a) then a else 0

f(C(27))
//│ = 27


fun f(x) = if x is C then 1 else 0

f(C(27))
//│ = 1


object M with
  data class D(a)
  val d = D(27)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending is part of: Scoped:
//│   syms = HashSet(tmp:tmp)
//│   body = Define:
//│     defn = ClsLikeDefn:
//│       owner = S of object:M⁰
//│       isym = class:D⁰
//│       sym = member:D¹
//│       ctorSym = S of term:M⁰/D²
//│       k = Cls
//│       paramsOpt = S of ParamList:
//│         params = Ls of
//│           Param:
//│             flags = (val)
//│             sym = a³
//│             modulefulness = Modulefulness of N
//│       publicFields = Ls of
//│         Tuple2:
//│           _1 = member:a⁴
//│           _2 = term:D⁰/a⁵
//│       ctor = Define:
//│         defn = ValDefn:
//│           tsym = term:D⁰/a⁵
//│           sym = member:a⁴
//│           rhs = SimpleRef of a³
//│     rest = Assign: \
//│     lhs = tmp:tmp⁰
//│     rhs = Call:
//│       fun = Select{sym=term:M⁰/D²}:
//│         qual = This of object:M⁰
//│         name = Ident of "D"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of IntLit of 27
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:M⁰/d⁰
//│       sym = member:d¹
//│       rhs = SimpleRef of tmp:tmp⁰

M.d
//│ = D(27)

fun f(x) = if x is M.D then 1 else 0

M.D.class
//│ = class D

M is M.D
//│ = false

f(M.d)
//│ = 1

f(M.D(27))
//│ = 1


fun f(x) = if x is M.D(a) then a else 0

f(M.d)
//│ = 27

f(M.D(27))
//│ = 27


