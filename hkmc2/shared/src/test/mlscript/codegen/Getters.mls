:js
:noInline


:sjs
fun t = 42
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let t; t = function t() { return 42 };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:expect 42
:sjs
t
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return t()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


fun main() =
  let n = 0
  fun foo =
    print("ok")
    set n += 1
    n
  foo + foo

:expect 3
main()
//│ > ok
//│ > ok
//│ = 3


:sjs
fun test() =
  fun whoops =
    print("ok")
    42
  whoops + whoops
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let test;
//│ test = function test() {
//│   let whoops, tmp, tmp1;
//│   whoops = function whoops() {
//│     Predef.print("ok");
//│     return 42
//│   };
//│   tmp = whoops();
//│   tmp1 = whoops();
//│   return tmp + tmp1
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

test()
//│ > ok
//│ > ok
//│ = 84


