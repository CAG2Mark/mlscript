//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = label⁰
//│         modulefulness = Modulefulness of N
//│   auxParams = Ls of
//│     ParamList:
//│       params = Ls of
//│         Param:
//│           flags = (val)
//│           sym = x⁶
//│           modulefulness = Modulefulness of N
//│         Param:
//│           flags = (val)
//│           sym = y⁶
//│           modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Point⁰
//│       sym = member:coords⁰
//│       dSym = term:Point⁰/coords¹
//│       params = Ls of
//│         ParamList: ‹empty›
//│       body = Return of Tuple:
//│         mut = false
//│         elems = Ls of
//│           Arg:
//│             value = Select{sym=term:Point⁰/x⁷}:
//│               qual = This of class:Point⁰
//│               name = Ident of "x"
//│           Arg:
//│             value = Select{sym=term:Point⁰/y⁷}:
//│               qual = This of class:Point⁰
//│               name = Ident of "y"
//│   privateFields = Ls of
//│     term:Point⁰/x⁷
//│     term:Point⁰/y⁷
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:label¹
//│       _2 = term:Point⁰/label²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Point⁰/label²
//│       sym = member:label¹
//│       rhs = SimpleRef of label⁰
//│     rest = AssignField: \
//│     lhs = This of class:Point⁰
//│     nme = Ident of "x"
