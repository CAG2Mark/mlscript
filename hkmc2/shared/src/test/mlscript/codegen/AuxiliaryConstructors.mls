//│     rest = AssignField: \
//│     lhs = This of class:Point⁰
//│     nme = Ident of "y"
//│     rhs = SimpleRef of y⁶

Point("A")(1, 2).coords()
//│ = [1, 2]


// === Single aux param list on class with main params ===

