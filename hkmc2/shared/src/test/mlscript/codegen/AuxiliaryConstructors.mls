:js


// === Basic constructor with single param list ===

// Plain class with constructor(x, y) generates JS constructor with field assignments
:sjs
class Foo with
  constructor(x, y)
  fun getX = x
  fun getY = y
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   ctorSym = S of term:Foo²
//│   k = Cls
//│   auxParams = Ls of
//│     ParamList:
//│       params = Ls of
//│         Param:
//│           sym = x⁰
//│           modulefulness = Modulefulness of N
//│         Param:
//│           sym = y⁰
//│           modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Foo⁰
//│       sym = member:getX⁰
//│       dSym = term:Foo⁰/getX¹
//│       body = Return of Select{sym=term:Foo⁰/x¹}:
//│         qual = This of class:Foo⁰
//│         name = Ident of "x"
//│     FunDefn:
//│       owner = S of class:Foo⁰
//│       sym = member:getY⁰
//│       dSym = term:Foo⁰/getY¹
//│       body = Return of Select{sym=term:Foo⁰/y¹}:
//│         qual = This of class:Foo⁰
//│         name = Ident of "y"
//│   privateFields = Ls of
//│     term:Foo⁰/x¹
//│     term:Foo⁰/y¹
//│   ctor = AssignField:
//│     lhs = This of class:Foo⁰
//│     nme = Ident of "x"
//│     rhs = SimpleRef of x⁰
//│     rest = AssignField: \
//│     lhs = This of class:Foo⁰
//│     nme = Ident of "y"
//│     rhs = SimpleRef of y⁰
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Foo1;
//│ (class Foo {
//│   static {
//│     Foo1 = this
//│   }
//│   constructor(x, y) {
//│     this.#x = x;
//│     this.#y = y;
//│   }
//│   #x;
//│   #y;
//│   get getX() {
//│     return this.#x;
//│   }
//│   get getY() {
//│     return this.#y;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "Foo"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let f = new Foo(1, 2)
//│ f = Foo

f.getX
//│ = 1

f.getY
//│ = 2


// === Multiple constructor param lists ===

// constructor(x, y)(u, v) flattens into single JS constructor
class Bar with
  constructor(x, y)(u, v)
  fun sum() = x + y + u + v
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Bar⁰
//│   sym = member:Bar¹
//│   ctorSym = S of term:Bar²
//│   k = Cls
//│   auxParams = Ls of
//│     ParamList:
//│       params = Ls of
//│         Param:
//│           sym = x²
//│           modulefulness = Modulefulness of N
//│         Param:
//│           sym = y²
//│           modulefulness = Modulefulness of N
//│     ParamList:
//│       params = Ls of
//│         Param:
//│           sym = u⁰
//│           modulefulness = Modulefulness of N
//│         Param:
//│           sym = v⁰
//│           modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Bar⁰
//│       sym = member:sum⁰
//│       dSym = term:Bar⁰/sum¹
//│       params = Ls of
//│         ParamList: ‹empty›
//│       body = Scoped(syms = {tmp:tmp⁰, tmp:tmp¹}):
//│         body = Assign:
//│           lhs = tmp:tmp⁰
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Bar⁰/x³}:
//│                     qual = This of class:Bar⁰
//│                     name = Ident of "x"
//│                 Arg:
//│                   value = Select{sym=term:Bar⁰/y³}:
//│                     qual = This of class:Bar⁰
//│                     name = Ident of "y"
//│           rest = Assign: \
//│           lhs = tmp:tmp¹
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of tmp:tmp⁰
//│                 Arg:
//│                   value = Select{sym=term:Bar⁰/u¹}:
//│                     qual = This of class:Bar⁰
//│                     name = Ident of "u"
//│           rest = Return of Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of tmp:tmp¹
//│                 Arg:
//│                   value = Select{sym=term:Bar⁰/v¹}:
//│                     qual = This of class:Bar⁰
//│                     name = Ident of "v"
//│   privateFields = Ls of
//│     term:Bar⁰/x³
//│     term:Bar⁰/y³
//│     term:Bar⁰/u¹
//│     term:Bar⁰/v¹
//│   ctor = AssignField:
//│     lhs = This of class:Bar⁰
//│     nme = Ident of "x"
//│     rhs = SimpleRef of x²
//│     rest = AssignField: \
//│     lhs = This of class:Bar⁰
//│     nme = Ident of "y"
//│     rhs = SimpleRef of y²
//│     rest = AssignField: \
//│     lhs = This of class:Bar⁰
//│     nme = Ident of "u"
//│     rhs = SimpleRef of u⁰
//│     rest = AssignField: \
//│     lhs = This of class:Bar⁰
//│     nme = Ident of "v"
//│     rhs = SimpleRef of v⁰

let b = new Bar(1, 2)(3, 4)
//│ b = Bar

b.sum()
//│ = 10


// === Main params + constructor (aux params) ===

// Foo(a, b) with { constructor(x, y)(u, v) } should have (a, b) as main
// and [(x, y), (u, v)] as aux param lists
class Baz(a, b) with
  constructor(x, y)(u, v)
  fun total() = a + b + x + y + u + v
