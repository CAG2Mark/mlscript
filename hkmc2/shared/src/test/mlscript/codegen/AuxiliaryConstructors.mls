//│                 Arg:
//│                   value = Select{sym=term:Baz⁰/b¹}:
//│                     qual = This of class:Baz⁰
//│                     name = Ident of "b"
//│           rest = Assign: \
//│           lhs = tmp:tmp³
//│           rhs = Call:
