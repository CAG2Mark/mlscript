//│ = 21


// === Data class with constructor ===

data class Point(label) with
  constructor(x, y)
  fun coords() = [x, y]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Point⁰
//│   sym = member:Point¹
