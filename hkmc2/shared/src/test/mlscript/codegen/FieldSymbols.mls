:js


data class Foo(val x) with
  val y = x
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   ctorSym = S of term:Foo²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:Foo⁰/x²
//│     Tuple2:
//│       _1 = member:y⁰
//│       _2 = term:Foo⁰/y¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁰/x²
//│       sym = member:x¹
//│       rhs = SimpleRef of x⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Foo⁰/y¹
//│       sym = member:y⁰
//│       rhs = Select{sym=term:Foo⁰/x²}:
//│         qual = This of class:Foo⁰
//│         name = Ident of "x"


