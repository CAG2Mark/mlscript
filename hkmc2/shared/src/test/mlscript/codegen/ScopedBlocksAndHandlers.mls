// if `z` and `g` are defined in a nested scoped block
// and `g` is floated out to the top level, `z` in `g` gets unbound.
// so currently nested `if`s do not get nested `Scoped` blocks
// * Note: ^ seems this is an outdated comment on an old test case
// * Note: The whole thing used to optimize away the inner match, as it was empty,
// *  but now the stupid `return runtime⁰.Unit⁰` continuation is moved into the `else` branch
// *  so the match is no longer removbed. (Room for improvement.)
:soir
:sjs
fun f(x) =
  if x do
    if x do
      let z = 3
      fun g() = z
