//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2
//│ x = 1


// * Notice that the IR has two symbols: the BlockMemberSymbol x² but also the more specific TermSymbol x³.
// * This is because x² could be overloaded and contain other definitions, such as a type definition.
// * In the end, the JS just uses one variable.
:sjs
val x = 1
x + 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define x² as val x³ = 1; return +⁰(x³, 1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x2; x2 = 1; return x2 + 1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2
//│ x = 1


