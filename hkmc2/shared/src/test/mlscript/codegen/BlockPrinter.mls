//│       fun = SimpleRef of builtin:+⁰
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = SimpleRef of x⁰
//│           Arg:
//│             value = Lit of IntLit of 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ set x⁰ = 1; return +⁰(x⁰, 1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2
//│ x = 1

x
