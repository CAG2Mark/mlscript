:js


// * JavaScript classes have built-in non-writable `name` and `length` properties,
// * which can't be set directly by a normal assignment.

// * Notice:
:re
:noModuleCheck
module M with
  set this."name" = "oops"
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:M⁰
//│   ctor = AssignDynField:
//│     lhs = This of module:M⁰
//│     fld = Lit of StrLit of "name"
//│     arrayIdx = false
//│     rhs = Lit of StrLit of "oops"
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'name' of function 'class M {   static {     M1 = this   }   static {     M["name"] = "oops";   }   toString() { return runtime.ren...<omitted>... }'

// * So we use `Object.defineProperty` instead:
:sjs
module M with
  val name = "Student"
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:M¹
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:name⁰
//│       _2 = term:M¹/name¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:M¹/name¹
//│       sym = member:name⁰
//│       rhs = Lit of StrLit of "Student"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let M3;
//│ (class M2 {
//│   static {
//│     M3 = this
//│   }
//│   static {
//│     Object.defineProperty(M2, "name", { configurable: true, enumerable: true, writable: true, value: "Student" });
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// * Non-static definitions should be unaffected:
:sjs
class C with
  val name = "Student"
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:C⁰
//│   sym = member:C¹
//│   k = Cls
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:name²
