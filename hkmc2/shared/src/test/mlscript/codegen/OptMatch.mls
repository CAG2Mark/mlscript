//│   ctorSym = S of term:Foo⁰/Other²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = v⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:v¹
//│       _2 = term:Other⁰/v²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Other⁰/v²
