val isOther = x => if x is
  Foo.Other(_) then true
  None    then false
//│ isOther = fun


fun keepIfGreaterThan(x, y) =
  if x > y then Some(x) else None


1 keepIfGreaterThan(0) isDefined()
//│ = true

1
  keepIfGreaterThan(0)
  isDefined()
  console.log()
//│ > true

1
  \ keepIfGreaterThan(0)
//│ = Some(1)


1
  \ keepIfGreaterThan(0)
  \ isDefined()
  \ console.log()
//│ > true


1
  |> (keepIfGreaterThan(_, 0))
  |> (isDefined(_))
//│ = true

1
  |> {keepIfGreaterThan(_, 0)}
  |> {isDefined(_)}
//│ = true

1
  |>
    keepIfGreaterThan(_, 0)
  |>
    isDefined(_)
//│ = true


let isDefined2 = _ is Some
//│ isDefined2 = fun isDefined2

Some(1) isDefined2()
//│ = true

Some(1) |> isDefined2
//│ = true


