:js


fun foo() =
  1 + 2

foo
//│ = fun foo

foo()
//│ = 3

fun foo(x) =
  x + 1

foo(123)
//│ = 124

fun foo(x) =
  x + 1 + 2

foo(123)
//│ = 126

fun foo() = bar()
fun bar() = 42

bar()
//│ = 42

foo()
//│ = 42

fun foo() = bar()
let r = foo()
fun bar() = 42
r
//│ = 42
//│ r = 42

// * This fails to properly initialize, as expected
:re
:noInline
fun foo() = bar()
let r = foo()
fun bar() = r
//│ ═══[RUNTIME ERROR] Error: MLscript call unexpectedly returned `undefined`, the forbidden value.
//│ r = undefined

// * Similar
:re
object Outer with
  fun foo() = bar()
  val r = foo()
  fun bar() = r
Outer.r
