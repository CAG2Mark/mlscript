set foo.x = 42

:expect 42
foo.x
//│ = 42

import "../../mlscript-compile/NoFreeze.mls"

let foo = NoFreeze.foo()
//│ foo = Foo(0)

set foo.x = 42

:expect 42
foo.x
//│ = 42
