:js


object Test with
  fun bar = 1
  fun foo() = bar + 1
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Test⁰
//│   sym = member:Test¹
//│   k = Obj
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of object:Test⁰
//│       sym = member:bar⁰
//│       dSym = term:Test⁰/bar¹
//│       body = Return of Lit of IntLit of 1
//│     FunDefn:
//│       owner = S of object:Test⁰
//│       sym = member:foo⁰
//│       dSym = term:Test⁰/foo¹
//│       params = Ls of
//│         ParamList: ‹empty›
//│       body = Return of Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Test⁰/bar¹}:
//│                 qual = This of object:Test⁰
//│                 name = Ident of "bar"
//│             Arg:
//│               value = Lit of IntLit of 1

// TODO: make this a type error
// Using the old partial logic in Elaborator, this used to report:
//     ╔══[COMPILATION ERROR] [debinding error] Method 'foo' cannot be accessed without being called.
//     ║  l.9: 	let f = Test.foo
//     ╙──     	            ^^^^
// :e
let f = Test.foo
//│ f = fun foo

:re
f()
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'bar')

// TODO: make this a type error
// :e
:re
let f = id(Test).foo
//│ ═══[RUNTIME ERROR] Error: [debinding error] Method 'foo' of class 'Test' was accessed without being called.
//│ f = undefined

// * Note that dynamic member accesses are not checked against debinding:
let f = Test.("foo")
//│ f = fun foo

:re
f()
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'bar')


// * I tried compiling selections to essentially the following,
// * but it doesn't work since many things in JS are "functions"
// * (and notably may have fields, which are not preserved by `bind`):

let g = if f is Function then f.bind(Test) else f
//│ g = fun bound foo

g()
//│ = 2


// * TODO we should probably compile the above as:

object Test with
  fun bar = 1
  fun foo() = Test.bar + 1
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Test²
//│   sym = member:Test³
//│   k = Obj
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of object:Test²
//│       sym = member:bar²
//│       dSym = term:Test²/bar³
//│       body = Return of Lit of IntLit of 1
//│     FunDefn:
//│       owner = S of object:Test²
//│       sym = member:foo²
//│       dSym = term:Test²/foo³
//│       params = Ls of
//│         ParamList: ‹empty›
//│       body = Return of Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Test²/bar³}:
//│                 qual = MemberRef{disamb=object:Test²}:
//│                   bms = member:Test³
//│                   disamb = object:Test²
//│                 name = Ident of "bar"
//│             Arg:
//│               value = Lit of IntLit of 1

let f = Test.("foo")
//│ f = fun foo

f()
//│ = 2


// * Which also works well no matter where the object is defined:

fun test() =
  object Test with
    fun bar = 1
    fun foo() = Test.bar + 1
  [Test]

let f = test().0.("foo")
//│ f = fun foo

f()
//│ = 2


// * However, it would disable open recursion upon object inheritance (eg `class C extends Test with ...`).
// * But it would be better to require open recursion to be explicitly indicated by `virtual` anyway.


