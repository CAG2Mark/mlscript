//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:hd¹
//│       _2 = term:Cons⁰/hd²
//│     Tuple2:
//│       _1 = member:tl¹
//│       _2 = term:Cons⁰/tl²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Cons⁰/hd²
//│       sym = member:hd¹
//│       rhs = SimpleRef of hd⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Cons⁰/tl²
//│       sym = member:tl¹
//│       rhs = SimpleRef of tl⁰

:sjs
fun f(ls) =
  while ls is
    Cons(h, tl) then
      set ls = tl
      print(h)
  // else print("Done!")
  print("Done!")
