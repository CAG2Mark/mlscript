// * Mix of local mutable variable, while loop and lambdas
:expect 2
fun f() =
  let
    cnt = 2
    savedLambda = null
  while cnt > 0 do
    let local = cnt
    if cnt == 2 do
      // This lambda should always return 2,
      // since local is 2 and not reassigned in the while loop
      savedLambda = () => local
    set cnt -= 1
  // Calls the saved lambda
  savedLambda()
f()
//│ = 2


class Lazy[out A](f: () -> A) with
  mut val cached: A | () = ()
  fun get =
    if cached === () do
      set cached = f()
    cached
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Lazy⁰
//│   sym = member:Lazy¹
//│   ctorSym = S of term:Lazy²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         sym = f⁰
//│         sign = S of FunTy:
//│           lhs = Tup of Nil
//│           rhs = Ref{sym=A²} of A²
//│         modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Lazy⁰
//│       sym = member:get⁰
//│       dSym = term:Lazy⁰/get¹
//│       body = Scoped(syms = {tmp:scrut¹, tmp:tmp⁰}):
//│         body = Assign:
//│           lhs = tmp:scrut¹
//│           rhs = Call:
//│             fun = SimpleRef of builtin:===⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Lazy⁰/cached⁰}:
//│                     qual = This of class:Lazy⁰
//│                     name = Ident of "cached"
//│                 Arg:
//│                   value = Select{sym=object:Unit⁰}:
//│                     qual = SimpleRef of tmp:runtime⁰
//│                     name = Ident of "Unit"
//│           rest = Match: \
//│           scrut = SimpleRef of tmp:scrut¹
//│           arms = Ls of
//│             Tuple2:
//│               _1 = Lit of BoolLit of true
//│               _2 = Assign:
//│                 lhs = tmp:tmp⁰
//│                 rhs = Call:
//│                   fun = Select{sym=term:Lazy⁰/f¹}:
//│                     qual = This of class:Lazy⁰
//│                     name = Ident of "f"
//│                   argss = Ls of
//│                     Nil
//│                 rest = Begin: \
//│                 sub = AssignField:
//│                   lhs = This of class:Lazy⁰
//│                   nme = Ident of "cached"
//│                   rhs = SimpleRef of tmp:tmp⁰
//│                 rest = Return of Select{sym=term:Lazy⁰/cached⁰}:
//│                   qual = This of class:Lazy⁰
//│                   name = Ident of "cached"
//│           dflt = S of Return of Select{sym=term:Lazy⁰/cached⁰}:
//│             qual = This of class:Lazy⁰
//│             name = Ident of "cached"
//│           rest = End of "Rest moved to non-abortive branch(es)"
//│   privateFields = Ls of
//│     term:Lazy⁰/f¹
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:cached¹
//│       _2 = term:Lazy⁰/cached⁰
//│   ctor = AssignField:
//│     lhs = This of class:Lazy⁰
//│     nme = Ident of "f"
//│     rhs = SimpleRef of f⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Lazy⁰/cached⁰
//│       sym = member:cached¹
//│       rhs = Select{sym=object:Unit⁰}:
//│         qual = SimpleRef of tmp:runtime⁰
//│         name = Ident of "Unit"


:expect [1, 2, 3]
:lift
:rewriteWhile
let arr = [1, 2, 3]
let output = mut []
let i = 0
while i < arr.length do
  let elem = arr.[i]
  output.push(new Lazy(() => elem))
  set i += 1
[output.[0].get, output.[1].get, output.[2].get]
//│ = [1, 2, 3]
//│ arr = [1, 2, 3]
//│ i = 3
//│ output = [Lazy(_), Lazy(_), Lazy(_)]

:expect [1, 2, 3]
:lift
let arr = [1, 2, 3]
let output = mut []
let i = 0
while i < arr.length do
  let elem = arr.[i]
  output.push(new Lazy(() => elem))
  set i += 1
[output.[0].get, output.[1].get, output.[2].get]
//│ = [1, 2, 3]
//│ arr = [1, 2, 3]
//│ i = 3
//│ output = [Lazy(_), Lazy(_), Lazy(_)]


