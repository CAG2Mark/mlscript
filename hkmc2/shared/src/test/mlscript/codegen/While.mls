//│   return Predef.print("Done!")
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(0)
//│ > Done!

f(Cons(1, 0))
//│ > 1
//│ > Done!

f(Cons(1, Cons(2, Cons(3, 0))))
//│ > 1
//│ > 2
//│ > 3
//│ > Done!

