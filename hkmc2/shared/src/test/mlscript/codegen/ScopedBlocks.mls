//│     break;
//│   }
//│   return runtime.Unit
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// `:rewriteWhile` turns while loop into functions
:sjs
:rewriteWhile
fun f(x) =
  while x do
    let y = x
    print(x)
