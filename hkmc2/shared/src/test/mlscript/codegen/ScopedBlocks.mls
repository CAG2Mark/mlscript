fun f() =
  if true then
    let a = 4
    a + 4
  else
    let b = 5
    b + 9


// TODO: improve later: `let a` can be moved to the branch body
// NOTE: `tmp1` and `tmp2` should indeed be declared in the top level of the function body
:sjs
fun g(x, y, z) =
  3 + 4 * if
    x then 0
    y then 0
    z then
      let a = 1
      (_ + a)
