fun f() = if x is
  A(a, b) and a > b then true
  B(c, d) then false



fun f() = if A(1, Nil) is
  A(1, Nil) then 3




fun f(x) =
  x = while x is
    A(a, _) then a()
    B(a, _) then a()
  else
    x()
  x




fun f() =
  let y = x + 1
  while y is
    A(z, a) and
      false and true do
        set y = z + 1
      else
        y = a



fun f(x, y) =
  while x && y do
    f(0, 0) + 4




