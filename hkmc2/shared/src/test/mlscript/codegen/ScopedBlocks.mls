//│       Predef.print(x1);
//│       return while1()
//│     }
//│     return runtime.LoopEnd;
//│   });
//│   tmp1 = while1();
//│   tmp2 = tmp1 !== runtime.LoopEnd;
//│   if (tmp2 === true) { return tmp1 }
//│   return runtime.Unit;
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————



