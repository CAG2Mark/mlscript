:js


:sir
data class Foo()
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   ctorSym = S of term:Foo²
//│   k = Cls
//│   paramsOpt = S of ParamList: ‹empty›
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @data define Foo¹ as class Foo⁰ { constructor Foo² }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * Notice that `Foo¹` correctly refers to the ClassCtorSymbol of `Foo` shown above
:sir
Foo
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return Foo²
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun Foo { class: class Foo }

Foo()
//│ = Foo()

Foo.class
//│ = class Foo


:sir
object Foo with
  class C()
  print(C)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   owner = S of object:Foo³
//│   isym = class:C⁰
//│   sym = member:C¹
//│   ctorSym = S of term:Foo³/C²
//│   k = Cls
//│   paramsOpt = S of ParamList: ‹empty›
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Foo⁴ as object Foo³ {
//│   constructor() {
//│     define C¹ as class C⁰ { constructor C² };
//│     do Predef⁰.print⁰(Foo³.this.C²);
//│     end
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > fun C { class: class C }

// * The owner of the C¹ constructor function is correctly identified as Foo
:lot
Foo.C
//│ —————————————| Lowered IR Tree |————————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Return of Select{sym=term:Foo³/C²}:
//│     qual = MemberRef{disamb=object:Foo³}:
//│       bms = member:Foo⁴
//│       disamb = object:Foo³
//│     name = Ident of "C"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun C { class: class C }


data class Foo(a)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁵
//│   sym = member:Foo⁶
//│   ctorSym = S of term:Foo⁷
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a¹
//│       _2 = term:Foo⁵/a²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁵/a²
//│       sym = member:a¹
//│       rhs = SimpleRef of a⁰

Foo
//│ = fun Foo { class: class Foo }

Foo(1)
//│ = Foo(1)

Foo(1).a
//│ = 1

fun foo(y) = Foo(y)
foo(27)
//│ = Foo(27)


data class Foo(a, b)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁸
//│   sym = member:Foo⁹
//│   ctorSym = S of term:Foo¹⁰
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a³
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = b⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a⁴
//│       _2 = term:Foo⁸/a⁵
//│     Tuple2:
//│       _1 = member:b¹
//│       _2 = term:Foo⁸/b²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁸/a⁵
//│       sym = member:a⁴
//│       rhs = SimpleRef of a³
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Foo⁸/b²
//│       sym = member:b¹
//│       rhs = SimpleRef of b⁰

let foo = Foo
//│ foo = fun Foo { class: class Foo }

let f = foo(1, 2)
//│ f = Foo(1, 2)

let f = new! foo(1, 2)
//│ f = Foo(1, 2)

f.a
//│ = 1

f.b
//│ = 2

let f = Foo(1, 2)
//│ f = Foo(1, 2)

f.a
//│ = 1

f.b
//│ = 2

Foo(print(1), print(2))
//│ > 1
//│ > 2
//│ = Foo((), ())


data class Inner(c) with
  fun i1(d) = c + d
  print(c)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Inner⁰
//│   sym = member:Inner¹
//│   ctorSym = S of term:Inner²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = c⁰
//│         modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Inner⁰
//│       sym = member:i1⁰
//│       dSym = term:Inner⁰/i1¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = d⁰
//│               modulefulness = Modulefulness of N
//│       body = Return of Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Inner⁰/c¹}:
//│                 qual = This of class:Inner⁰
//│                 name = Ident of "c"
//│             Arg:
//│               value = SimpleRef of d⁰
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:c²
//│       _2 = term:Inner⁰/c¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Inner⁰/c¹
//│       sym = member:c²
//│       rhs = SimpleRef of c⁰
//│     rest = Assign: \
//│     lhs = ‹no symbol›
//│     rhs = Call:
//│       fun = Select{sym=term:Predef⁰/print⁰}:
//│         qual = MemberRef{disamb=module:Predef⁰}:
//│           bms = member:Predef¹
//│           disamb = module:Predef⁰
//│         name = Ident of "print"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Select{sym=term:Inner⁰/c¹}:
//│               qual = This of class:Inner⁰
//│               name = Ident of "c"

let i = new Inner(100)
//│ > 100
//│ i = Inner(100)

i.i1(20)
//│ = 120


// * This is strange, but does not need to be an error
:sjs
class Foo(x, val y, z, val z, z) with
  let x = 1
  let y += 1
  print("x = " + x)
  print("y = " + y)
  print("this.y = " + this.y)
  print("z = " + z)
  print("this.z = " + this.z)
