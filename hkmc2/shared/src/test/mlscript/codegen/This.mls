// * Note: a module that induces a `this`-proxy
// :sjs
class A(x) with
  module M with
    print(x)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:M⁰
//│   ctor = Assign:
//│     lhs = ‹no symbol›
//│     rhs = Call:
//│       fun = Select{sym=term:Predef⁰/print⁰}:
//│         qual = MemberRef{disamb=module:Predef⁰}:
//│           bms = member:Predef¹
//│           disamb = module:Predef⁰
//│         name = Ident of "print"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Select{sym=term:A⁰/x²}:
//│               qual = This of class:A⁰
//│               name = Ident of "x"

A(42)
//│ > 42
//│ = A(_)


