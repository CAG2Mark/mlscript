//│ = 123

(new Foo.C(123)).x
//│ = 123

let c = Foo.C
//│ c = fun C { class: class C }

c(123)
//│ = C(123)

:e
new c(123)
//│ ╔══[COMPILATION ERROR] Expected a statically known class; found reference.
//│ ║  l.42: 	new c(123)
