:js


fun test() =
  data class C(a) with { fun f() = a }
  C(0).f()

test()
//│ = 0


:sjs
fun test(a) =
  data class Inner(b) with
    print(a)
    fun f(c) = [a, b, c]
    fun g(d) =
      fun h(e) = [a, b, d, e]
      h(d)
  Inner(42)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let test1;
//│ test1 = function test(a) {
//│   let Inner1;
//│   Inner1 = function Inner(b) {
//│     return globalThis.Object.freeze(new Inner.class(b));
//│   };
//│   (class Inner {
//│     static {
//│       Inner1.class = this
//│     }
//│     constructor(b) {
//│       this.b = b;
//│       Predef.print(a);
//│     }
//│     f(c) {
//│       return globalThis.Object.freeze([
//│         a,
//│         this.b,
//│         c
//│       ])
//│     }
//│     g(d) {
//│       return globalThis.Object.freeze([
//│         a,
//│         this.b,
//│         d,
//│         d
//│       ])
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["class", "Inner", ["b"]];
//│   });
//│   return Inner1(42)
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let i = test(100)
//│ > 100
//│ i = Inner(42)

i.f(200)
//│ = [100, 42, 200]

i.g(200)
//│ = [100, 42, 200, 200]


:sjs
fun test(a) =
  data class C1(b) with
    print of [a, b]
  data class C2(b) with
    print of [a, b]
  [C1(1), C2(2)]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let test2;
//│ test2 = function test(a1) {
//│   let C12, C22, tmp1, tmp2;
//│   C12 = function C1(b) {
//│     return globalThis.Object.freeze(new C1.class(b));
//│   };
//│   (class C11 {
//│     static {
//│       C12.class = this
//│     }
//│     constructor(b) {
//│       let tmp3;
//│       this.b = b;
//│       tmp3 = globalThis.Object.freeze([
//│         a1,
//│         this.b
//│       ]);
//│       Predef.print(tmp3);
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["class", "C1", ["b"]];
//│   });
//│   C22 = function C2(b) {
//│     return globalThis.Object.freeze(new C2.class(b));
//│   };
//│   (class C21 {
//│     static {
//│       C22.class = this
//│     }
//│     constructor(b) {
//│       let tmp3;
//│       this.b = b;
//│       tmp3 = globalThis.Object.freeze([
//│         a1,
//│         this.b
//│       ]);
//│       Predef.print(tmp3);
//│     }
//│     toString() { return runtime.render(this); }
//│     static [definitionMetadata] = ["class", "C2", ["b"]];
//│   });
//│   tmp1 = C12(1);
//│   tmp2 = C22(2);
//│   return globalThis.Object.freeze([ tmp1, tmp2 ])
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

test(123)
//│ > [123, 1]
//│ > [123, 2]
//│ = [C1(1), C2(2)]


