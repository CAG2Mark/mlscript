fun f(x) = g(x)
fun g(x) = h(x)
fun h(x) = fib(x)
f(5)
//│ > CALL f(5)
//│ > | CALL g(5)
//│ > | | CALL h(5)
//│ > | | | CALL fib(5)
//│ > | | | | CALL fib(4)
