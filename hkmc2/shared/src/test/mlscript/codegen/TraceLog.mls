//│ > | | | | | => 1
//│ > | | | | => 2
//│ > | | | => 5
//│ > | | => 5
//│ > | => 5
//│ > => 5
//│ = 5


abstract class E: S | N
data class S(x) with
  fun toString() = "S(" + x + "): " + toInt(succ(x))
class N() with
  fun toString() = "N: 0" 
fun succ(x) = S(x)
fun toInt(x) = if x is
  N then 0
  S(n) then 1 + toInt(n)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:E⁰
//│   sym = member:E¹
//│   k = Cls


(S(S(N()))).toString()
//│ > CALL toString()
//│ > | CALL toString()
//│ > | | CALL toString()
//│ > | | => 'N: 0'
//│ > | | CALL succ(N {})
//│ > | | => S { x: N {} }
//│ > | | CALL toInt(S { x: N {} })
//│ > | | | CALL toInt(N {})
//│ > | | | => 0
//│ > | | => 1
//│ > | => 'S(N: 0): 1'
//│ > | CALL succ(S { x: N {} })
//│ > | => S { x: S { x: N {} } }
//│ > | CALL toInt(S { x: S { x: N {} } })
//│ > | | CALL toInt(S { x: N {} })
//│ > | | | CALL toInt(N {})
//│ > | | | => 0
//│ > | | => 1
//│ > | => 2
//│ > => 'S(S(N: 0): 1): 2'
//│ = "S(S(N: 0): 1): 2"


data class Cls(a, b, c, d, e, f)
fun id(y) =
  if y ==
    0 then Cls("aaaa", "bbbb", "cccc", "dddd", "eeee", "ffff")
    else
      id(y - 1)
      0
