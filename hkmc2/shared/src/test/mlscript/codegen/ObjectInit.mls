fun f = print(A)
object A with
  f // A is not fully initialized yet but can still be accessed
  val x = 1
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:A⁰
//│   sym = member:A¹
//│   k = Obj
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x⁰
//│       _2 = term:A⁰/x¹
//│   ctor = Assign:
//│     lhs = ‹no symbol›
//│     rhs = Call:
//│       fun = MemberRef{disamb=term:f⁰}:
//│         bms = member:f¹
//│         disamb = term:f⁰
//│       argss = Ls of
//│         Nil
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:A⁰/x¹
//│       sym = member:x⁰
//│       rhs = Lit of IntLit of 1
//│ > A {}

// * By contrast:
fun f = print(A)
class Acls with
  f // A is not accessible at all here
  val x = 1
val A = new Acls
