:js


object Example with
  val a = 1
  fun f(x) = [x, a]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Example⁰
//│   sym = member:Example¹
//│   k = Obj
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of object:Example⁰
