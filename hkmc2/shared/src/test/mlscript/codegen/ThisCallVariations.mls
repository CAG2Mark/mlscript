//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = x⁰
//│               modulefulness = Modulefulness of N
//│       body = Return of Tuple:
//│         mut = false
//│         elems = Ls of
//│           Arg:
//│             value = SimpleRef of x⁰
//│           Arg:
//│             value = Select{sym=term:Example⁰/a⁰}:
//│               qual = This of object:Example⁰
//│               name = Ident of "a"
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a¹
//│       _2 = term:Example⁰/a⁰
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Example⁰/a⁰
//│       sym = member:a¹
//│       rhs = Lit of IntLit of 1

Example.f(2)
//│ = [2, 1]

let oops = Example.("f")
//│ oops = fun f


// * JavaScript nonsense
:re
oops(2)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'a')

oops.call(Example, 2)
//│ = [2, 1]


// * We could use that syntax as a shorthand:
fun (.!.) call(receiver, f)(arg) = f.call(receiver, arg)


// * Notice how it parses with the correct precedence:
:pt
:sjs
Example .!. oops(2)
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ App:
//│   lhs = OpApp:
//│     lhs = Ident of "Example"
//│     op = Ident of ".!."
//│     rhss = Ls of
//│       Ident of "oops"
//│   rhs = Tup of Ls of
//│     IntLit of 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = oops; return runtime.safeCall(f.call(Example1, 2))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [2, 1]

Example.!. oops(2)
//│ = [2, 1]

Example .!.oops(2)
//│ = [2, 1]


id(Example) .!. oops(2)
//│ = [2, 1]


:e
data class Example2(val a) with
  val a = 1
  fun f(inc) = Example2(a + inc)
//│ ╔══[COMPILATION ERROR] Duplicate definition of member named 'a'.
//│ ╟── Defined at: 
//│ ║  l.92: 	data class Example2(val a) with
//│ ║        	                        ^
//│ ╟── Defined at: 
//│ ║  l.93: 	  val a = 1
//│ ╙──      	  ^^^^^^^^^
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Example2⁰
//│   sym = member:Example2¹
//│   ctorSym = S of term:Example2²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a²
//│         modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Example2⁰
//│       sym = member:f²
//│       dSym = term:Example2⁰/f³
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = inc⁰
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:tmp⁰}):
//│         body = Assign:
//│           lhs = tmp:tmp⁰
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Example2⁰/a³}:
//│                     qual = This of class:Example2⁰
//│                     name = Ident of "a"
//│                 Arg:
//│                   value = SimpleRef of inc⁰
//│           rest = Return of Call:
//│             fun = MemberRef{disamb=term:Example2²}:
//│               bms = member:Example2¹
//│               disamb = term:Example2²
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of tmp:tmp⁰
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a⁴
//│       _2 = term:Example2⁰/a³
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Example2⁰/a³
//│       sym = member:a⁴
//│       rhs = Lit of IntLit of 1

let oops2 = Example2(0).("f")
//│ oops2 = fun f

Example2(1) .!. oops2(2) .!. oops2(2)
//│ = Example2(1)

Example2(1).!. oops2(2).!. oops2(2)
//│ = Example2(1)

(new Example2(1)) .!. oops2(2)
//│ = Example2(1)

new Example2(1)
  .!. oops2(2)
//│ = Example2(1)

new Example2(1)
  .!. oops2(2)
  .!. oops2(2)
//│ = Example2(1)


// * Alternative syntax – precedence is now inappropriate
fun (.>) call(receiver, f)(arg) = f.call(receiver, arg)

:pt
:sjs
:re
Example .> oops(2)
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ OpApp:
//│   lhs = Ident of "Example"
//│   op = Ident of ".>"
//│   rhss = Ls of
//│     App:
//│       lhs = Ident of "oops"
//│       rhs = Tup of Ls of
//│         IntLit of 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp6; tmp6 = runtime.safeCall(oops(2)); return call1(Example1, tmp6)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'a')

// * Note:
:re
oops(2)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'a')

// * Note:
(Example .> oops)(2)
//│ = [2, 1]


// * Another alternative syntax – currently adopted in Predef
fun (|>.) call(receiver, f)(arg) = f.call(receiver, arg)

Example |>. oops(2)
//│ = [2, 1]

Example2(1) |>. oops2(2) |>. oops2(2)
//│ = Example2(1)

(Example2(1)
  |>. oops2(2)
  |>. oops2(2)
).a
//│ = 1


