// * Notice that `b` is removed by DPE
:soir
module M with
  private fun g(b) = b
  g(2)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:M⁰
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of module:M⁰
//│       sym = member:g⁰
//│       dSym = term:M⁰/g¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = b⁰
