//│       body = Return of SimpleRef of b⁰
//│   ctor = Assign:
//│     lhs = ‹no symbol›
//│     rhs = Call:
//│       fun = Select{sym=term:M⁰/g¹}:
//│         qual = This of module:M⁰
//│         name = Ident of "g"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of IntLit of 2
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define M¹ as class M²
//│ module M⁰ { constructor { do M⁰.this.g¹(); end } method g⁰ = fun g¹() { return undefined } };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


