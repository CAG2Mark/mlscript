//│ f = Foo(_)

:re
f.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

:re
f.y
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'

:re
f.y()
//│ ═══[RUNTIME ERROR] TypeError: f.y is not a function

:expect 3
f.z
//│ = 3

let y = f.oops
//│ y = fun #y

// * This is actually a case of method debindng
:re
y()
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading '#x')

y.call(f)
//│ = 2

// * Privacy in JS is class-based, not instance-based, so this works
:expect 3
y.call(new Foo(2))
//│ = 3

let y = f.oops2
//│ y = fun #y

:re
y()
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading '#x')

y.call(f)
//│ = 2


