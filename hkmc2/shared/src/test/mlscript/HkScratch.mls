:noInline
:noOpt
:noTailRec
fun fact(bruh) =
  if bruh === 0 then 1 else bruh * fact(bruh - 1)
fact(10)
//│ = 3628800

:sjs
fun f(x) = if x > 0 then f(x - 1) else return 0
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
