//│ x = A
//│ y = 2
//│ z = 2

:noOpt
:noInline
:sir
:effectHandlers
fun foo =
  if x is A and
    y is A and
      z is 2 then print("a")
    y is 2 then print("b")
  else
    print("hi")
    print("hi")
  print("abcd")
foo
