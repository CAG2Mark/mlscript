let id = 0
//│ id = 0

class MaybeStop with
  fun f(x: Bool): ()

:effectHandlers
:sjs
fun handleEffects() =
  handle h1 = MaybeStop with
    fun f(x)(k) =
      if x then
        print("h1 stop")
      else
        set id += 1
        let cur = id
        print("h1 start " + String(cur))
        let result = k(x)
        print("h1 end " + String(cur))
        result
  h1.f(false)
