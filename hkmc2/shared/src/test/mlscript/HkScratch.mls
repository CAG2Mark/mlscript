abstract class Generator with
  fun produce(result): ()

let pad = ""
fun permutations_impl(gen, l1, l2) =
  let oldPad = pad
  set pad += " |"
  if l2 is
    [f, ...t] do
      handle genWithPrefix = Generator with
        fun produce(result)(resume) =
          result.unshift(f)
          gen.produce(result)
          resume(())
      permutations_impl(genWithPrefix, mut [], l1.concat(t))
      l1.push(f)
      permutations_impl(gen, l1, t)
    [] and l1 is [] do
      gen.produce(mut [])
  set pad = oldPad
fun permutations(gen, l) =
  permutations_impl(gen, mut [], l)
//│ pad = ""

class G with
  fun produce(res) = console.log(res)

fun permutations_foreach(l) =
  permutations(new G, l)
permutations_foreach([1, 2, 3, 4])
