//│     let scrut, tmp1;
//│     scrut = x > 0;
//│     if (scrut === true) { tmp1 = x - 1; x = tmp1; continue loopLabel }
//│     return 0;
//│   }
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

fun one = 1

:sjs
:noOpt
:noInline
:noTailRec
:expect "Hello World!"
handle h = Object with
  fun perform(arg)(k) =
    print(arg)
    k(arg)
fun myFun() = h.perform("Hello") + " World!"
