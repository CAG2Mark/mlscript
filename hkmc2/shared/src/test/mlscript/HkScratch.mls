class Effect

:effectHandlers
:stackSafe
:lift
let selfApp(f) = f(f)
//│ selfApp = fun

:effectHandlers
:stackSafe
:lift
:sir
:noInline
:noOpt
:deadParamElim off
fun mkrec(g) =
  selfApp(self => g(y => self(self)(y)))
