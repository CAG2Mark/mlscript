// :pt
// :elt

:global
// :d
// :todo
:effectHandlers
:lift

// functions and lambdas inside handlers
:stackSafe 100
:expect 50005000
fun foo(h) = h.perform()
handle h = Object with
  fun perform()(resume) =
    let f = ()
    set f = n =>
      if n <= 0 then 0
      else n + f(n-1)
    resume(f(10000))
foo(h)
//│ = 50005000
