class A

:noOpt
:noInline
:sjs
let x = new A
let y = 2
let z = 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x, y, z; x = globalThis.Object.freeze(new A1()); y = 2; z = 2;
