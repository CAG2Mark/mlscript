//│     do Predef⁰.print⁰(tmp1);
//│     set tmp2 = +⁰(y, 1);
//│     return Predef⁰.print⁰(tmp2)
//│   };
//│   match x
//│     0 =>
//│       set y = 0;
//│       set tmp = runtime⁰.Unit⁰;
//│       return rest⁰()
//│     else
//│       set y = 1;
//│       set tmp = runtime⁰.Unit⁰;
//│       return rest⁰()
//│   end
//│ };
//│ end
