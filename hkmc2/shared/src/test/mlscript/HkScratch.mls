class Effect

:effectHandlers
:deadParamElim off
:noOpt
:noInline
:sjs
let selfApp(f) = f(f)
fun mkrec(g) =
  selfApp of self =>
    g of y => self(self)(y)
let fact = mkrec of self => x =>
  if x == 0 then 1 else self(x - 1) * x
fact(3)
