class Foo with
  val a = 123
module Foo with
  fun foo(x: Foo) = x.a
//│ —————————————————| Flowed |—————————————————————————————————————————————————————————————————————————
//│   class Foo {
//│     val a⁰ ‹flow:a⁰› = 123
//│   },
//│   module Foo {
//│     fun foo⁰(x⁰: Foo⁰{ ~> Foo⁰ }) ‹flow:foo⁰› = x⁰.a‹?›{ ~> x⁰.a⁰ }
//│   }
//│ where
//│     x⁰  <~  type Foo
//│     flow:a⁰  <~  123
//│     flow:foo⁰  <~  ((type Foo) -> flow:a⁰)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:Foo⁰
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of module:Foo⁰
//│       sym = member:foo⁰
//│       dSym = term:Foo⁰/foo¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = x⁰
//│               sign = S of Resolved{sym=class:Foo¹}:
//│                 t = Ref{sym=member:Foo²} of member:Foo²
//│                 sym = class:Foo¹
//│               modulefulness = Modulefulness of N
//│       body = Return of Select{sym=term:Foo¹/a⁰}:
//│         qual = SimpleRef of x⁰
//│         name = Ident of "a"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

