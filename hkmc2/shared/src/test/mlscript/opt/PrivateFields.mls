//│   methods = Ls of
//│     FunDefn:
//│       owner = S of object:Foo⁰
//│       sym = member:test1⁰
//│       dSym = term:Foo⁰/test1¹
//│       body = Scoped(syms = {res⁰, tmp:tmp⁰}):
//│         body = Assign:
//│           lhs = res⁰
//│           rhs = Select{sym=term:Foo⁰/state⁰}:
//│             qual = This of object:Foo⁰
//│             name = Ident of "state"
//│           rest = Assign: \
//│           lhs = tmp:tmp⁰
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Foo⁰/state⁰}:
//│                     qual = This of object:Foo⁰
//│                     name = Ident of "state"
//│                 Arg:
//│                   value = Lit of IntLit of 1
//│           rest = AssignField: \
//│           lhs = This of object:Foo⁰
//│           nme = Ident of "state"
//│           rhs = SimpleRef of tmp:tmp⁰
//│           rest = Return of SimpleRef of res⁰
//│     FunDefn:
//│       owner = S of object:Foo⁰
//│       sym = member:test2⁰
//│       dSym = term:Foo⁰/test2¹
//│       body = AssignField:
//│         lhs = This of object:Foo⁰
//│         nme = Ident of "state"
//│         rhs = Lit of IntLit of 0
//│         rest = Assign: \
//│         lhs = ‹no symbol›
//│         rhs = Select{sym=term:Foo⁰/test1¹}:
//│           qual = This of object:Foo⁰
//│           name = Ident of "test1"
//│         rest = Return of Select{sym=term:Foo⁰/state⁰}:
//│           qual = This of object:Foo⁰
//│           name = Ident of "state"
//│   privateFields = Ls of
//│     term:Foo⁰/state⁰
//│   ctor = AssignField:
//│     lhs = This of object:Foo⁰
//│     nme = Ident of "state"
//│     rhs = Lit of IntLit of 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define Foo¹ as object Foo⁰ {
//│   private val state⁰;
//│   constructor() {
//│     set Foo⁰.this.state⁰ = 1;
//│     end
//│   }
//│   method test1⁰ = fun test1¹ {
//│     let res, tmp;
//│     set res = Foo⁰.this.state⁰;
//│     set tmp = +⁰(Foo⁰.this.state⁰, 1);
//│     set Foo⁰.this.state⁰ = tmp;
//│     return res
//│   }
//│   method test2⁰ = fun test2¹ {
//│     set Foo⁰.this.state⁰ = 0;
//│     do Foo⁰.this.test1¹;
//│     return Foo⁰.this.state⁰
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

