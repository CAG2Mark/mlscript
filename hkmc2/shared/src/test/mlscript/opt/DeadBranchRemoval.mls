:js

#config(deadBranchRemoval: true)


data class C(a)
data class D(b)
data class E(c)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:C⁰
//│   sym = member:C¹
//│   ctorSym = S of term:C²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a¹
//│       _2 = term:C⁰/a²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:C⁰/a²
//│       sym = member:a¹
//│       rhs = SimpleRef of a⁰


if true then 1 else 0
//│ = 1


// * Properly removes the `D` branch and the whole match
// :dopt
:soir
if C(123) is
  C(x) then print(x)
  D(y) then print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$; set scrut = C²(123); set arg$C$0$ = scrut.a²; return Predef⁰.print⁰(arg$C$0$)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123


// * Properly removes the `else` branch
:soir
if C(123) is
  C(x) then print(x)
  else print("?")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$; set scrut = C²(123); set arg$C$0$ = scrut.a²; return Predef⁰.print⁰(arg$C$0$)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123


// :dopt
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  else print("?")
//│ > 123

:expect 0
:soir
let c = if hide(true) then C(123) else D(456)
in
  print(c)
  if c is
    C then 0
    D then 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, tmp;
//│ set scrut = Predef⁰.hide⁰(true);
//│ match scrut
//│   true =>
//│     set tmp = C²(123);
//│     end
//│   else
//│     set tmp = D⁰(456);
//│     end
//│ do Predef⁰.print⁰(tmp);
//│ match tmp
//│   C⁰ =>
//│     return 0
//│   D¹ =>
//│     return 1
//│   else
//│     unreachable /* exhaustive match */
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > C(123)
//│ = 0


// * Properly removes the `E` branch
:expect 123
:soir
let c = if hide(true) then C(123) else D(456)
in
  print(c) // * Prevents case-of-case optimization from distributing the match into the branches
  if c is
    C(x) then {print(x), x}
    D(y) then {print(y), y}
    E(z) then {print(z), z}
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, tmp, arg$D$0$, arg$C$0$;
//│ set scrut = Predef⁰.hide⁰(true);
//│ match scrut
//│   true =>
//│     set tmp = C²(123);
//│     end
//│   else
//│     set tmp = D⁰(456);
//│     end
//│ do Predef⁰.print⁰(tmp);
//│ match tmp
//│   C⁰ =>
//│     set arg$C$0$ = tmp.a²;
//│     do Predef⁰.print⁰(arg$C$0$);
//│     return arg$C$0$
//│   D¹ =>
//│     set arg$D$0$ = tmp.b⁰;
//│     do Predef⁰.print⁰(arg$D$0$);
//│     return arg$D$0$
//│   else
//│     unreachable /* exhaustive match */
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > C(123)
//│ > 123
//│ = 123

