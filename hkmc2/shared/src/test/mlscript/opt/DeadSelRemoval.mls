:soir
do
  val x = 2 + 2
  val y = print(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰(2); return runtime⁰.Unit⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2


scope.locally of (
  val x = 1
  val y = print(2)
  123
)
//│ > 2
//│ = 123


// :soir
module Foo with
  mut val x = 1
  fun y =
    set x += 1
    print(x)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:Foo⁰
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of module:Foo⁰
//│       sym = member:y⁰
//│       dSym = term:Foo⁰/y¹
//│       body = Scoped(syms = {tmp:tmp⁰}):
//│         body = Assign:
//│           lhs = tmp:tmp⁰
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Foo⁰/x⁰}:
//│                     qual = This of module:Foo⁰
//│                     name = Ident of "x"
//│                 Arg:
//│                   value = Lit of IntLit of 1
//│           rest = AssignField: \
//│           lhs = This of module:Foo⁰
//│           nme = Ident of "x"
//│           rhs = SimpleRef of tmp:tmp⁰
//│           rest = Return of Call:
//│             fun = Select{sym=term:Predef⁰/print⁰}:
//│               qual = MemberRef{disamb=module:Predef⁰}:
//│                 bms = member:Predef¹
//│                 disamb = module:Predef⁰
//│               name = Ident of "print"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Foo⁰/x⁰}:
//│                     qual = This of module:Foo⁰
//│                     name = Ident of "x"
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:Foo⁰/x⁰
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁰/x⁰
//│       sym = member:x¹
//│       rhs = Lit of IntLit of 1

Foo.x
//│ = 1

// * The first selection is pure and can be removed
:soir
Foo.x, Foo.x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return Foo⁰.x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * TODO: also optimize
Foo.x; Foo.x
//│ = 1

// * Cannot remove the first selection!
:soir
:expect 2
Foo.y, Foo.x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Foo⁰.y¹; return Foo⁰.x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ = 2

:expect 3
Foo.y; Foo.x
//│ > 3
//│ = 3


let a = Foo.x in Foo.x
//│ = 3

:expect 4
let a = Foo.y in Foo.x
//│ > 4
//│ = 4


(
  val a = print("hi")
  42
)
//│ > hi
//│ = 42

