// LIFO
handle h = ThreadEffect with
  fun fork(thread)(k) =
    @native this.tasks.unshift(thread)
    k(())
  fun yld()(k) =
    @native this.tasks.push(() => k(()))
    enterHandleBlock(this, () => (@native this.tasks.shift())())
  fun start(main)(k) =
    this.tasks.push(() => mainn(this))
    while this.tasks.length != 0 do
      enterHandleBlock(this, () => (@native this.tasks.shift())())
    k(())
in
  h.start(mainn)
