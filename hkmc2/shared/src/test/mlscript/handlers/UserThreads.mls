:js
:effectHandlers
:lift


abstract class ThreadEffect with
  val tasks = mut []
  fun start(thread: () -> ()): ()
  fun fork(thread: () -> ()): ()
  fun yld(): ()

class Lock(val locked) with
  fun lock(th: ThreadEffect) =
    while locked do
      th.yld()
    set locked = true
  fun unlock() =
    set locked = false

fun f(h, x) =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h) =
  print("main start")
  h.fork(() => f(h, 0))
  h.fork(() => f(h, 1))
  h.fork(() => f(h, 2))
  print("main end")


// LIFO
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.unshift(thread)
    k(())
  fun yld()(k) =
    this.tasks.push(() => k(()))
    enterHandleBlock(this, () => this.tasks.shift()())
  fun start(main)(k) =
    this.tasks.push(() => main(this))
    while this.tasks.length != 0 do
      enterHandleBlock(this, () => this.tasks.shift()())
    k(())
in
  h.start(main)
