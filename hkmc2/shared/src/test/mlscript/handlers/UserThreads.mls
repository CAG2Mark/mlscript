import "../../mlscript-compile/Option.mls"
open Option

abstract class ThreadEffect with
  fun fork(thread: ThreadEffect -> ()): ()
  fun yld(): ()
  fun xchg(x: Int): Int

val tasks = mut []
fun enqueue(k, x) =
  tasks.push(() => k(x))
fun dequeue() =
  if tasks.length != 0 do
    tasks.shift()()
