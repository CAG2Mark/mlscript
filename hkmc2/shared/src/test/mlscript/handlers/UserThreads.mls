fun main(h) =
  h.fork(h =>
    print("[t1] Sending 0")
    let v = h.xchg(0)
    print("[t1] received " + v.toString()))
  h.fork(h =>
    print("[t2] Sending 1")
    let v = h.xchg(1)
    print("[t2] received " + v.toString()))
