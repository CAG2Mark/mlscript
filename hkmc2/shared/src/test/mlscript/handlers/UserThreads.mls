// Adapted from: https://ocaml.org/manual/5.3/effects.html

abstract class ThreadEffect with
  fun fork(thread: ThreadEffect -> ()): ()
  fun yld(): ()

val tasks = mut []
//│ tasks = []

fun f(x)(h) =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h) =
  print("main start")
  h.fork(f(0))
  h.fork(f(1))
  h.fork(f(2))
  print("main end")

fun dequeue() =
  if tasks.length != 0 do
    tasks.shift()(())

fun start(thread: ThreadEffect -> ()) =
  handle h = ThreadEffect with
    fun fork(new_thread)(k) =
      tasks.push(k)
      start(new_thread)
    fun yld()(k) =
      tasks.push(k)
      dequeue()
  in
    thread(h)
  dequeue()
