fun start(thread: ThreadEffect -> ()) =
  handle h = ThreadEffect with
    fun fork(new_thread)(k) =
      @native tasks.push(k)
      start(new_thread)
    fun yld()(k) =
      @native tasks.push(k)
      dequeue()
  in
    thread(h)
  dequeue()
