abstract class ThreadEffect with
  val tasks = mut []
  fun start(thread: () -> ()): ()
  fun fork(thread: () -> ()): ()
  fun yld(): ()

class Lock(locked) with
  fun lock(th: ThreadEffect) =
    while locked do
      th.yld()
    set locked = true
  fun unlock() =
    set locked = false
