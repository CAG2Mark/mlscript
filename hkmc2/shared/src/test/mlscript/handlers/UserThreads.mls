  h.fork(f(2))
  print("main end")

fun dequeue() =
  if tasks.length != 0 do
    tasks.shift()(())

fun start(thread: ThreadEffect -> ()) =
  handle h = ThreadEffect with
    fun fork(new_thread)(k) =
      tasks.push(k)
      start(new_thread)
    fun yld()(k) =
      tasks.push(k)
      dequeue()
  in
    thread(h)
  dequeue()
