class Eff with
  fun perform(): ()
data class Box(n)
let box = new mut Box(0)
//│ box = Box(0)


:expect 5120
fun f(h, box, n) =
  if n <= 1 then
    h.perform()
  else
    handle h2 = Eff with
      fun perform()(k) =
        set box.n = box.n + 1
        h.perform()
        k()
    f(h2, box, n - 1)
    f(h2, box, n - 1)
handle h = Eff with
  fun perform()(k) =
    set box.n = box.n + 1
    k()
f(h, box, 10)
box.n
