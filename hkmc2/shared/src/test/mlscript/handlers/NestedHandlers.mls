:js
:effectHandlers

open annotations

let id = 0
//│ id = 0

// FIXME: if the following 2 blocks are together, lifter causes class ordering issue
class MaybeStop with
  fun f(x: Bool): ()

fun handleEffects(g) =
  handle h1 = MaybeStop with
    fun f(x)(k) =
      if x then
        print("h1 stop")
      else
        set id += 1
        let cur = id
        print("h1 start " + @native String(cur))
        let result = k(x)
        print("h1 end " + @native String(cur))
        result
  handle h2 = MaybeStop with
    fun f(x)(k) =
      if x then
        print("h2 stop")
      else
        set id += 1
        let cur = id
        print("h2 start " + @native String(cur))
        let result = k(x)
        print("h2 end " + @native String(cur))
        result
  g(h1, h2)


fun f(h1, h2) =
  h1.f(false)
  h2.f(false)
  h1.f(false)
  h2.f(false)
  h1.f(false)
  h2.f(false)
handleEffects(f)
