:js
:effectHandlers

abstract class Effect with
  fun perform(): ()

let h1 = null
handle h = Effect with
  fun perform()(k) =
    print("perform")
    k()
    print("perform-end")
set h1 = h
//│ h1 = Handler$h$

:re
h1.perform()
//│ = Suspend(fun cpsId, Handler$h$, fun Handler$h$perform)
//│ FAILURE: Unexpected lack of runtime error

enterHandleBlock(h1, () => h1.perform())
