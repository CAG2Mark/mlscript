:js
:effectHandlers
:lift
:stackSafe

let selfApp(f) = f(f)
//│ selfApp = fun tmp

fun mkrec(g) =
  selfApp of self =>
    g of y => self(self)(y)

let fact = mkrec of self => x =>
  if x == 0 then 1 else self(x - 1) * x
fact
//│ = fun lambda$here
//│ fact = fun lambda$here

