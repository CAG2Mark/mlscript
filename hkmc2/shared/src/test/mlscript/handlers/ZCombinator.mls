// simplified version without lambdas for easier debugging
:stackSafe 6
fun mkrec(g) =
  fun a(self) =
    fun b(y) = selfApp(self)(y)
    g(b)
  selfApp(a)

open annotations

:stackSafe 6
import "../../mlscript-compile/Runtime.mls"
let fact =
  fun a(self) =
    fun b(x) =
      if x == 0 then 1 else
        let prev = self(x - 1)
        @native console.log("resumed:", x)
        x * prev
    b
  mkrec(a)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: mkQuery (JSBackendDiffMaker.scala:255)
//│ ═══[RUNTIME ERROR] Error: MLscript call unexpectedly returned `undefined`, the forbidden value.
//│     at Runtime.checkCall (file:///storage/mark/Repos/mlscript/hkmc2/shared/src/test/mlscript-compile/Runtime.mjs:786:41)
//│     at a (REPL67:1:1018)
//│     at a (REPL61:1:626)
//│     at lambda3 (REPL55:1:138)
//│     at mkrec (REPL61:1:668)
//│     at REPL67:1:1193
//│     at process.processTicksAndRejections (node:internal/process/task_queues:104:5)
//│     at async node:repl:660:31
//│ fact = fun b

