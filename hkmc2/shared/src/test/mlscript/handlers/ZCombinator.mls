:js
:effectHandlers
:stackSafe

let selfApp(f) = f(f)
//│ selfApp = fun selfApp

fun mkrec(g) =
  selfApp of self =>
    g of y => self(self)(y)

let fact = mkrec of self => x =>
  if x == 0 then 1 else self(x - 1) * x
fact
//│ = fun
//│ fact = fun

fact(3)
//│ = 6

fact(10)
//│ = 3628800

:re
:stackSafe off
fact(10000)
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

:stackSafe
fun mkrec(g) =
  selfApp of self =>
    g of y => selfApp(self)(y)

// * FIXME: Why doesn't the following work when using Predef function `(==) equals`?
let fact = mkrec of self => x =>
  if x === 0 then 1 
  else self(x - 1) * x
fact
//│ = fun
//│ fact = fun

