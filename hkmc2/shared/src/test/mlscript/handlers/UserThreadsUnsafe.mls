:js
:effectHandlers debug
:lift


class ThreadEffect with
  fun fork(thread: () -> ()): ()
  fun yld(): ()


fun f(h, x)() =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)
//│ FAILURE: Unexpected warning
//│ FAILURE LOCATION: applyFunDefn (CpsHandlerLowering.scala:205)
//│ ╔══[WARNING] The function term:f is not CPS-transformed because it has more than one parameter list.
//│ ║  l.11: 	fun f(h, x)() =
//│ ╙──      	    ^

fun main(h) =
  print("main start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("main end")


// task queue
let tasks = mut []
fun drain() =
  while tasks.length != 0 do
    tasks.pop()()
//│ tasks = []


// LIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.push(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  main(h)
//│ FAILURE: Unexpected warning
//│ FAILURE LOCATION: applyFunDefn (CpsHandlerLowering.scala:205)
//│ ═══[WARNING] The function term:Handler$h$fork$ is not CPS-transformed because it has more than one parameter list.
//│ ═══[RUNTIME ERROR] Error: Function 'main' expected 1 argument but got 2


// FIFO
:re
handle h = ThreadEffect with
  fun fork(thread)(k) =
    tasks.unshift(thread)
    k()
    drain()
  fun yld()(k) =
    tasks.unshift(k)
    drain()
in
  main(h)
//│ FAILURE: Unexpected warning
