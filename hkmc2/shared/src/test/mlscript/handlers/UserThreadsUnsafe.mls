fun main(h) =
  print("main start")
  h.fork(f(h, 0))
  h.fork(f(h, 1))
  h.fork(f(h, 2))
  print("main end")


// task queue
let tasks = mut []
fun drain() =
  while tasks.length != 0 do
    tasks.pop()()
