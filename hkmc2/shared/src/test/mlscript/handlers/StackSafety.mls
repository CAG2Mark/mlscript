:js
:effectHandlers
:lift
:noTailRec


// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe 6
:expect 0
:sjs
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let hi;
//│ hi = function hi(n) {
//│   let scrut, tmp;
//│   scrut = n === 0;
//│   if (scrut === true) { return 0 }
//│   tmp = n - 1;
//│   return hi(tmp);
//│ };
//│ return hi(0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:stackSafe
:expect 50005000
:sjs
fun sum(n) =
  if n === 0 then 0
  else
    n + sum(n - 1)
