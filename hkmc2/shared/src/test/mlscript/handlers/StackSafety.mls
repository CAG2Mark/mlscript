:js
:effectHandlers
:rewriteWhile
:noTailRec


// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe 6
:expect 0
:sjs
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
