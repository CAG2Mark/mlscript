:js
:effectHandlers
:lift
:noTailRec


// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe 6
:expect 0
:sjs
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let hi, hi$worker, $_effectful$_body$_;
//│ hi$worker = function hi$worker(hi$varsClass) {
//│   let scrut, tmp;
//│   runtime.checkDepth();
//│   runtime.stackDepth + 1;
//│   hi$varsClass.at(0);
//│   scrut = hi$varsClass.at(1) === 0;
//│   if (scrut === true) {
//│     runtime.popFrame("hi");
//│     return 0
//│   }
//│   {
//│     let tmp1;
//│     tmp = hi$varsClass.at(1) - 1;
//│     runtime.popFrame("hi");
//│     tmp1 = [
//│       0,
//│       tmp
//│     ];
//│     runtime.pushFrame(hi$worker, tmp1);
//│     return hi$worker(tmp1);
//│   }
//│ };
//│ runtime.resetEffects();
//│ hi = function hi(n) {
//│   let tmp;
//│   tmp = [
//│     0,
//│     n
//│   ];
//│   runtime.pushFrame(hi$worker, tmp);
//│   return hi$worker(tmp)
//│ };
//│ $_effectful$_body$_ = (undefined, function () {
//│   let tmp;
//│   tmp = [
//│     0,
//│     0
//│   ];
//│   runtime.pushFrame(hi$worker, tmp);
//│   return hi$worker(tmp)
//│ });
//│ return runtime.topLevelTrampoline(6, $_effectful$_body$_)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:stackSafe
:expect 50005000
:sjs
fun sum(n) =
  if n === 0 then 0
  else
    n + sum(n - 1)
sum(10000)
