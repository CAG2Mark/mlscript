:expect "Hello World!"
fun foo(h) =
  print("Entering foo")
  let result = h.perform("Hello")
  h.perform("?")
  print("Exiting foo")
  result
handle h = Effect with
  fun perform(arg)(k) =
    print("handler called")
    let result = k(arg)
    print("handler finished")
    result
print("mainbody start")
let result = foo(h) + " World!"
print("mainbody end")
result
