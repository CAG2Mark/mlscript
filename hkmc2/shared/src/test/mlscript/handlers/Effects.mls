:expect "54321"
:sjs
let result = ""
handle h = Effect with
  fun perform(arg)(k) =
    let v = k(arg)
    result = result + arg
    v
in
  h.perform("1")
  h.perform("2")
  h.perform("3")
  h.perform("4")
  h.perform("5")
result
