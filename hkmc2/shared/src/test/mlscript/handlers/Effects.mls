//│     let cpsCont$9$here;
//│     cpsCont$9$here = cpsCont$9$(k);
//│     return h7.perform(cpsCont$9$here, "2")
//│   }
//│ };
//│ cpsCont$0$1 = function cpsCont$0$(arg, k) {
//│   return (v) => {
//│     result = result + arg;
//│     return k(v)
//│   }
//│ };
//│ result = "";
//│ (class Handler$h$14 extends Effect1 {
//│   static {
