abstract class Cell with
  fun getVal(): Int
  fun setVal(Int): ()

let x = 0
handle h = Cell with
  fun getVal()(k) = k(x)
  fun setVal(value)(k) =
    x = value
    k(())
print(h.getVal())
h.setVal(1)
print(h.getVal())
