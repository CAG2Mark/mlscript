fun continueFromNestedLambdaWithEffects() =
  let i = 0 in do root:
    let loop = () =>
      if i >= 2 do root.break(i)
      set i += 1
      root.continue
    loop()
continueFromNestedLambdaWithEffects()
//│ = 2


fun continueFromNestedFunctionAndLambdaWithEffects() =
  let i = 0 in do root:
    fun mkContinue() =
      () =>
        if i >= 4 do root.break(i)
        set i += 1
        root.continue
    mkContinue()()
continueFromNestedFunctionAndLambdaWithEffects()
//│ = 4


