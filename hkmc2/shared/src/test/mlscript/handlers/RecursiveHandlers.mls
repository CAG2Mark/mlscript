:re
handle h = Object with
  fun write(x)(k) =
    if x < 10 do write(10)
    [x, k(())]
h.write(1)
h.write(2)
//│ ═══[RUNTIME ERROR] EffectRaised("handleEffects")

handle h = Object with
  fun write(x)(k) =
    if x < 10 do
      print(enterHandleBlock(this, () => write(10)))
    [x, k(())]
h.write(1)
h.write(2)
//│ > [10, ()]
//│ > [10, ()]
//│ = [1, [2, ()]]

handle h = Object with
  fun write(x)(k) = enterHandleBlock of this, () =>
    if x < 10 do write(10)
    [x, k(())]
h.write(1)
h.write(2)
//│ = [10, [1, [10, [2, ()]]]]

