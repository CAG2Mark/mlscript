// passing additional handlers to the handler body
let res =
  handle h = Effect with
    fun perform(arg)(k) =
      print("A " + arg)
      handle g = Effect with
        fun perform(arg1)(k1) =
          print("B " + arg + " " + arg1)
          ["‹", k1(arg), arg1, "›"]
      [k(g)]
  let g = h.perform("hi")
  g.perform("bye")
  g.perform("friend")
  set g = h.perform("hola")
  g.perform("adios")
  g.perform("amigos")
in res.toString()
