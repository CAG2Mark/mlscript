:re
handle h = Object with
  fun write(x)(k) =
    if x < 10 do write(10)
    [x, k(())]
h.write(1)
h.write(2)
//│ = [10, [1, [10, [2, ()]]]]
//│ FAILURE: Unexpected lack of runtime error

handle h = Object with
  fun write(x)(k) =
    if x < 10 do
      print(enterHandleBlock(this, () => write(10)))
    [x, k(())]
h.write(1)
h.write(2)
