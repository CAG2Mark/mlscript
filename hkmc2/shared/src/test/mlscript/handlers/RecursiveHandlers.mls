:todo
handle h2 = Effect with
  fun perform(arg)(k) =
    print("performing " + arg)
    k of if arg > 0
      then h2.perform(arg - 1) + " " + arg
      else "0"
[
  print("–––");
  h2.perform(2)
  print("–––");
  h2.perform(3)
]
//│ ╔══[COMPILATION ERROR] Name not found: h2
