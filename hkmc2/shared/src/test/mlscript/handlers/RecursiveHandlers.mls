let res =
  print("A " + "hi")
  handle g = Effect with
    fun perform(arg1)(k1) =
      print("B " + "hi" + " " + arg1)
      ["‹", k1("hi"), arg1, "›"]
  [(() =>
    g.perform("bye")
    g.perform("friend")
    print("A " + "hola")
    handle g2 = Effect with
      fun perform(arg1)(k1) =
        print("B " + "hola" + " " + arg1)
        ["‹", k1("hola"), arg1, "›"]
    [(() =>
      g2.perform("adios")
      g2.perform("amigos")
    )()]
  )()]
in res.toString()
