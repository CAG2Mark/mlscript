:js
:effectHandlers
:lift


abstract class Effect[A] with
  fun perform(arg: A): A


let
  xs = mut []
  count = 0
fun main() =
  handle g = Effect with
    fun perform(arg1)(k1) =
      print("B " + arg1)
      xs.push(k1)
  print(g.perform("a"))
  print("—")
  print(g.perform("b"))
  print("—")
  print(g.perform("c"))
main()
while
  do print(xs)
  let f = xs.pop()
  f !== () then
    set count += 1
    f(count)
    print("?")
