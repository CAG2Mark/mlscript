// g is non-resumptive, which means g.perform("a") does not resume
// hence it should exit the entire handle block with the return value of xs.push(k1)
:expect 1
handle h = Effect with
  fun perform(arg)(k) =
    print("A " + arg)
    let
      xs = mut []
      count = 0
    handle g = Effect with
      fun perform(arg1)(k1) =
        print("B " + arg + " " + arg1)
        xs.push(k1)
    k(g)
    while xs.pop() is
      null then print("Done.")
      f then
        set count += 1
        f(count)
let g = h.perform("hi")
print(g.perform("a"))
print("—")
print(g.perform("b"))
print("—")
print(g.perform("c"))
