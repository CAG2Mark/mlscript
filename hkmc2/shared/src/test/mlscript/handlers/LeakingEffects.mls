:js
:effectHandlers
:rewriteWhile

open annotations


abstract class Effect[A] with
  fun perform(arg: A): A


let
  xs = mut []
  count = 0
fun main() =
  handle g = Effect with
    fun perform(arg1)(k1) =
      print("B " + arg1)
      @native xs.push(k1)
  print(g.perform("a"))
  print("—")
  print(g.perform("b"))
  print("—")
  print(g.perform("c"))
main()
while
  do print(xs)
  let f = xs.pop()
  f !== () then
    set count += 1
    f(count)
    print("?")
//│ > B a
//│ = 1
//│ count = 0
//│ xs = [fun]

// * Notes:
:sjs
(@native (mut []).pop()) === undefined
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2;
//│ tmp = [];
//│ tmp1 = runtime.safeCall(tmp.pop());
//│ tmp2 = tmp1 === undefined;
//│ return runtime.cpsId(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = false
(@native (mut []).pop()) === null
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp3, tmp4, tmp5;
//│ tmp3 = [];
//│ tmp4 = runtime.safeCall(tmp3.pop());
//│ tmp5 = tmp4 === null;
//│ return runtime.cpsId(tmp5)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = false
(@native (mut []).pop()) === ()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp6, tmp7, tmp8;
//│ tmp6 = [];
//│ tmp7 = runtime.safeCall(tmp6.pop());
//│ tmp8 = tmp7 === runtime.Unit;
//│ return runtime.cpsId(tmp8)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


// g is non-resumptive, which means g.perform("a") does not resume
// hence it should exit the entire handle block with the return value of xs.push(k1)
:expect 1
handle h = Effect with
  fun perform(arg)(k) =
    print("A " + arg)
    let
      xs = mut []
      count = 0
    handle g = Effect with
      fun perform(arg1)(k1) =
        print("B " + arg + " " + arg1)
        @native xs.push(k1)
    k(g)
    while xs.pop() is
      null then print("Done.")
      f then
        set count += 1
        f(count)
let g = h.perform("hi")
print(g.perform("a"))
print("—")
print(g.perform("b"))
print("—")
print(g.perform("c"))
// set g = h.perform("hola")
// g.perform("adios")
//│ > A hi
//│ > B hi a
//│ = 1


