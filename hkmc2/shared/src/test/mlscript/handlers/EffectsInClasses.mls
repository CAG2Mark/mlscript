:fixme
oops.h
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'h')

let obj = mut {s: undefined}
//│ obj = {s: undefined}

handle h = Effect with
  fun perform(arg)(k) =
    k()
    print(arg)
set obj.s = h.perform("k")
//│ > k

fun f() = ()

module A with
  f()
  () // defeats tail call optimization
//│ > let A1;try { globalThis.Object.freeze(class A {   static {     A1 = this   }   static {     return;   }   toString() { return runtime.render(this); }   static [definitionMetadata] = ["class", "A"]; });; undefined } catch (e) { console.log('\u200B' + (e.stack ?? e) + '\u200B'); }
