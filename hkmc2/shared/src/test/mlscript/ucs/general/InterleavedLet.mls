abstract class List[out T]
data class Cons[out T](head: T, tail: List[T]) extends List[T]
object Nil extends List[Nothing]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:List⁰
//│   sym = member:List¹
//│   k = Cls


fun map(f, xs) = if xs is
  Nil then Nil
  let xs' = map(f, xs)
  Cons(x, xs) then Cons(f(x), xs')


object Bot
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Bot⁰
//│   sym = member:Bot¹
