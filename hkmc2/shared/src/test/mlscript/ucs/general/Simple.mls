// Simple.mls
// ==========
// Simple and single-line UCS expressions.


data class Box[T](value: T)
data class Bottle[T](value: T)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         sign = S of Ref{sym=T⁰} of T⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Box⁰/value²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Box⁰/value²
//│       sym = member:value¹
//│       rhs = SimpleRef of value⁰


fun foo(x) = if x is Box(y) then y


fun foo(x) = if x is
  Box(y) then y
  Bottle(y) then y


fun foo(x, y) = if x is Box(xv) and y is Bottle(yv) then xv + yv


fun foo(x, y, z) = if x is Box(xv) and y is Box(yv) and z is Box(zv) then xv + yv + zv


