class Suit
object Heart extends Suit
object Diamond extends Suit
object Spade extends Suit
object Club extends Suit
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Suit⁰
//│   sym = member:Suit¹
//│   k = Cls

fun suit(x) = if x is Card(a) then a

let card = Card(Heart)
//│ card = Card(Heart)

suit of card
//│ = Heart

// :ucs desugared normalized
fun foo(x) = if x is
  Card(Heart) then 0
  Card(Diamond) then 1
  Card(Spade) then 2
  Card(Club) then 3
  else 4


