import "../../../mlscript-compile/Stack.mls"
import "../../../mlscript-compile/Option.mls"

open Stack
open Option

data class Pair[A, B](x: A, y: B)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Pair⁰
//│   sym = member:Pair¹
//│   ctorSym = S of term:Pair²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x⁰
//│         sign = S of Ref{sym=A⁰} of A⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = y⁰
//│         sign = S of Ref{sym=B⁰} of B⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:Pair⁰/x²
//│     Tuple2:
//│       _1 = member:y¹
//│       _2 = term:Pair⁰/y²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Pair⁰/x²
//│       sym = member:x¹
//│       rhs = SimpleRef of x⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Pair⁰/y²
//│       sym = member:y¹
//│       rhs = SimpleRef of y⁰

fun foo(xs) =
  if xs is
    "abc" :: "xyz" :: xs then 0
    "abc" :: "uvw" :: xs then 1
    Nil then 3

fun sum(acc, xs) = 
  if xs is
    x :: xs then sum(acc + x, xs)
    Nil     then acc

// :ucs normalized
fun test(xs) =
  if xs is
    Some(Cons("add", Cons(x, Cons(y, Nil)))) then x + y
    Some(Cons("mul", Cons(x, Cons(y, Nil)))) then x * y
    Some(Cons("sum", xs)) then sum(0, xs)
    Some(Nil) then "nothing"
    None then "nothing"
