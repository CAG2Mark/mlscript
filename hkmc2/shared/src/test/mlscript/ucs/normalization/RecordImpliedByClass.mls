:js


class Foo(a, b)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   ctorSym = S of term:Foo²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         sym = a⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         sym = b⁰
//│         modulefulness = Modulefulness of N
//│   privateFields = Ls of
//│     term:Foo⁰/a¹
//│     term:Foo⁰/b¹
//│   ctor = AssignField:
//│     lhs = This of class:Foo⁰
//│     nme = Ident of "a"
//│     rhs = SimpleRef of a⁰
//│     rest = AssignField: \
//│     lhs = This of class:Foo⁰
//│     nme = Ident of "b"
//│     rhs = SimpleRef of b⁰

:ucs normalized
fun f(x) =
  if x is Foo and x is { a: av, b: bv } then av + bv
  else 0
//│ Normalized:
//│ >  ‹if|while›
//│ >    x is Foo and
//│ >      x is { a: tmp:field_a$, b: tmp:field_b$ } and
//│ >        let bv = tmp:field_b$⁰
//│ >        let av = tmp:field_a$⁰
//│ >        else builtin:+⁰(av⁰, bv⁰)
//│ >      else 0
//│ >    else 0

f(Foo(0, 1))
//│ = 0
