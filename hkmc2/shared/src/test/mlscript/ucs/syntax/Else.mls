data class Box[A](value: A)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         sign = S of Ref{sym=A⁰} of A⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Box⁰/value²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Box⁰/value²
//│       sym = member:value¹
//│       rhs = SimpleRef of value⁰

:w
fun foo(x) = if x is
  Box(0) then "The box contains zero."
  Box(1) then "The box contains one."
  else "I can't tell you what's inside the box."
  else "I don't want to tell you what's inside the box."
  else "I shouldn't tell you what's inside the box."
//│ ╔══[WARNING] This catch-all clause makes the following branches unreachable.
//│ ║  l.153: 	  else "I can't tell you what's inside the box."
//│ ║         	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This branch is unreachable.
//│ ║  l.154: 	  else "I don't want to tell you what's inside the box."
//│ ║         	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This branch is unreachable.
//│ ║  l.155: 	  else "I shouldn't tell you what's inside the box."
//│ ╙──       	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
