:js

fun f(x) = x
fun g(x) = x
fun h(x) = x

data class Pair[A, B](fst: A, snd: B)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Pair⁰
//│   sym = member:Pair¹
//│   ctorSym = S of term:Pair²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = fst⁰
//│         sign = S of Ref{sym=A⁰} of A⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = snd⁰
//│         sign = S of Ref{sym=B⁰} of B⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:fst¹
//│       _2 = term:Pair⁰/fst²
//│     Tuple2:
//│       _1 = member:snd¹
//│       _2 = term:Pair⁰/snd²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Pair⁰/fst²
//│       sym = member:fst¹
//│       rhs = SimpleRef of fst⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Pair⁰/snd²
//│       sym = member:snd¹
//│       rhs = SimpleRef of snd⁰

// Simple conditionals in the form of `x is P`.
// ============================================

:expect true
Pair(0, 1) is Pair
//│ = true

:expect true
Pair(0, 1) is Pair(a, b)
//│ = true

:expect true
Pair(0, 1) is Pair(0, _)
//│ = true

:expect true
if Pair(0, 1) is Pair(a, b) then true else false
//│ = true

// Based on the above, add an `and` at the end, in the form of `x is P and t`.
// ===========================================================================

:expect false
Pair(0, 1) is Pair(a, b) and a > b
//│ = false

:expect true
Pair(1, 0) is Pair(a, b) and a > b
//│ = true

fun foo(x) = f(x) and g(x) and h(x)

:expect [true, false]
[foo(true), foo(false)]
//│ = [true, false]

// Test matching multiple patterns at once.
// ========================================

fun foo(x) = x is
  Pair
  Int

:expect [true, false, true]
[foo(2), foo(3.14159), foo(Pair(0, 1))]
//│ = [true, false, true]

fun foo(x) = x is (Pair | Int)

:expect [true, false, true]
[foo(2), foo(3.14159), foo(Pair(0, 1))]
//│ = [true, false, true]

fun foo(x) = x is
  Pair | Int

:expect [true, false, true]
[foo(2), foo(3.14159), foo(Pair(0, 1))]
//│ = [true, false, true]

fun foo(x) = x is { Pair, Int }

:expect [true, false, true]
[foo(2), foo(3.14159), foo(Pair(0, 1))]
//│ = [true, false, true]

:e
fun foo(x) = x is
  Pair(a, b) and a > b
  Int
//│ ╔══[COMPILATION ERROR] Unrecognized pattern (infix operator 'and').
//│ ║  l.112: 	  Pair(a, b) and a > b
//│ ╙──       	  ^^^^^^^^^^^^^^^^^^^^


:e
fun foo(x) = x is Pair(a, b) | Int
//│ ╔══[COMPILATION ERROR] Unexpected term form in expression position (alternation)
//│ ║  l.120: 	fun foo(x) = x is Pair(a, b) | Int
//│ ╙──       	             ^^^^^^^^^^^^^^^^^^^^^

// Test how shorthand conditionals work together with lambda functions.
// ====================================================================

data class A[T](arg: T)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:A¹
//│   sym = member:A²
//│   ctorSym = S of term:A³
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = arg⁰
//│         sign = S of Ref{sym=T⁰} of T⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:arg¹
//│       _2 = term:A¹/arg²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:A¹/arg²
//│       sym = member:arg¹
//│       rhs = SimpleRef of arg⁰

let foo = x => x is A(_)
//│ foo = fun foo

:expect [false, true]
[foo(0), foo(A(0))]
//│ = [false, true]

let foo = _ is A
//│ foo = fun foo

:expect [false, true]
[foo(0), foo(A(0))]
//│ = [false, true]

let foo = _ is A(_)
//│ foo = fun foo

:expect [false, true]
[foo(0), foo(A(0))]
//│ = [false, true]

let foo = _ is A(x) and x > 0
//│ foo = fun

:expect [false, false, true]
[foo(0), foo(A(0)), foo(A(1))]
//│ = [false, false, true]

