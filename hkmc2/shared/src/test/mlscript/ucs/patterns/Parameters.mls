// Binding the overall constructor output with `as result` should still be allowed
// when all constructor arguments preserve their scrutinees, even if some
// private fields are matched with `_`.
fun keepSecret(x) = if x is (SecretPair(_, q)) as result then q

keepSecret(SecretPair(2, 3))
//│ = 3

