:js
:deforest


data class A(x)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:A⁰
//│   sym = member:A¹
//│   ctorSym = S of term:A²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:A⁰/x²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:A⁰/x²
//│       sym = member:x¹
//│       rhs = SimpleRef of x⁰

data class (::) Cons(h, t)
object Nil
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Cons⁰
//│   sym = member:Cons¹
//│   ctorSym = S of term:Cons²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = h⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = t⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:h¹
//│       _2 = term:Cons⁰/h²
//│     Tuple2:
//│       _1 = member:t¹
//│       _2 = term:Cons⁰/t²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Cons⁰/h²
//│       sym = member:h¹
//│       rhs = SimpleRef of h⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Cons⁰/t²
//│       sym = member:t¹
//│       rhs = SimpleRef of t⁰



:expect 10
fun to(n) = if n > 0 then n :: to(n - 1) else Nil
fun f1(ls) = if ls is
  h :: t then h
  Nil then 2
fun f2(ls) = if ls is
  h :: t then h + 1
  Nil then 3
fun badWrap(n) =
  let x = to(n)
  f1(x) + f2(x)
  x
f1(badWrap(4)) + f2(badWrap(5))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 10




:expect 9
fun p(x) = A(x)
let one = p(1) in...
let two = p(2)
fun f1(p) = if p is A(a) then a + 1
fun f2(p) = if p is A(b) then b + 2
f1(one) + f2(one) + f2(two)
//│ deforest > >>> fusing >>>
//│ deforest > A²(x³) ->
//│ deforest > 	match: p⁰
//│ deforest > 	fields: p⁰.x²
//│ deforest > <<< fusing <<<
//│ = 9



:expect 5
fun p(a) = a
fun f1(a1) = if a1 is A(x1) then x1
fun f2(a2) = if a2 is A(x2) then x2 + 1
let x = A(1)
let y = A(2)
let res1 = p(if true then x else y) // both x and y flow into this call-site result
let res2 = p(x) // x flows into this call-site result
let res3 = p(y) // y flows into this call-site result
// f1(res1) + f2(res1) + f1(res2) + f2(res3)
f1(res1) + f1(res2) + f2(res3)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 5
//│ res1 = A(1)
//│ res2 = A(1)
//│ res3 = A(2)
//│ x = A(1)
//│ y = A(2)



:expect 4
fun f1(a1) = if a1 is A(x1) then x1
fun f2(a2) = if a2 is A(x2) then x2 + 1
fun p(x, clashedCtor) =
  if true then A(x)
  else clashedCtor
let clashed = A(3)
f1(p(1, clashed)) + f2(p(2, clashed))
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ = 4
//│ clashed = A(3)



