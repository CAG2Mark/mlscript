:lift
:deforest
fun h() =
  fun lscomp1(ls) = if ls is
    Nil then Nil
    x :: xs then
      fun lscomp2(ls) = if ls is
        Nil then lscomp1(xs)
        y :: ys then [x, y] :: lscomp2(ys)
      lscomp2(1 :: 2 :: 3 :: Nil)
  lscomp1(1 :: 2 :: 3 :: Nil)
h()
