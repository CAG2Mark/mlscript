:js
:deforest

// Test: Deforestation with function of multiple parameter lists
object A
data class Pair(x, y)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:A⁰
//│   sym = member:A¹
//│   k = Obj

fun test(a)(b) =
  if a is Pair(x, y) then x + y + b
test(Pair(1, 2))(3)
//│ deforest > >>> fusing >>>
//│ deforest > Pair⁰(1, 2) ->
//│ deforest > 	match: a⁰
//│ deforest > 	fields: a⁰.x⁰
//│ deforest > 	fields: a⁰.y⁰
//│ deforest > <<< fusing <<<
//│ = 6

// Test: Deforestation with nested constructor calls and multiple param lists
data class Box(v)
//│ deforest > >>> fusing >>>
//│ deforest > <<< fusing <<<
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = v⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:v¹
//│       _2 = term:Box⁰/v²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Box⁰/v²
//│       sym = member:v¹
//│       rhs = SimpleRef of v⁰

fun unbox(b)(offset) =
  if b is Box(v) then v + offset
unbox(Box(10))(5)
//│ deforest > >>> fusing >>>
//│ deforest > Box²(10) ->
//│ deforest > 	match: b⁰
//│ deforest > 	fields: b⁰.v²
//│ deforest > <<< fusing <<<
//│ = 15

