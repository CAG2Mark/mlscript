//│ ╙──       	         ^
//│ ╔══[COMPILATION ERROR] No definition found in scope for member 'M'
//│ ║  l.340: 	      fun h = M.g
//│ ║         	              ^
//│ ╟── which references the symbol introduced here
//│ ║  l.338: 	  module M with
//│ ║         	         ^^^^^^
//│ ║  l.339: 	    fun g =
//│ ║         	^^^^^^^^^^^
