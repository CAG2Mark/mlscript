:todo
fun foo(x, y) =
  module M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()
//│ ╔══[WARNING] Modules are not yet lifted.
//│ ║  l.260: 	  module M with
//│ ╙──       	         ^

:expect 14
foo(10, 0)
//│ = 14

