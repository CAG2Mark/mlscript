// Instruction for agent: for each test case you solve, move it to its own test file outside of the `backlog` folder


// ——— ——— ———

:fixme // `in` is taken as part of the `set`, as in `set..in`, instead of the `let`
:expect 42
let emptyItemCount = 0
let c() = set emptyItemCount += 1
in 42
//│ ═══[RUNTIME ERROR] Expected: '42', got: 'undefined'
//│ c = fun
//│ emptyItemCount = 0

// ——— ——— ———

// Works
let x = 1
in x
//│ = 1

// Doesn't work
:fixme
let
  x = 1
in x
//│ ╔══[COMPILATION ERROR] Illegal position for 'in' modifier.
//│ ║  l.28: 	in x
//│ ╙──      	^^
//│ = 1
//│ x = 1

// ——— ——— ———

// FIXME: op-split has no split point!
// Parses as a prefix `do` in a split instead of an infix `do` that's part of the `if` expression!
:fixme
:pt
if maybe
  do 1
  else ???
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ IfLike:
//│   kw = Keywrd of keyword 'if'
//│   split = OpSplit:
//│     lhs = Ident of "maybe"
//│     ops_rhss = Ls of
//│       PrefixApp:
//│         kw = Keywrd of keyword 'do'
//│         rhs = IntLit of 1
//│       PrefixApp:
//│         kw = Keywrd of keyword 'else'
//│         rhs = Ident of "???"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] Error: Not implemented

// * NOTE: works!! (special-cased?)
:pt
if maybe
  then 1
  else ???
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ IfLike:
//│   kw = Keywrd of keyword 'if'
//│   split = Block of Ls of
//│     InfixApp:
//│       lhs = Ident of "maybe"
//│       kw = Keywrd of keyword 'then'
//│       rhs = IntLit of 1
//│     PrefixApp:
//│       kw = Keywrd of keyword 'else'
//│       rhs = Ident of "???"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * NOTE: works
:pt
if 2
  > 1 do print("hi")
  else ???
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ IfLike:
//│   kw = Keywrd of keyword 'if'
//│   split = OpSplit:
//│     lhs = IntLit of 2
//│     ops_rhss = Ls of
//│       InfixApp:
//│         lhs = OpApp:
//│           lhs = SplitPoint
//│           op = Ident of ">"
//│           rhss = Ls of
//│             IntLit of 1
//│         kw = Keywrd of keyword 'do'
//│         rhs = App:
//│           lhs = Ident of "print"
//│           rhs = Tup of Ls of
//│             StrLit of "hi"
//│       PrefixApp:
//│         kw = Keywrd of keyword 'else'
//│         rhs = Ident of "???"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi

