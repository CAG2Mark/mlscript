// * Objects should not be allowed to have parameters...
// * Or these parameters should have default values.

:ssjs
object Cls(val x) with
  fun huh = x
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Cls⁰
//│   sym = member:Cls¹
//│   k = Obj
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x⁰
//│         modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of object:Cls⁰
//│       sym = member:huh⁰
//│       dSym = term:Cls⁰/huh¹
//│       body = Return of Select{sym=term:Cls⁰/x¹}:
//│         qual = This of object:Cls⁰
//│         name = Ident of "x"
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x²
//│       _2 = term:Cls⁰/x¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Cls⁰/x¹
//│       sym = member:x²
//│       rhs = SimpleRef of x⁰
//│ ╔══[INTERNAL ERROR] Compiler reached an unsupported state: Some(ParamList(‹›,List(Param(‹val›,x,None,Modulefulness(None))),None)).isDefined =/= false
//│ ╟── The compilation result may be incorrect.
//│ ╙── This is a known compiler limitation; if it is a blocker for you, please report it to the maintainers.
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let Cls1;
//│ globalThis.Object.freeze(class Cls {
//│   static {
//│     new this
//│   }
//│   constructor(x1) {
//│     Cls1 = this;
//│     this.x = x1;
//│     Object.defineProperty(this, "class", {
//│       value: Cls
//│     });
//│     globalThis.Object.freeze(this);
//│   }
//│   get huh() {
//│     return this.x;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "Cls"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:e
Cls.x
//│ ╔══[COMPILATION ERROR] Object 'Cls' does not contain member 'x'
//│ ║  l.151: 	Cls.x
//│ ╙──       	   ^^
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

// * Note: the access is not checked because the selection is resolved
// * (to an MLscript definition, which is not supposed to return `undefined`).
print(Cls.huh)
//│ > undefined

let c = new Cls(123)
//│ ╔══[COMPILATION ERROR] Expected a statically known class; found reference of type Cls.
//│ ║  l.162: 	let c = new Cls(123)
//│ ║         	            ^^^
//│ ╙── The 'new' keyword requires a statically known class; use the 'new!' operator for dynamic instantiation.
//│ ═══[RUNTIME ERROR] TypeError: Cls1 is not a constructor
//│ c = undefined

c.x
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'x')

