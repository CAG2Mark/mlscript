module Foo with
  class
    Bar
    Baz
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   owner = S of module:Foo⁰
//│   isym = class:Bar⁰
//│   sym = member:Bar¹
//│   k = Cls

fun foo(x) = if x is Foo.
  Bar then "Bar"
  Foo then "Foo"
