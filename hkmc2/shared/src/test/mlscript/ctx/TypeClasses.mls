:expect 9
using Monoid[Int] = IntAddMonoid
M.foldInt(2, 3, 4)
//│ = 9

:expect 24
using Monoid[Int] = IntMulMonoid
M.foldInt(2, 3, 4)
//│ = 24

:expect 6
using Monoid[Int] = IntAddMonoid
M.fold(1, 2, 3)
//│ = 6


// Generalized Module Methods

using Int = 42

:expect 42
fun foo()(using i: Int) = i
foo()
//│ = 42

:expect 42
fun main() =
  fun foo()(using i: Int) = i
  foo()
main()
//│ = 42
