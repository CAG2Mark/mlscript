// Writing record patterns in this way is strange. In the previous `Desugarer`,
// the logic from two methods happened to work together and supported this
// syntax. In the new `Desugarer`, we chose not to support this syntax.
fun f(x) = if x is {( Int then 1, Bool then 2 )}
