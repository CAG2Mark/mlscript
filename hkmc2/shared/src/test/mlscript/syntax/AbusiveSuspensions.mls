//│       rhs = SimpleRef of value⁰


fun foo[A, B](expr1, expr2, expr3): Result[A, B] =
  if expr1 is...
  Error(b) then b
  Ok(a) then...
  if expr2 is...
  Error(d) then d
  Ok(c) then...
  expr3

foo(Ok(1), Ok(2), 3)
//│ = 3

foo(Ok(1), Error(2), 3)
//│ = 2


