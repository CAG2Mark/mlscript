:js


let xs = mut [1, 2, 3]
//│ xs = [1, 2, 3]

:sjs
xs.(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return xs[0]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sjs
set xs.(0) = 4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ xs[0] = 4; return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

xs.(0)
//│ = 4

set xs.[0] += 1

set xs.[0] = xs.[0] + 1

xs.[0]
//│ = 6

set xs.("lol") = "wat"

xs
//│ = [6, 2, 3]


