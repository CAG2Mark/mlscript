// class Foo(using z: Int)
// * is to be understood as
class Foo0
fun Foo(using z: Int) = new mut Foo0 !> res =>
  set res.z = z
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo0⁰
//│   sym = member:Foo0¹
//│   k = Cls

using Int = 123

Foo
//│ = Foo0 { z: 123 }

// class Foo(x, y)(using z)
// * is to be understood as
class Foo0
fun Foo(x, y)(using z: Int) = new mut Foo0 !> res =>
  set
    res.x = x
    res.y = y
    res.z = z
