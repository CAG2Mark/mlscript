object Example with
// whoops
  val a = this
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Example⁰
//│   sym = member:Example¹
//│   k = Obj
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a⁰
//│       _2 = term:Example⁰/a¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Example⁰/a¹
//│       sym = member:a⁰
//│       rhs = This of object:Example⁰

assert Example.a is Example


