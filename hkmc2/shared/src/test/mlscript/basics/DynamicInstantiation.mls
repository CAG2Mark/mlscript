:re
f(1, 2)
//│ ═══[RUNTIME ERROR] TypeError: f3 is not a function


new! C.class(1, 2)
//│ = C(1, 2)


let f = x => new! (id(C))(x, x)
//│ f = fun f

f(1)
//│ = C(1, 1)

new! C(1, 2)
//│ = C(1, 2)


let o = new! mut Object
//│ o = {}

set o.x = 1

o.x
//│ = 1

set o.x += 1 in o.x
//│ = 2

o
//│ = {x: 1}

o.x
//│ = 1


