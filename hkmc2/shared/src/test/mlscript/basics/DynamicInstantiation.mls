//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = y⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:C²/x²
//│     Tuple2:
//│       _1 = member:y¹
//│       _2 = term:C²/y²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:C²/x²
//│       sym = member:x¹
//│       rhs = SimpleRef of x⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:C²/y²
//│       sym = member:y¹
//│       rhs = SimpleRef of y⁰


