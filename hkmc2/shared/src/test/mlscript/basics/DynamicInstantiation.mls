// * on the constructor function, not on the class!
:sjs
let f = new! C
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f3; f3 = globalThis.Object.freeze(new C3());
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
