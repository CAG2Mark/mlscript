//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a¹
//│       _2 = term:Foo²/a²
//│     Tuple2:
//│       _1 = member:b¹
//│       _2 = term:Foo²/b²
//│     Tuple2:
//│       _1 = member:c¹
//│       _2 = term:Foo²/c²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo²/a²
//│       sym = member:a¹
//│       rhs = SimpleRef of a⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Foo²/b²
//│       sym = member:b¹
//│       rhs = SimpleRef of b⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Foo²/c²
//│       sym = member:c¹
//│       rhs = SimpleRef of c⁰

new Foo(...xs)
//│ = Foo(1, 2, 3)

new Foo(...[1, 2])
//│ = Foo(1, 2, undefined)

new Foo(...[1, 2, 3, 4])
//│ = Foo(1, 2, 3)


