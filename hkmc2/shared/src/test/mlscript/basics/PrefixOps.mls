import "../../mlscript-compile/Stack.mls"
open Stack


0 *
  + 1
  + 2
//│ = 0

x =>
  + 1
  + 2
//│ = fun


| 1
//│ = 1

& 1
//│ = 1

let res =
  | 1
//│ res = 1

| 2 + 2
*
| 3 + 3
//│ = 24

2 + 2
*
3 + 3
//│ = 24

2 + 2
  *
3 + 3
//│ = 11

| 2 + 2
  *
| 3 + 3
//│ = 14

2 + 2 * | 3 + 3
//│ = 14

