:js


module M with
  data class Foo(x) with
    fun m() = this.x + 1
    fun n(y) = this.x + y
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   owner = S of module:M⁰
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   ctorSym = S of term:M⁰/Foo²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x⁰
//│         modulefulness = Modulefulness of N
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Foo⁰
//│       sym = member:m⁰
//│       dSym = term:Foo⁰/m¹
//│       params = Ls of
//│         ParamList: ‹empty›
//│       body = Return of Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Foo⁰/x¹}:
//│                 qual = This of class:Foo⁰
//│                 name = Ident of "x"
//│             Arg:
//│               value = Lit of IntLit of 1
//│     FunDefn:
//│       owner = S of class:Foo⁰
//│       sym = member:n⁰
//│       dSym = term:Foo⁰/n¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = y⁰
//│               modulefulness = Modulefulness of N
//│       body = Return of Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Foo⁰/x¹}:
//│                 qual = This of class:Foo⁰
//│                 name = Ident of "x"
//│             Arg:
//│               value = SimpleRef of y⁰
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x²
//│       _2 = term:Foo⁰/x¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁰/x¹
//│       sym = member:x²
//│       rhs = SimpleRef of x⁰


let foo = M.Foo(123)
//│ foo = Foo(123)


foo.m()
//│ = 124

foo.n(1)
//│ = 124


foo M.Foo::m()
//│ = 124

foo M.Foo::n(2)
//│ = 125

M.Foo::n(foo, 2)
//│ = 125

M.Foo ::n(foo, 2)
//│ = 125

M.Foo ::n (foo, 2)
//│ = 125

