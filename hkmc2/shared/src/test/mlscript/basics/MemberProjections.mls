:sjs
let m = M.Foo::m
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let m, m1; m1 = function m(self5, ...args5) { return self5.m(...args5) }; m = m1;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ m = fun m

m(foo)
//│ = 124

foo m()
//│ = 124


M.{foo Foo::m()}
//│ = 124

M.{foo.Foo#m()}
//│ = 124

do
  open M
  print of foo M.Foo::m()
//│ > 124

do
  open M
  print of foo.Foo#m()
//│ > 124

