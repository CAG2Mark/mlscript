// :ssjs
:sir
:lift
// TODO: remove this flag when the lifter problem is resolved (see: the end of ClassInFun.mls)
:deadParamElim off
fun foo(x, y) =
  class A(val u) with { val v = y }
  let a = new A(x)
  [a, a.A#u, a.A#v]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending is part of: Scoped:
//│   syms = Set(member:A)
//│   body = Define:
//│     defn = ClsLikeDefn:
//│       isym = class:A⁶
//│       sym = member:A⁷
//│       ctorSym = S of term:A⁸
//│       k = Cls
//│       paramsOpt = S of ParamList:
//│         params = Ls of
//│           Param:
//│             flags = (val)
//│             sym = u⁰
//│             modulefulness = Modulefulness of N
//│       auxParams = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = y⁰
//│               modulefulness = Modulefulness of N
//│       privateFields = Ls of
//│         term:A⁶/y¹
//│       publicFields = Ls of
//│         Tuple2:
//│           _1 = member:u¹
//│           _2 = term:A⁶/u²
//│         Tuple2:
//│           _1 = member:v⁰
//│           _2 = term:A⁶/v¹
//│       ctor = AssignField:
//│         lhs = This of class:A⁶
//│         nme = Ident of "y"
//│         rhs = SimpleRef of y⁰
//│         rest = Define: \
//│         defn = ValDefn:
//│           tsym = term:A⁶/u²
//│           sym = member:u¹
//│           rhs = SimpleRef of u⁰
//│         rest = Define: \
//│         defn = ValDefn:
//│           tsym = term:A⁶/v¹
//│           sym = member:v⁰
//│           rhs = Select{sym=term:A⁶/y¹}:
//│             qual = This of class:A⁶
//│             name = Ident of "y"
//│     rest = Define: \
//│     defn = FunDefn:
//│       sym = member:foo⁰
//│       dSym = term:foo¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = x⁶
//│               modulefulness = Modulefulness of N
//│             Param:
//│               sym = y²
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {a²}):
//│         body = Assign:
//│           lhs = a²
//│           rhs = Instantiate:
//│             mut = false
//│             cls = MemberRef{disamb=class:A⁶}:
//│               bms = member:A⁷
//│               disamb = class:A⁶
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of x⁶
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of y²
//│           rest = Return of Tuple:
//│             mut = false
//│             elems = Ls of
//│               Arg:
//│                 value = SimpleRef of a²
//│               Arg:
//│                 value = Select{sym=term:A⁶/u²}:
//│                   qual = SimpleRef of a²
//│                   name = Ident of "u"
//│               Arg:
//│                 value = Select{sym=term:A⁶/v¹}:
//│                   qual = SimpleRef of a²
//│                   name = Ident of "v"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let A;
//│ define A as class A⁶ {
//│   private val y¹;
//│   val u¹;
//│   val v⁰;
//│   constructor A⁸(u, y) {
//│     set A⁶.this.y¹ = y;
//│     define u¹ as val u² = u;
//│     define v⁰ as val v¹ = A⁶.this.y¹;
//│     end
//│   }
//│ };
//│ define foo⁰ as fun foo¹(x, y) { let a; set a = new A⁶(x, y); return [a, a.u², a.v¹] };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [A(1), 1, 2]
foo(1, 2)
//│ = [A(1), 1, 2]


