:js
:noSanityCheck



:sir
class A(val x)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:A⁰
//│   sym = member:A¹
//│   ctorSym = S of term:A²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:A⁰/x²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:A⁰/x²
//│       sym = member:x¹
//│       rhs = SimpleRef of x⁰
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define A¹ as class A⁰ { val x¹; constructor A²(x) { define x¹ as val x² = x; end } }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let a = A(1)
//│ a = A(1)

// * Currently, we don't get a symbol here, yet
:sir
a.x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return a⁰.x﹖
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * Check that the symbol here is the one we expect: `x¹`, from `define x⁰ as val x¹` above
:sir
a.A#x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ return a⁰.x²
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

// * Idem
:sir
A::x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ @private
//│ define lambda as fun lambda⁰(self, ...args) { return self.x²(...args) };
//│ return lambda⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun

// * Idem
:sir
case A(x) then x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ @private
//│ define lambda as fun lambda¹(caseScrut) {
//│   let x, arg$A$0$;
//│   match caseScrut
//│     A⁰ =>
//│       set arg$A$0$ = caseScrut.x²;
//│       set x = arg$A$0$;
//│       return x
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ return lambda¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


