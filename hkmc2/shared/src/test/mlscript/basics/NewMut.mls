:js


class Foo with
  val x = 0
  fun change =
    set x += 1
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   k = Cls
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Foo⁰
//│       sym = member:change⁰
//│       dSym = term:Foo⁰/change¹
//│       body = Scoped(syms = {tmp:tmp⁰}):
//│         body = Assign:
//│           lhs = tmp:tmp⁰
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Select{sym=term:Foo⁰/x⁰}:
//│                     qual = This of class:Foo⁰
//│                     name = Ident of "x"
//│                 Arg:
//│                   value = Lit of IntLit of 1
//│           rest = AssignField: \
//│           lhs = This of class:Foo⁰
//│           nme = Ident of "x"
//│           rhs = SimpleRef of tmp:tmp⁰
//│           rest = Return of Select{sym=object:Unit⁰}:
//│             qual = SimpleRef of tmp:runtime⁰
//│             name = Ident of "Unit"
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x¹
//│       _2 = term:Foo⁰/x⁰
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁰/x⁰
//│       sym = member:x¹
//│       rhs = Lit of IntLit of 0


:sjs
let f = new Foo
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = globalThis.Object.freeze(new Foo1());
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = Foo { x: 0 }

set
  f.x = 1
  f.y = 1

:expect 0
f.x
//│ = 0

:re
f.change
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'x' of object '[object Object]'

:expect 0
f.x
//│ = 0

:re
f.y
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'


:sjs
// :elt
let f = new mut Foo
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f1; f1 = new Foo1();
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = Foo { x: 0 }

set
  f.x = 1
  f.y = 1

f.change

:expect 2
f.x
//│ = 2

:expect 1
f.y
//│ = 1


:e
let f = mut new Foo
//│ ╔══[COMPILATION ERROR] Illegal position for 'mut' modifier.
//│ ║  l.101: 	let f = mut new Foo
//│ ╙──       	        ^^^
//│ f = Foo { x: 0 }

:e
:re
new mut Foo.x
//│ ╔══[COMPILATION ERROR] Expected a statically known class; found selection.
//│ ║  l.109: 	new mut Foo.x
//│ ║         	        ^^^^^
//│ ╙── The 'new' keyword requires a statically known class; use the 'new!' operator for dynamic instantiation.
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'


let f = new mut Foo()
//│ f = Foo { x: 0 }

set
  f.x = 1
  f.y = 1

f.change

:expect 2
f.x
//│ = 2

:expect 1
f.y
//│ = 1


new mut Foo().x
//│ = 0

new Foo().x
//│ = 0



class Foo(val x)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo²
//│   sym = member:Foo³
//│   ctorSym = S of term:Foo⁴
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = x²
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x³
//│       _2 = term:Foo²/x⁴
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo²/x⁴
//│       sym = member:x³
//│       rhs = SimpleRef of x²


let f = new Foo(0)
//│ f = Foo(0)

set f.x = 1

:expect 0
f.x
//│ = 0


let f = new mut Foo(0)
//│ f = Foo(0)

set f.x = 1

:expect 1
f.x
//│ = 1


let f = Foo(0)
//│ f = Foo(0)

set
  f.x = 1
  f.y = 1

:expect 0
f.x
//│ = 0

:re
f.y
//│ ═══[RUNTIME ERROR] Error: Access to required field 'y' yielded 'undefined'



class Foo(mut val x) with
  mut val y = 0
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁵
//│   sym = member:Foo⁶
//│   ctorSym = S of term:Foo⁷
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (mut, val)
//│         sym = x⁵
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x⁶
//│       _2 = term:Foo⁵/x⁷
//│     Tuple2:
//│       _1 = member:y⁰
//│       _2 = term:Foo⁵/y¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Foo⁵/x⁷
//│       sym = member:x⁶
//│       rhs = SimpleRef of x⁵
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Foo⁵/y¹
//│       sym = member:y⁰
//│       rhs = Lit of IntLit of 0


let f = new Foo(0)
//│ f = Foo(0)

set
  f.x = 1
  f.y = 1

// * Note that `mut val`s are backed by an internally mutable private field.

:expect 1
f.x
//│ = 1

:expect 1
f.y
//│ = 1



