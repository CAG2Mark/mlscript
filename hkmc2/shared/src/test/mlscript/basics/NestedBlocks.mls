:js


// * Checking that a `val` in a nested block is not treated as a member of the enclosing object

object Foo with
  if true then
    val x = 0
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Foo⁰
//│   sym = member:Foo¹
//│   k = Obj
//│   ctor = Scoped(syms = {member:x⁰, tmp:scrut⁰, tmp:tmp⁰}):
//│     body = Assign:
//│       lhs = tmp:scrut⁰
//│       rhs = Lit of BoolLit of true
//│       rest = Match: \
//│       scrut = SimpleRef of tmp:scrut⁰
//│       arms = Ls of
//│         Tuple2:
//│           _1 = Lit of BoolLit of true
//│           _2 = Define:
//│             defn = ValDefn:
//│               tsym = term:x¹
//│               sym = member:x⁰
//│               rhs = Lit of IntLit of 0
//│             rest = Assign: \
//│             lhs = tmp:tmp⁰
//│             rhs = Select{sym=object:Unit⁰}:
//│               qual = SimpleRef of tmp:runtime⁰
//│               name = Ident of "Unit"
//│       dflt = S of Throw of Instantiate:
//│         mut = false
//│         cls = Select{sym=class:Error⁰}:
//│           qual = This of globalThis:globalThis⁰
//│           name = Ident of "Error"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of StrLit of "match error"
//│       rest = End of "Rest moved to non-abortive branch(es)"

:e
:re
Foo.x
//│ ╔══[COMPILATION ERROR] Object 'Foo' does not contain member 'x'
//│ ║  l.46: 	Foo.x
//│ ╙──      	   ^^
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'


module Oops with
  if true then
    fun f = 1
    ()
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:Oops⁰
