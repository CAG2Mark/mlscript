x == y
//│ = false

// data classes are equal from arguments

:silent
data class A(a, b, c)
module M with
  data class A(a, b, c)
let x = A(1, 2, 3)
let y = A(1, 2, 3)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:A⁰
//│   sym = member:A¹
//│   ctorSym = S of term:A²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a³
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = b²
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = c⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a⁴
//│       _2 = term:A⁰/a⁵
//│     Tuple2:
//│       _1 = member:b³
//│       _2 = term:A⁰/b⁴
//│     Tuple2:
//│       _1 = member:c¹
//│       _2 = term:A⁰/c²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:A⁰/a⁵
//│       sym = member:a⁴
//│       rhs = SimpleRef of a³
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:A⁰/b⁴
//│       sym = member:b³
//│       rhs = SimpleRef of b²
