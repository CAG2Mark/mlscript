// * Function composition is associative

let
  f = ((_ + 1) >> (_ * 2)) >> (_ - 1)
  g = (_ + 1) >> ((_ * 2) >> (_ - 1))
//│ f = fun
//│ g = fun

[f(123), g(123)]
//│ = [247, 247]


// *** Folding ***


fold(+)(0, 1, 2, 3)
//│ = 6

fold(-)(0, 1, 2, 3)
//│ = -6

fold(print)(0, 1, 2, 3)
//│ > 0 1
//│ > () 2
//│ > () 3

fold(tuple)(0, 1, 2, 3)
//│ = [[[0, 1], 2], 3]

fold(+) of
  0
  1
  2
  3
//│ = 6

