//│     defn = ValDefn:
//│       tsym = term:A⁰/c²
//│       sym = member:c¹
//│       rhs = SimpleRef of c⁰

x == y
//│ = true

x != y
//│ = false

x == A(2, 3, 4)
//│ = false

