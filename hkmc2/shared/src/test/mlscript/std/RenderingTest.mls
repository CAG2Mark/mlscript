class Point(x: Num, y: Num) with
  val x = x
  val y = y
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Point³
//│   sym = member:Point⁴
//│   ctorSym = S of term:Point⁵
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         sym = x⁷
//│         sign = S of Resolved{sym=class:Num⁰}:
//│           t = Ref{sym=member:Num¹} of member:Num¹
//│           sym = class:Num⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         sym = y⁵
//│         sign = S of Resolved{sym=class:Num⁰}:
//│           t = Ref{sym=member:Num¹} of member:Num¹
//│           sym = class:Num⁰
//│         modulefulness = Modulefulness of N
//│   privateFields = Ls of
//│     term:Point³/x⁸
//│     term:Point³/y⁶
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:x⁹
//│       _2 = term:Point³/x¹⁰
//│     Tuple2:
//│       _1 = member:y⁷
//│       _2 = term:Point³/y⁸
//│   ctor = AssignField:
//│     lhs = This of class:Point³
//│     nme = Ident of "x"
//│     rhs = SimpleRef of x⁷
//│     rest = AssignField: \
//│     lhs = This of class:Point³
//│     nme = Ident of "y"
//│     rhs = SimpleRef of y⁵
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Point³/x¹⁰
//│       sym = member:x⁹
//│       rhs = Select{sym=term:Point³/x¹⁰}:
//│         qual = This of class:Point³
//│         name = Ident of "x"
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Point³/y⁸
//│       sym = member:y⁷
//│       rhs = Select{sym=term:Point³/y⁸}:
//│         qual = This of class:Point³
//│         name = Ident of "y"

// Note that we do not display members defined in the body.
// Some classes define lots of members, so doing so could be problematic.
renderAsStr of new Point(0, 1)
//│ = "Point(_, _)"

class SelfRef with
  val a = this
  val b = 1
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:SelfRef⁰
//│   sym = member:SelfRef¹
//│   k = Cls
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a³
//│       _2 = term:SelfRef⁰/a⁴
//│     Tuple2:
//│       _1 = member:b⁰
//│       _2 = term:SelfRef⁰/b¹
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:SelfRef⁰/a⁴
//│       sym = member:a³
//│       rhs = This of class:SelfRef⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:SelfRef⁰/b¹
//│       sym = member:b⁰
//│       rhs = Lit of IntLit of 1

renderAsStr of new SelfRef
//│ = "SelfRef { a: ref'1, b: 1 } as ref'1"

renderAsStr of
  new Object with
    val x = 0
    fun y = 0
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending is part of: Scoped:
//│   syms = HashSet(member:$anon, tmp:tmp)
//│   body = Define:
//│     defn = ClsLikeDefn:
//│       isym = class:$anon⁰
//│       sym = member:$anon¹
//│       k = Cls
//│       parentPath = S of Select{sym=class:Object⁰}:
//│         qual = This of globalThis:globalThis⁰
//│         name = Ident of "Object"
//│       methods = Ls of
//│         FunDefn:
//│           owner = S of class:$anon⁰
//│           sym = member:y⁹
//│           dSym = term:$anon⁰/y¹⁰
//│           body = Return of Lit of IntLit of 0
//│       publicFields = Ls of
//│         Tuple2:
//│           _1 = member:x¹¹
//│           _2 = term:$anon⁰/x¹²
//│       preCtor = Assign:
//│         lhs = ‹no symbol›
//│         rhs = Call:
//│           fun = SimpleRef of builtin:super⁰
//│           argss = Ls of
//│             Nil
//│       ctor = Define:
//│         defn = ValDefn:
//│           tsym = term:$anon⁰/x¹²
//│           sym = member:x¹¹
//│           rhs = Lit of IntLit of 0
//│     rest = Assign: \
//│     lhs = tmp:tmp⁰
//│     rhs = Instantiate:
//│       mut = false
//│       cls = MemberRef{disamb=class:$anon⁰}:
//│         bms = member:$anon¹
//│         disamb = class:$anon⁰
//│       argss = Ls of
//│         Nil
//│     rest = Return of Call:
//│       fun = Select{sym=term:Predef⁰/renderAsStr⁰}:
//│         qual = MemberRef{disamb=module:Predef⁰}:
//│           bms = member:Predef¹
//│           disamb = module:Predef⁰
//│         name = Ident of "renderAsStr"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = SimpleRef of tmp:tmp⁰
//│ = "$anon { x: 0 }"

