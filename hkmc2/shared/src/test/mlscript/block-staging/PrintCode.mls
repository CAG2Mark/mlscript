:staging
:js

import "../../mlscript-compile/Block.mls"
import "../../mlscript-compile/Option.mls"

open Block
open Option

printCode(FunDefn(Symbol("f"), [[Symbol("x")]], Return(ValueLit(1))))
//│ > fun f(x) = 1

printCode(ValueLit(true))
printCode(ValueLit(null))
printCode(ValueLit(undefined))
printCode(ValueLit("c"))
printCode(ValueLit("string"))
//│ > true
//│ > null
//│ > undefined
//│ > "c"
//│ > "string"

printCode(Symbol("internal$"))
//│ > internal_

printCode(Select(ValueSimpleRef(Symbol("p")), Symbol("x")))
printCode(DynSelect(ValueSimpleRef(Symbol("p")), ValueSimpleRef(Symbol("field")), false))
//│ > p.x
//│ > p.(field)

:silent
class A(val x)(y)
class B
let aSym = ConcreteClassSymbol("A", A, Some([Symbol("x")]), [[Symbol("y")]])
let bSym = ConcreteClassSymbol("B", B, None, [])
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending is part of: Scoped:
//│   syms = HashSet(tmp:tmp, tmp:tmp, tmp:tmp, tmp:tmp, tmp:tmp, tmp:tmp, tmp:tmp)
//│   body = Define:
//│     defn = ClsLikeDefn:
//│       isym = class:A⁰
//│       sym = member:A¹
//│       ctorSym = S of term:A²
//│       k = Cls
//│       paramsOpt = S of ParamList:
//│         params = Ls of
//│           Param:
//│             flags = (val)
//│             sym = x⁰
//│             modulefulness = Modulefulness of N
//│       auxParams = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = y⁰
//│               modulefulness = Modulefulness of N
//│       privateFields = Ls of
//│         term:A⁰/y¹
//│       publicFields = Ls of
//│         Tuple2:
//│           _1 = member:x¹
//│           _2 = term:A⁰/x²
//│       ctor = Define:
//│         defn = ValDefn:
//│           tsym = term:A⁰/x²
//│           sym = member:x¹
//│           rhs = SimpleRef of x⁰
//│         rest = AssignField: \
//│         lhs = This of class:A⁰
//│         nme = Ident of "y"
//│         rhs = SimpleRef of y⁰
//│     rest = Define: \
//│     defn = ClsLikeDefn:
//│       isym = class:B⁰
//│       sym = member:B¹
//│       k = Cls
//│     rest = Assign: \
//│     lhs = tmp:tmp⁰
//│     rhs = Call:
//│       fun = Select{sym=term:Block⁰/Symbol⁰}:
//│         qual = MemberRef{disamb=module:Block⁰}:
//│           bms = member:Block¹
//│           disamb = module:Block⁰
//│         name = Ident of "Symbol"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of StrLit of "x"
//│     rest = Assign: \
//│     lhs = tmp:tmp¹
//│     rhs = Tuple:
//│       mut = false
//│       elems = Ls of
//│         Arg:
//│           value = SimpleRef of tmp:tmp⁰
//│     rest = Assign: \
//│     lhs = tmp:tmp²
//│     rhs = Call:
//│       fun = Select{sym=term:Option⁰/Some⁰}:
//│         qual = MemberRef{disamb=module:Option⁰}:
//│           bms = member:Option¹
//│           disamb = module:Option⁰
//│         name = Ident of "Some"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = SimpleRef of tmp:tmp¹
//│     rest = Assign: \
//│     lhs = tmp:tmp³
//│     rhs = Call:
//│       fun = Select{sym=term:Block⁰/Symbol⁰}:
//│         qual = MemberRef{disamb=module:Block⁰}:
//│           bms = member:Block¹
//│           disamb = module:Block⁰
//│         name = Ident of "Symbol"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of StrLit of "y"
//│     rest = Assign: \
//│     lhs = tmp:tmp⁴
//│     rhs = Tuple:
//│       mut = false
//│       elems = Ls of
//│         Arg:
//│           value = SimpleRef of tmp:tmp³
//│     rest = Assign: \
//│     lhs = tmp:tmp⁵
//│     rhs = Tuple:
//│       mut = false
//│       elems = Ls of
//│         Arg:
//│           value = SimpleRef of tmp:tmp⁴
//│     rest = Assign: \
//│     lhs = aSym⁰
//│     rhs = Call:
//│       fun = Select{sym=term:Block⁰/ConcreteClassSymbol⁰}:
//│         qual = MemberRef{disamb=module:Block⁰}:
//│           bms = member:Block¹
//│           disamb = module:Block⁰
//│         name = Ident of "ConcreteClassSymbol"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of StrLit of "A"
//│           Arg:
//│             value = MemberRef{disamb=term:A²}:
//│               bms = member:A¹
//│               disamb = term:A²
//│           Arg:
//│             value = SimpleRef of tmp:tmp²
//│           Arg:
//│             value = SimpleRef of tmp:tmp⁵
//│     rest = Assign: \
//│     lhs = tmp:tmp⁶
//│     rhs = Tuple:
//│       mut = false
//│     rest = Assign: \
//│     lhs = bSym⁰
//│     rhs = Call:
//│       fun = Select{sym=term:Block⁰/ConcreteClassSymbol⁰}:
//│         qual = MemberRef{disamb=module:Block⁰}:
//│           bms = member:Block¹
//│           disamb = module:Block⁰
//│         name = Ident of "ConcreteClassSymbol"
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of StrLit of "B"
//│           Arg:
//│             value = MemberRef{disamb=class:B⁰}:
//│               bms = member:B¹
//│               disamb = class:B⁰
//│           Arg:
//│             value = Select{sym=object:None⁰}:
//│               qual = MemberRef{disamb=module:Option⁰}:
//│                 bms = member:Option¹
//│                 disamb = module:Option⁰
//│               name = Ident of "None"
//│           Arg:
//│             value = SimpleRef of tmp:tmp⁶

printCode(Call(ValueSimpleRef(Symbol("f")), [Arg(ValueLit(3))]))
printCode(Instantiate(ValueMemberRef(aSym), [Arg(ValueLit(0))]))
printCode(Tuple([Arg(ValueSimpleRef(Symbol("x"))), Arg(ValueSimpleRef(Symbol("y")))]))
//│ > f(3)
//│ > new A(0)
//│ > [x, y]

:silent
let f = FunDefn(Symbol("f"), [[Symbol("x")]], Return(ValueLit(1)))

printCode(f)
printCode(ClsLikeDefn(aSym, [f], None))
printCode(ClsLikeDefn(bSym, [], None))
//│ > fun f(x) = 1
//│ > class A(x) with
//│ >   fun f(x) = 1
//│ > class B

printCode(Scoped([Symbol("x"), Symbol("y")], Assign(Symbol("x"), ValueLit(4.2), Return(ValueSimpleRef(Symbol("x"))))))
//│ > let {x, y}
//│ > x = 4.2
//│ > x

printCode(Define(ValDefn(Some(aSym), Symbol("x"), ValueLit(1)), End()))
printCode(Define(ValDefn(None, Symbol("a"), ValueLit(1)), End()))
//│ > val x = 1
//│ > val a = 1

printCode(Match(ValueSimpleRef(Symbol("x")), [Arm(Lit(1), Return(ValueLit(2))), Arm(Cls(aSym, ValueMemberRef(aSym)), Return(ValueLit(3)))], Some(Return(ValueSimpleRef(Symbol("x")))), End()))
//│ > if x is
//│ >   1 then 2
//│ >   A then 3
//│ >   else x

printCode(Scoped([Symbol("y")], Match(
    ValueLit(1),
    [Arm(Lit(1), Return(ValueLit(1)))],
    Some(Return(ValueLit(1))),
    Return(ValueSimpleRef(Symbol("y"))))))
//│ > let {y}
//│ > if 1 is
//│ >   1 then 1
//│ >   else 1
//│ > y

printCode(Scoped([Symbol("y")],  Match(
    ValueLit(1),
    [Arm(Lit(1), Assign(Symbol("y"), ValueLit(1), Return(ValueSimpleRef(Symbol("y")))))],
    Some(Assign(Symbol("y"), ValueLit(2), Return(ValueSimpleRef(Symbol("y"))))),
    End())))
//│ > let {y}
//│ > if 1 is
//│ >   1 then
//│ >     y = 1
//│ >     y
//│ >   else
//│ >     y = 2
//│ >     y

printCode(Scoped([Symbol("y")], Match(
    ValueLit(1),
    [Arm(Lit(1), Match(
        ValueLit(2),
        [Arm(Lit(2), Assign(Symbol("y"), ValueLit(1), Return(ValueSimpleRef(Symbol("y")))))],
        Some(Assign(Symbol("y"), ValueLit(2), Return(ValueSimpleRef(Symbol("y"))))),
        End()
    ))],
    Some(Assign(Symbol("y"), ValueLit(3), Return(ValueSimpleRef(Symbol("y"))))),
    End())))
//│ > let {y}
//│ > if 1 is
//│ >   1 then
//│ >     if 2 is
//│ >       2 then
//│ >         y = 1
//│ >         y
//│ >       else
//│ >         y = 2
//│ >         y
//│ >   else
//│ >     y = 3
//│ >     y
