:js
open annotations


:sjs
@tailrec
fun f = f
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function f() { loopLabel: while (true) { continue loopLabel; } };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:fixme
module Foo with
  @tailrec
  fun bar = bar
