//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = x⁰
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:tmp⁰, tmp:tmp¹}):
//│         body = Assign:
//│           lhs = tmp:tmp⁰
//│           rhs = Call:
//│             fun = Select{sym=term:A⁰/f¹}:
//│               qual = This of module:A⁰
//│               name = Ident of "f"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of x⁰
//│           rest = Assign: \
//│           lhs = tmp:tmp¹
//│           rhs = Call:
//│             fun = SimpleRef of builtin:+⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of tmp:tmp⁰
//│                 Arg:
//│                   value = Lit of IntLit of 1
//│           rest = Return of Call:
//│             fun = Select{sym=term:A⁰/f¹}:
//│               qual = This of module:A⁰
//│               name = Ident of "f"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of tmp:tmp¹


