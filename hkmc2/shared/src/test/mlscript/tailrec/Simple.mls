@tailrec
fun f() = f()

module Foo with
  @tailrec
  fun bar() = bar()
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:Foo¹
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of module:Foo¹
//│       sym = member:bar²
//│       dSym = term:Foo¹/bar³
//│       params = Ls of
//│         ParamList: ‹empty›
//│       body = Return of Call:
//│         fun = Select{sym=term:Foo¹/bar³}:
//│           qual = This of module:Foo¹
//│           name = Ident of "bar"
//│         argss = Ls of
//│           Nil

fun f(x) = f(x + 1)

// * We can still optimize functions that have only some of their calls in tail positions.
:sjs
fun f(x) = f(f(x) + 1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f3;
//│ f3 = function f(x) {
//│   loopLabel: while (true) {
//│     let tmp, tmp1;
//│     tmp = f3(x);
//│     tmp1 = tmp + 1;
//│     x = tmp1;
//│     continue loopLabel;
//│   }
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

module A with
  fun f(x) = @tailcall f(f(x) + 1)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeBody:
//│   isym = module:A⁰
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of module:A⁰
//│       sym = member:f⁰
