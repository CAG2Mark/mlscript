:silent
:lift
:rewriteWhile
:expect 200010000
val x = mut []
let n = 20000
let i = 0
while i < n do
  x.push of () => i
  set i += 1
fun sumOf(x, idx, acc) =
  if idx == 0 then acc
  else 
    sumOf(x, idx - 1, acc + x![idx]())
sumOf(x, n - 1, 0)

// Check that spreads are compiled correctly

fun f(x, ...z) =
  if x < 0 then 0
  else g(x, 0, x, x)
fun g(x, y, ...z) =
  if x < 0 then 0
  else f(x - 1, 0, ...[x, x, x])
f(100)
//│ = 0

fun f(n, x, y, z) =
  if n > 0 then @tailcall f(n - 1, ...[1, 2], 3) else y

:expect 2
f(10, 0, 0, 0)
//│ = 2

fun f(a, ...z) = if z is
  [] then a
  [x, ...xs] then f(a + 1, ...xs)

:expect 4
f(0, 1, 2, 3, 4)
//│ = 4

:soir
fun f(n, a, b, c, d, ...e) =
  if n > 0 then @tailcall g(n - 1)
  else e
fun g(n) =
  @tailcall f(n, ...[1, 2], 3, ...[3, 4], ...[5, n], 7, n)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f_g;
//│ @private
//│ define f_g as fun f_g⁰(id, param0, param5) {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         let scrut, tmp;
//│         set scrut = >⁰(param0, 0);
//│         match scrut
//│           true =>
//│             set tmp = -⁰(param0, 1);
//│             set param0 = tmp;
//│             set id = 1;
//│             continue loopLabel
//│           else
//│             return param5
//│         end
//│       1 =>
//│         let tmp, tmp1, tmp2, argList, inlinedVal, tmp3;
//│         set tmp = [1, 2];
//│         set tmp1 = [3, 4];
//│         set tmp2 = [5, param0];
//│         set argList = [param0, ...tmp, 3, ...tmp1, ...tmp2, 7, param0];
//│         set tmp3 = -¹(argList.length﹖, 0);
//│         set inlinedVal = argList.slice﹖(5, tmp3);
//│         set param0 = argList.0;
//│         do argList.1;
//│         do argList.2;
//│         do argList.3;
//│         do argList.4;
//│         set param5 = inlinedVal;
//│         set id = 0;
//│         continue loopLabel
//│       else
//│         end
//│     end
//│   end
//│ };
//│ @inline
//│ define f² as fun f³(n, a, b, c, d, ...e) {
//│   return f_g⁰(0, n, e)
//│ };
//│ @inline
//│ define g² as fun g³(n) { return f_g⁰(1, n, undefined) };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [4, 5, 0, 7, 0]
g(10)
//│ = [4, 5, 0, 7, 0]

:e
:lift
fun f(x) =
  fun g() =
    @tailcall f(x)
    @tailcall f(x)
  @tailcall g()
