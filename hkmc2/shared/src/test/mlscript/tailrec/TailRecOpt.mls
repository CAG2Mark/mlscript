// Nothing should be rewritten in the non tail calls
:soir
fun f(n, x, ...y) =
  if n === 0 then [x, y]
  else
    f(0, 1, 2, 3)
    f(0, ...[1, 2, 3])
    f(0, 1, 2, 3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f¹⁰ as fun f¹¹(n, x, ...y) {
//│   loop loopLabel:
//│     let scrut, tmp;
//│     set scrut = ===⁰(n, 0);
//│     match scrut
//│       true =>
//│         return [x, y]
//│       else
//│         do f¹¹(0, 1, 2, 3);
//│         set tmp = [1, 2, 3];
//│         do f¹¹(0, ...tmp);
//│         set n = 0;
//│         set x = 1;
//│         set y = mut [2, 3];
//│         continue loopLabel
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

