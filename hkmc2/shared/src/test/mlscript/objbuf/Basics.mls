:js

import "../../mlscript-compile/ObjectBuffer.mls"
open ObjectBuffer
open annotations


@buffered
class A(x) with
  fun f(y) = x + y

@bufferable
class A2(x) with
  fun f(y) = x + y

:ge
@buffered
@buffered
class B1(x)
//│ ╔══[COMPILATION ERROR] Only one of bufferable annotation is allowed.
