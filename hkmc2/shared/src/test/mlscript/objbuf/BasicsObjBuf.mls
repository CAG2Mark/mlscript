:breakme // TODO: disallow direct instantiation of @buffered classes
new A
//│ = fun

:fixme // TODO: disallow direct instantiation of @buffered classes
new A(123).f(0)
//│ ═══[RUNTIME ERROR] TypeError: tmp.f is not a function


let buf = new DefaultObjectBuffer(10)
//│ buf = DefaultObjectBuffer(_)

let obj1 = buf.mkNew(A)(3)
//│ obj1 = 0

let obj2 = buf.mkNew(A)(5)
//│ obj2 = 2

A.f(buf, obj1)(1)
//│ = 4

A.f(buf, obj2)(1)
//│ = 6

buf.del(A, obj1)

let obj3 = buf.mkNew(A)(10)
//│ obj3 = 0

// UAF
A.f(buf, obj1)(1)
//│ = 11

A.f(buf, obj3)(1)
//│ = 11


@bufferable
class Oops with
  fun hi = print("hi")
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Oops⁰
//│   sym = member:Oops¹
//│   k = Cls
//│   methods = Ls of
//│     FunDefn:
//│       owner = S of class:Oops⁰
//│       sym = member:hi⁰
//│       dSym = term:Oops⁰/hi¹
//│       body = Return of Call:
//│         fun = Select{sym=term:Predef⁰/print⁰}:
//│           qual = MemberRef{disamb=module:Predef⁰}:
//│             bms = member:Predef¹
//│             disamb = module:Predef⁰
//│           name = Ident of "print"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of StrLit of "hi"
//│   bufferable = S of true

let obj1 = buf.mkNew(Oops)
//│ obj1 = 0


Oops.hi(buf, obj2)
//│ > hi

let obj2 = buf.mkNew(A)(3)
//│ obj2 = 4

A.f(buf, obj2)(1)
//│ = 4

buf.del(Oops, obj1)

:expect 4
A.f(buf, obj2)(1)
//│ = 4


