fun borrow: [S, T, E extends ~S] -> Region[out S] -> ([P] -> Region[out P] ->{E | P} T) ->{E} T


fun foo(f) =
  region r in
    let x = r.ref 0
    f(n => x := n)
    borrow(r) of it =>
      foo(f)
foo
//│ Type: [outer, 'n, 'eff] -> (('n ->{¬outer} ('n ∨ Int)) ->{'eff} ⊤) ->{'eff} ⊥
//│ Where:
//│   'n <: Int
//│   'eff <: outer
