  region r2 in
    fork((_ => r1.ref 1), (_ => r2.ref 2))
annohelper
//│ Type: [outer, 'T] -> (Region[out 'T ∧ outer]) ->{'T ∧ outer} Pair[out Ref[Int, out 'T ∧ outer], out Ref[Int, out ¬outer]]


