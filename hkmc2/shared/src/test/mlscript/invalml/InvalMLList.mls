fun mapi: [A, E] -> List[out A] -> ((Int, A) ->{E} A) ->{E} List[out A]
fun mapi = s =>
  region r in
    let i = r.ref 0
    f => map(s) of x =>
      i := !(i) + 1
      f(!(i), x)
