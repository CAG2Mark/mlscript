class Reg[Rg, Br]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Reg⁰
//│   sym = member:Reg¹
//│   k = Cls

fun letreg: [E, Res] -> ([Rg] -> Reg[Rg, E] ->{E | Rg} Res) ->{E} Res

fun use_ : [Rg, Br] -> Reg[Rg, Br] ->{Rg} Int


class MutVec[A, Rg, Br]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:MutVec⁰
//│   sym = member:MutVec¹
//│   k = Cls

fun mkVec: [A, Rg, Br] -> Reg[Rg, Br] -> MutVec[A, Rg, Br]

fun clear: [A, Rg, Br] -> MutVec[A, Rg, Br] ->{Rg} Int

class Iter[A, Rg]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Iter⁰
//│   sym = member:Iter¹
//│   k = Cls

fun iterate: [A, Rg, Br, Res] -> MutVec[A, Rg, Br] -> ([L] -> Iter[A, Br | L] ->{Br | L} Res) ->{Br} Res

fun integers: [Rg, Br, Res] -> Reg[Rg, Br] ->{Rg} (Iter[Int, Br] ->{Br} Res) ->{Br} Res


fun next: [A, Br] -> Iter[A, Br] ->{Br} A

letreg(r => r)
//│ Type: Reg[?, 'E]
//│ Where:
//│   'E <: ⊥

letreg of r =>
  let b = mkVec(r)
  clear(b)
  iterate(b) of it =>
    next(it)
    123
  clear(b)
  r
//│ Type: Reg[?, 'E]
//│ Where:
//│   'E <: ⊥


