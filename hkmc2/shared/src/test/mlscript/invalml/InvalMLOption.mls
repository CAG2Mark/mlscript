data class Option[out A](inspect: [E, Res] -> (() ->{E} Res, A ->{E} Res) ->{E} Res)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Option⁰
//│   sym = member:Option¹
//│   ctorSym = S of term:Option²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = inspect⁰
//│         sign = S of Forall:
//│           tvs = Ls of
//│             QuantVar:
//│               sym = E⁰
//│             QuantVar:
//│               sym = Res⁰
//│           body = FunTy:
//│             lhs = Tup of Ls of
//│               Fld:
//│                 term = FunTy:
//│                   lhs = Tup of Nil
//│                   rhs = Ref{sym=Res⁰} of Res⁰
//│                   eff = S of Ref{sym=E⁰} of E⁰
//│               Fld:
//│                 term = FunTy:
//│                   lhs = Tup of Ls of
//│                     Fld:
//│                       term = Ref{sym=A⁰} of A⁰
//│                   rhs = Ref{sym=Res⁰} of Res⁰
//│                   eff = S of Ref{sym=E⁰} of E⁰
//│             rhs = Ref{sym=Res⁰} of Res⁰
//│             eff = S of Ref{sym=E⁰} of E⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:inspect¹
//│       _2 = term:Option⁰/inspect²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Option⁰/inspect²
//│       sym = member:inspect¹
//│       rhs = SimpleRef of inspect⁰

opt => opt.Option#inspect
//│ Type: (Option[out 'A]) ->{⊥} ['E, 'Res] -> (() ->{'E} 'Res, ('A) ->{'E} 'Res) ->{'E} 'Res

opt => opt.Option#inspect(
  () => 42
  n => n + 1
)
//│ Type: (Option[out Int]) ->{⊥} Int

opt => opt.Option#inspect of () => 42, n => n + 1
//│ Type: (Option[out Int]) ->{⊥} Int

opt => opt.Option#inspect of
  () => 42
  n => n + 1
//│ Type: (Option[out Int]) ->{⊥} Int


opt => opt as Option[out Int]
//│ Type: (Option[out Int]) ->{⊥} Option[out Int]

opt => (opt as Option[Int]) as Option[Int | Str]
//│ Type: (Option[out Int ∨ Str] ∧ Option[out Int]) ->{⊥} Option[out Int ∨ Str]


