(x => x + 1) as [A extends Int] -> A -> Int
//│ Type: (Int) ->{⊥} Int


(x => x) as [A restricts Int] -> A -> A
//│ Type: ['A] -> ('A) ->{⊥} 'A
//│ Where:
//│   Int <: 'A


(x => x - 1) as [A extends Int restricts Int] -> A -> A
//│ Type: ['A] -> ('A) ->{⊥} 'A
//│ Where:
//│   Int <: 'A
//│   'A <: Int

fun iid: [A extends Int] -> A -> A
fun iid(x) = x

iid
//│ Type: ['A] -> ('A) ->{⊥} 'A
//│ Where:
//│   'A <: Int

:e
iid("42")
//│ ╔══[COMPILATION ERROR] Type error in string literal with expected type 'A
//│ ║  l.144: 	iid("42")
//│ ║         	    ^^^^
//│ ╟── because: cannot constrain  Str  <:  'A
//│ ╙── because: cannot constrain  Str  <:  Int
//│ Type: Str


iid(42)
//│ Type: Int

class Foo[A]
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Foo⁰
//│   sym = member:Foo¹
//│   k = Cls

fun foo: [A extends Foo[in Nothing out Any] restricts Foo[in Num]] -> A -> A
foo
//│ Type: ['A] -> ('A) ->{⊥} 'A
//│ Where:
//│   Foo[in Num] <: 'A
//│   'A <: Foo[?]

fun bar: Foo[in Num out Int]

foo(bar)
//│ Type: Foo[in Num out Int] ∨ Foo[in Num]

