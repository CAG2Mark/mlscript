data class Nil()
data class Cons[A, B](val car: A, val cdr: B)
data class Ls[A](prim: [R] -> (() -> R, (A, Ls[A]) -> R) -> R)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Nil⁰
//│   sym = member:Nil¹
//│   ctorSym = S of term:Nil²
//│   k = Cls
//│   paramsOpt = S of ParamList: ‹empty›

fun nil() = new Ls((n, _) => n())
fun cons(p, q) = new Ls((n, r) => r(p, q))
fun from(x) = x.Ls#prim(() => new Nil, (x, y) => new Cons(x, from(y)))
fun to(x) = if x is
  Nil then nil()
  Cons then cons(x.Cons#car, to(x.Cons#cdr))

let foo = nil() from()
foo
//│ Type: Cons['A, 'B] ∨ Nil
//│ Where:
//│   ⊥ <: 'A
//│   Cons['A, 'B] <: 'R
//│   Nil <: 'R
//│   'R <: 'B


foo to()
//│ Type: Ls['A] ∨ Ls['A1]
//│ Where:
//│   ⊥ <: 'A
//│   'A <: 'A1
//│   ⊥ <: 'A1
//│   'A1 <: 'A


fun (;) seq(_, res) = res

fun foo: [R1, R2] -> (Region[R1], Region[R2], Int ->{R1 & ~R2} (), Int ->{R2 & ~R1} ()) ->{R1 | R2} () 
