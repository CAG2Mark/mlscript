fun sum(xs) =
  if xs is
    Nil then 0
    Cons(x, xs) then x + sum(xs)
sum
//│ Type: IntList -> Int


sum(Cons(1, Cons(2, Cons(3, Cons(4, Nil)))))
//│ Type: Int


