data class LsAlg[A, E](nil:() -> E, cons: (A, E) -> E)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:LsAlg⁰
//│   sym = member:LsAlg¹
//│   ctorSym = S of term:LsAlg²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = nil⁰
//│         sign = S of FunTy:
//│           lhs = Tup of Nil
//│           rhs = Ref{sym=E⁰} of E⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = cons⁰
//│         sign = S of FunTy:
//│           lhs = Tup of Ls of
//│             Fld:
//│               term = Ref{sym=A⁰} of A⁰
//│             Fld:
//│               term = Ref{sym=E⁰} of E⁰
//│           rhs = Ref{sym=E⁰} of E⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:nil¹
//│       _2 = term:LsAlg⁰/nil²
//│     Tuple2:
//│       _1 = member:cons¹
//│       _2 = term:LsAlg⁰/cons²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:LsAlg⁰/nil²
//│       sym = member:nil¹
//│       rhs = SimpleRef of nil⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:LsAlg⁰/cons²
//│       sym = member:cons¹
//│       rhs = SimpleRef of cons⁰

fun nil(x) = x.LsAlg#nil()
fun cons(x, y, z) = x.LsAlg#cons(y, z)

data class Nil()
data class Cons[A, B](val x: A,val y: B)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Nil⁰
//│   sym = member:Nil¹
//│   ctorSym = S of term:Nil²
//│   k = Cls
//│   paramsOpt = S of ParamList: ‹empty›

fun mk() = new LsAlg(() => new Nil, (x, y) => new Cons(x, y))

// fun xs: [E] -> LsAlg[in Int, E] -> E
fun xs(x) = x cons(1, x nil())

fun ys: [E] -> LsAlg[in Nothing, E] -> E
fun ys(x) = x nil()

fun zs: [E] -> LsAlg[in Int | E, E] -> E
fun zs(x) = x cons(xs(x), x cons(ys(x),x nil()))

mk() zs()
//│ = Cons(Cons(1, fun), Cons(fun, fun))
//│ Type: Nil ∨ Cons['A, 'B]
//│ Where:
//│   ('E ∨ Cons['A, 'B]) ∨ Nil <: 'B
//│   Nil <: 'E
//│   Cons['A, 'B] <: 'E
//│   'E ∨ Int <: 'A
