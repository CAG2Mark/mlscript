:lift
:js
// NOTE: due to conflict between flow analysis and lifter
:deadParamElim off


// * Lifting an object may require it to gain some mutable fields

:todo
:w
fun foo(x, y) =
  object M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()
//│ ╔══[WARNING] Objects are not yet lifted.
//│ ║  l.12: 	  object M with
//│ ╙──      	         ^

:expect 14
foo(10, 0)
//│ = 14

// * This works the same with classes.
// * Note that we currently generate accessors, which is not ideal;
// * When the captures are not accessed from the outside, we should be able to drop these.
:sir
fun foo(y) =
  class M with
    fun foo() =
      set y = 2
  (new M).foo()
foo(10)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending is part of: Scoped:
//│   syms = Set(member:M)
//│   body = Define:
//│     defn = ClsLikeDefn:
//│       isym = class:M⁰
//│       sym = member:M¹
//│       k = Cls
//│       auxParams = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = y⁰
//│               modulefulness = Modulefulness of N
//│       methods = Ls of
//│         FunDefn:
//│           owner = S of class:M⁰
//│           sym = member:foo⁰
//│           dSym = term:M⁰/foo¹
//│           params = Ls of
//│             ParamList: ‹empty›
//│           body = AssignField:
//│             lhs = This of class:M⁰
//│             nme = Ident of "y"
//│             rhs = Lit of IntLit of 2
//│             rest = Return of Select{sym=object:Unit⁰}:
//│               qual = SimpleRef of tmp:runtime⁰
//│               name = Ident of "Unit"
//│       privateFields = Ls of
//│         term:M⁰/y¹
//│       ctor = AssignField:
//│         lhs = This of class:M⁰
//│         nme = Ident of "y"
//│         rhs = SimpleRef of y⁰
//│     rest = Define: \
//│     defn = FunDefn:
//│       sym = member:foo²
//│       dSym = term:foo³
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = y²
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:tmp⁰}):
//│         body = Assign:
//│           lhs = tmp:tmp⁰
//│           rhs = Instantiate:
//│             mut = false
//│             cls = MemberRef{disamb=class:M⁰}:
//│               bms = member:M¹
//│               disamb = class:M⁰
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = SimpleRef of y²
//│           rest = Return of Call:
//│             fun = Select{sym=term:M⁰/foo¹}:
//│               qual = SimpleRef of tmp:tmp⁰
//│               name = Ident of "foo"
//│             argss = Ls of
//│               Nil
//│     rest = Return of Call:
//│       fun = MemberRef{disamb=term:foo³}:
//│         bms = member:foo²
//│         disamb = term:foo³
//│       argss = Ls of
//│         Ls of
//│           Arg:
//│             value = Lit of IntLit of 10
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let M;
//│ define M as class M⁰ {
//│   private val y¹;
//│   constructor(y) {
//│     set M⁰.this.y¹ = y;
//│     end
//│   }
//│   method foo⁰ = fun foo¹() {
//│     set M⁰.this.y¹ = 2;
//│     return runtime⁰.Unit⁰
//│   }
//│ };
//│ define foo² as fun foo³(y) { let tmp; set tmp = new M⁰(y); return tmp.foo¹() };
//│ return foo³(10)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// * `new mut` (or lack thereof) should be preserved by the lifter

fun foo(y) =
  class C with
    fun foo() =
      set y = 2
  [new C, new mut C]
