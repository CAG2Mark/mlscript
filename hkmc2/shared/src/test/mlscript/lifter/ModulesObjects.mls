//│               Arg:
//│                 value = SimpleRef of tmp:tmp¹
//│               Arg:
//│                 value = SimpleRef of tmp:tmp²

let
  cc = foo(10)
  c0 = cc.0
  c1 = cc.1
//│ c0 = C
//│ c1 = C
//│ cc = [C, C]

:re
set c0.x = 1
c0.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

set c1.x = 1
c1.x
//│ = 1


