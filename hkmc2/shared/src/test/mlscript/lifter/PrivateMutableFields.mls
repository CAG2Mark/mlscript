//│                 fun = SimpleRef of builtin:+⁰
//│                 argss = Ls of
//│                   Ls of
//│                     Arg:
//│                       value = Select{sym=term:$anon⁰/state⁰}:
//│                         qual = This of class:$anon⁰
//│                         name = Ident of "state"
//│                     Arg:
//│                       value = Lit of IntLit of 1
//│               rest = AssignField: \
//│               lhs = This of class:$anon⁰
//│               nme = Ident of "state"
//│               rhs = SimpleRef of tmp:tmp⁰
//│               rest = Return of Select{sym=term:$anon⁰/state⁰}:
//│                 qual = This of class:$anon⁰
//│                 name = Ident of "state"
//│       privateFields = Ls of
//│         term:$anon⁰/state⁰
