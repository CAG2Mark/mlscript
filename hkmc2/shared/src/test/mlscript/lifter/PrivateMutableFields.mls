//│   }
//│ };
//│ define Foo⁵ as class Foo⁴ {
//│   private val x⁰;
//│   constructor Foo⁶(x) {
//│     set Foo⁴.this.x⁰ = x;
//│     end
//│   }
//│   method foo² = fun foo³(y) { return new $anon²(Foo⁴.this, y) }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let f = new Foo(123)
//│ f = Foo(_)

let o = f.foo(456)
//│ o = $anon

o.test
//│ = 580

:expect 581
o.test
//│ = 581

:expect 580
f.foo(456).test
//│ = 580


