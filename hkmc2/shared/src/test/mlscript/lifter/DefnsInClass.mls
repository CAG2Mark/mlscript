//│         term:B⁰/A²
//│       publicFields = Ls of
//│         Tuple2:
//│           _1 = member:y²
//│           _2 = term:B⁰/y¹
//│       ctor = AssignField:
//│         lhs = This of class:B⁰
//│         nme = Ident of "A"
//│         rhs = SimpleRef of A¹
//│         rest = Define: \
//│         defn = ValDefn:
//│           tsym = term:B⁰/y¹
//│           sym = member:y²
//│           rhs = SimpleRef of y⁰
//│     rest = Define: \
//│     defn = ClsLikeDefn:
//│       isym = class:A⁰
//│       sym = member:A³
//│       ctorSym = S of term:A⁴
//│       k = Cls
//│       paramsOpt = S of ParamList:
//│         params = Ls of
//│           Param:
//│             flags = (val)
//│             sym = x¹
//│             modulefulness = Modulefulness of N
//│       methods = Ls of
//│         FunDefn:
//│           owner = S of class:A⁰
//│           sym = member:getA⁰
//│           dSym = term:A⁰/getA¹
//│           params = Ls of
//│             ParamList: ‹empty›
//│           body = Scoped(syms = {tmp:tmp⁰}):
//│             body = Assign:
//│               lhs = tmp:tmp⁰
//│               rhs = Instantiate:
//│                 mut = false
//│                 cls = MemberRef{disamb=class:B⁰}:
//│                   bms = member:B¹
//│                   disamb = class:B⁰
//│                 argss = Ls of
//│                   Ls of
//│                     Arg:
//│                       value = Lit of IntLit of 2
//│                   Ls of
//│                     Arg:
//│                       value = This of class:A⁰
//│               rest = Return of Call:
//│                 fun = Select{sym=term:B⁰/getB¹}:
//│                   qual = SimpleRef of tmp:tmp⁰
//│                   name = Ident of "getB"
//│                 argss = Ls of
//│                   Nil
//│       publicFields = Ls of
//│         Tuple2:
//│           _1 = member:x²
//│           _2 = term:A⁰/x⁰
//│       ctor = Define:
//│         defn = ValDefn:
//│           tsym = term:A⁰/x⁰
//│           sym = member:x²
//│           rhs = SimpleRef of x¹
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let B;
//│ @data
//│ define B as class B⁰ {
//│   private val A²;
//│   val y²;
//│   constructor B²(y, A) {
//│     set B⁰.this.A² = A;
//│     define y² as val y¹ = y;
//│     end
//│   }
//│   method getB⁰ = fun getB¹() {
//│     return +⁰(B⁰.this.A².x⁰, B⁰.this.y¹)
//│   }
//│ };
//│ @data
//│ define A³ as class A⁰ {
//│   val x²;
//│   constructor A⁴(x) {
//│     define x² as val x⁰ = x;
//│     end
//│   }
//│   method getA⁰ = fun getA¹() { let tmp; set tmp = new B⁰(2, A⁰.this); return tmp.getB¹() }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect 3
A(1).getA()
//│ = 3

