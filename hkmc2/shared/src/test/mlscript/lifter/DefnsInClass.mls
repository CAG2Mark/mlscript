//│           sym = member:x⁶
//│           rhs = MemberRef{disamb=term:g¹}:
//│             bms = member:g⁰
//│             disamb = term:g¹
//│     rest = Assign: \
//│     lhs = tmp:tmp²
//│     rhs = Instantiate:
//│       mut = false
//│       cls = MemberRef{disamb=class:A⁵}:
