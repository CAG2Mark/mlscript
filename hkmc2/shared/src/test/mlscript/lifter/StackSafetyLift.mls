//│     set tmp = runtime⁰.cpsSetCheckDepth﹖();
//│     match tmp
//│       true =>
//│         return runtime⁰.cpsRaiseStack﹖(cpsCont$0⁰, undefined)
//│       else
//│         return cpsCont$0⁰(undefined)
//│     end
//│   };
//│   return hi¹(runtime⁰.cpsId﹖, 0)
//│ };
//│ return runtime⁰.runStackSafeCps﹖(6, ‹stack safe body›⁰)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:sir
:stackSafe
:effectHandlers
:expect 50005000
