//│ = Suspend(fun cpsId, Handler$h$, fun Handler$h$perform)

:re
:effectHandlers
fun foo(h) = h.perform(2)
handle h = Eff with
  fun perform(a)(resume) =
    let f = ()
    set f = n =>
      if n <= 0 then 0
      else n + f(n-1)
    resume(f(10000))
foo(h)
