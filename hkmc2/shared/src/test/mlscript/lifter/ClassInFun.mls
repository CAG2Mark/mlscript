:w
fun f(x, y, z) =
  data class C(a) with
    fun getX = x
    fun getY = y
    fun setY = set y += 1
  class D extends C(y)
  if x is C do print("a") // force C unlifted
  [new C(0), new D]
//│ ═══[WARNING] Cannot yet lift class/module `C` as it is used in an instance check.
//│ ═══[WARNING] Cannot yet lift definition `D` as it extends an unliftable class.

:expect [2, (), 3, 2]
let res = f(1, 2, 3)
let c = res.0
let d = res.1
[c.getY, c.setY, c.getY, d.a]
//│ = [2, (), 3, 2]
//│ c = C(0)
//│ d = D { a: 2 }
//│ res = [C(0), D { a: 2 }]


