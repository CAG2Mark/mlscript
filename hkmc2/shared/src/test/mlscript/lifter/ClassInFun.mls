:lift
:js
:noInline
// :deadParamElim off // used to be `off` because lifter changes the parameter lists and DPE used to look at the original ones

// This test was previously used to demonstrate immutable captures names are not properly discriminated,
// but handler no longer occur before lifting so this now yield the correct result.
:effectHandlers
:expect 3
abstract class Effect with
  fun perform()
handle h = Effect with
  fun perform()(k) = k()
fun f() =
  h.perform()
  1
f() + f() + f()
//│ = 3

:expect 1
fun f(x) =
  class Test() with
    fun get() = x
  Test()
f(1).get()
