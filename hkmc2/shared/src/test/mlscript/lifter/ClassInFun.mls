// [The following comment refers to the old way of compiling such curried classes to JS:]
// In fact, the correct way (using the current "constructor returns a lambda" hack) is this:
// return (params) => {
//   let ret = super(parentMainParams)(parentAuxParams);
//   // ctor
//   return ret;
// }

:sir
fun f(x, y, z) =
  data class C(a) with
    fun getX = x
    fun getY = y
    fun setY = set y += 1
  class D extends C(y)
  [new C(0), new D]
