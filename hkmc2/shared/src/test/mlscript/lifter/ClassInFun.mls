// *** Mutability ***


// * Trivial case
:sir
:noSanityCheck
fun main() =
  class C(val a)
  let c = new mut C(123)
  set c.a = 0
  set c.b = "hi"
  let d = new C(456)
  set d.a = 0
  let e = C(789)
  set e.a = 0
  [c.a, c.b, d.a, e.a]
