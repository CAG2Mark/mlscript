// * The lifted class above should behave the same as the equivalent top-level class below:

let x = id(42)
class C(val a) with
  fun get = x + a
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
