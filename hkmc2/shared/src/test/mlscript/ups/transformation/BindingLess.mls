let ps = Pair("hello", "world")
//│ ps = Pair("hello", "world")

let pi = Pair(1, 2)
//│ pi = Pair(1, 2)

fun foo(p) = if p is IncFst as q then q else p

:expect true
ps == foo(ps)
//│ = true

:expect false
pi == foo(pi)
//│ = false

fun foo(p) = if p is (@compile IncFst) as q then q else p

:expect true
ps == foo(ps)
//│ = true

:expect false
pi == foo(pi)
//│ = false

:expect false
ps is IncFst
//│ = false

:expect true
pi is IncFst
//│ = true

:expect false
ps is @compile IncFst
//│ = false

:expect true
pi is @compile IncFst
//│ = true

pattern ToUppercase =
  | ("a" => "A") | ("b" => "B") | ("c" => "C")
  | ("d" => "D") | ("e" => "E") | ("f" => "F")
  | ("g" => "G") | ("h" => "H") | ("i" => "I") | ("j" => "J")
  | ("k" => "K") | ("l" => "L") | ("m" => "M") | ("n" => "N")
  | ("o" => "O") | ("p" => "P") | ("q" => "Q") | ("r" => "R")
  | ("s" => "S") | ("t" => "T") | ("u" => "U") | ("v" => "V")
  | ("w" => "W") | ("x" => "X") | ("y" => "Y") | ("z" => "Z")
