// The match-site shorthand sub-pattern is matched naively, so its
// diagnostics fire there — exactly once.
:w
:expect "matched"
if Box(0) is @compile Steps(CaptureBit(ZeroToOne)) then "matched" else "no match"
//│ ╔══[WARNING] This extraction argument's transformation result is discarded by pattern `CaptureBit`.
//│ ║  l.448: 	if Box(0) is @compile Steps(CaptureBit(ZeroToOne)) then "matched" else "no match"
//│ ║         	                                       ^^^^^^^^^
//│ ╙── Write `... as _` to discard it explicitly.
//│ = "matched"

// A body-annotated definition is fully machine-compiled, so the discarded
// extraction output is reported eagerly, just like on the other paths. (The
// errors are the pre-existing limitation that efficient compilation does
// not support extraction arguments.)
:e
:w
