// Diagnostics parity: warnings produced by the other compilation paths must
// not be lost — nor duplicated — when a pattern is compiled to a fixed-point
// machine.

open annotations { compile }

data class Box(val value)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
