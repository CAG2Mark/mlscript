//│     defn = ValDefn:
//│       tsym = term:Box⁰/value²
//│       sym = member:value¹
//│       rhs = SimpleRef of value⁰

pattern UnBox = Box(x) => x
pattern Bit = 0 | 1
pattern ZeroToOne = 0 => 1
pattern CaptureBit(value) = Bit as value
