fun makeStepsA(x) = if x is @compile StepsA(y) then y
fun makeStepsB(x) = if x is @compile StepsB(y) then y

let mixed = Box(Tag(Box(42)))
//│ mixed = Box(Tag(Box(42)))

:expect 42
if mixed is StepsA(r) then r else -1
//│ = 42

:expect 42
makeStepsA of mixed
//│ = 42

// The alternation is strict: after a box, a tag must follow, so the second
// box is left alone.
let doubleBox = Box(Box(42))
//│ doubleBox = Box(Box(42))

:expect Box(42)
if doubleBox is StepsA(r) then r else "<no match>"
//│ = Box(42)

:expect Box(42)
makeStepsA of doubleBox
//│ = Box(42)


let tagged = Tag(Box(42))
//│ tagged = Tag(Box(42))

:expect Tag(Box(42))
if tagged is StepsA(r) then r else "no match"
//│ = Tag(Box(42))

:expect Tag(Box(42))
makeStepsA of tagged
//│ = Tag(Box(42))

:expect 42
if tagged is StepsB(r) then r else -1
//│ = 42

:expect 42
makeStepsB of tagged
//│ = 42



// `PeelA` is non-catch-all: after unboxing, a tag must follow (via `PeelB`),
// or — when the value is not a box and so cannot be unboxed — it must be the
// literal `42`. `PeelB` ends in `_`, so after untagging anything goes.
pattern PeelA = UnBox as PeelB | 42
pattern PeelB = UnTag as PeelA | _
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = pattern:PeelA⁰
