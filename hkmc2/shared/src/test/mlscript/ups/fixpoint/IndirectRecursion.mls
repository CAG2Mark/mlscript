// Fixed-point patterns may recurse indirectly through other definitions:
// The semantics is alternation: the steps fire in cycle order
// (`UnBox`, `UnTag`, `UnBox`, ...) and stops when the input is neither.

open annotations { compile }

data class Box(val value)
data class Tag(val value)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Box⁰/value²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Box⁰/value²
//│       sym = member:value¹
//│       rhs = SimpleRef of value⁰

pattern UnBox = Box(x) => x
pattern UnTag = Tag(x) => x
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = pattern:UnBox⁰
//│   sym = member:UnBox¹
//│   k = Pat
//│   methods = Ls of
//│     FunDefn:
//│       sym = member:unapply⁰
//│       dSym = term:unapply¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input⁰
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:transform⁰, tmp:arg$Box$0$⁰, tmp:transformResult⁰, member:lambda⁰}):
//│         body = Define:
//│           defn = FunDefn:
//│             sym = member:lambda⁰
//│             dSym = term:lambda¹
//│             params = Ls of
//│               ParamList:
//│                 params = Ls of
//│                   Param:
//│                     sym = x⁰
//│                     modulefulness = Modulefulness of N
//│             body = Return of SimpleRef of x⁰
//│           rest = Assign: \
//│           lhs = tmp:transform⁰
//│           rhs = MemberRef{disamb=term:lambda¹}:
//│             bms = member:lambda⁰
//│             disamb = term:lambda¹
//│           rest = Match: \
//│           scrut = SimpleRef of input⁰
//│           arms = Ls of
//│             Tuple2:
//│               _1 = Cls:
//│                 cls = class:Box⁰
//│                 path = MemberRef{disamb=class:Box⁰}:
//│                   bms = member:Box¹
//│                   disamb = class:Box⁰
//│               _2 = Assign:
//│                 lhs = tmp:arg$Box$0$⁰
//│                 rhs = Select{sym=term:Box⁰/value²}:
//│                   qual = SimpleRef of input⁰
//│                   name = Ident of "value"
//│                 rest = Assign: \
//│                 lhs = tmp:transformResult⁰
//│                 rhs = Call:
//│                   fun = SimpleRef of tmp:transform⁰
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of tmp:arg$Box$0$⁰
//│                 rest = Return of Instantiate:
//│                   mut = false
//│                   cls = Select{sym=class:MatchSuccess⁰}:
//│                     qual = SimpleRef of tmp:runtime⁰
//│                     name = Ident of "MatchSuccess"
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of tmp:transformResult⁰
//│                       Arg:
//│                         value = Lit of UnitLit of true
//│           dflt = S of Return of Instantiate:
//│             mut = false
//│             cls = Select{sym=class:MatchFailure⁰}:
//│               qual = SimpleRef of tmp:runtime⁰
//│               name = Ident of "MatchFailure"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Lit of UnitLit of true
//│     FunDefn:
//│       sym = member:unapplyStringPrefix⁰
//│       dSym = term:unapplyStringPrefix¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input¹
//│               modulefulness = Modulefulness of N
//│       body = Return of Instantiate:
//│         mut = false
//│         cls = Select{sym=class:MatchFailure⁰}:
//│           qual = SimpleRef of tmp:runtime⁰
//│           name = Ident of "MatchFailure"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of UnitLit of true

pattern StepsA = UnBox as StepsB | _
pattern StepsB = UnTag as StepsA | _
