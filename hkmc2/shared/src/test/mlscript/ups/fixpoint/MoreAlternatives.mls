//│                     qual = SimpleRef of tmp:runtime⁰
//│                     name = Ident of "unreachable"
//│                 _2 = Assign:
//│                   lhs = tmp:emptyString⁰
//│                   rhs = Lit of StrLit of ""
//│                   rest = Assign: \
//│                   lhs = tmp:tmp⁸
//│                   rhs = Tuple:
//│                     mut = false
//│                     elems = Ls of
//│                       Arg:
//│                         value = SimpleRef of input³
//│                       Arg:
//│                         value = SimpleRef of tmp:emptyString⁰
//│                   rest = Return of Instantiate:
//│                     mut = false
//│                     cls = Select{sym=class:MatchSuccess⁰}:
//│                       qual = SimpleRef of tmp:runtime⁰
//│                       name = Ident of "MatchSuccess"
//│                     argss = Ls of
//│                       Ls of
//│                         Arg:
//│                           value = SimpleRef of tmp:tmp⁸
//│                         Arg:
//│                           value = Lit of UnitLit of true
//│             dflt = S of Return of Instantiate:
//│               mut = false
//│               cls = Select{sym=class:MatchFailure⁰}:
//│                 qual = SimpleRef of tmp:runtime⁰
//│                 name = Ident of "MatchFailure"
//│               argss = Ls of
//│                 Ls of
//│                   Arg:
//│                     value = Lit of UnitLit of true

fun peelUntagSlow(x) = if x is PeelUntag(x') then x'
fun peelUntagFast(x) = if x is @compile PeelUntag(x') then x'

// Test: `Tag` in `Box`es.

let boxedTag = Box(Box(Tag(5)))
//│ > new Tag(5)
//│ > new Box(Tag(5))
//│ > new Box(Box(Tag(5)))
//│ boxedTag = Box(Box(Tag(5)))

:expect 5
peelUntagSlow(boxedTag)
//│ = 5

:expect 5
peelUntagFast(boxedTag)
//│ = 5

// Test: No `Tag`.

let boxedNum = Box(Box(7))
//│ > new Box(7)
//│ > new Box(Box(7))
//│ boxedNum = Box(Box(7))

:expect 7
peelUntagSlow(boxedNum)
//│ = 7

:expect 7
peelUntagFast(boxedNum)
//│ = 7

// Test: No `Box`es at all.

:expect 5
if Tag(5) is PeelUntag(r) then r
//│ > new Tag(5)
//│ = 5

:expect 5
peelUntagFast of Tag(5)
//│ > new Tag(5)
//│ = 5

// Test: Interleaved `Tag` and `Box`.

let boxedTaggedBox = Box(Box(Tag(Box(Tag(5)))))
//│ > new Tag(5)
//│ > new Box(Tag(5))
//│ > new Tag(Box(Tag(5)))
//│ > new Box(Tag(Box(Tag(5))))
//│ > new Box(Box(Tag(Box(Tag(5)))))
//│ boxedTaggedBox = Box(Box(Tag(Box(Tag(5)))))

:expect Box(Tag(5))
peelUntagSlow of boxedTaggedBox
//│ = Box(Tag(5))

:expect Box(Tag(5))
peelUntagFast of boxedTaggedBox
//│ = Box(Tag(5))


// ————— Multiple recursive step alternatives —————
//
// A fixed point may list several recursive steps; combined, they are tried
// in order at each iteration. Here both `UnBox` and `UnTag` step, so nested
// boxes and tags are peeled in any order until a bare value remains.

pattern PeelMixed =
  | UnBox as PeelMixed
  | UnTag as PeelMixed
  | _
