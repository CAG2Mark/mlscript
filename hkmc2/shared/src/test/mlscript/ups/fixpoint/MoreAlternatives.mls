:js

// Fixed-point patterns may list extra non-recursive alternatives between the
// self-reference and the trailing wildcard:
//
//   pattern P = Q as P | a | _
//
// reads `(Q as P) | a | _`. The recursive alternative fails exactly when `Q`
// cannot step, so `a` is matched exactly once, against the final normal form:
// if it matches, its output replaces the result; otherwise the wildcard keeps
// the normal form.

open annotations { compile }

data class Box(val value) with
  print("new Box(" + render(value) + ")")
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Box⁰/value²
//│   ctor = Scoped(syms = {tmp:tmp⁰, tmp:tmp¹, tmp:tmp²}):
//│     body = Define:
//│       defn = ValDefn:
//│         tsym = term:Box⁰/value²
//│         sym = member:value¹
//│         rhs = SimpleRef of value⁰
//│       rest = Assign: \
//│       lhs = tmp:tmp⁰
//│       rhs = Call:
//│         fun = Select{sym=term:Predef⁰/render⁰}:
//│           qual = MemberRef{disamb=module:Predef⁰}:
//│             bms = member:Predef¹
//│             disamb = module:Predef⁰
//│           name = Ident of "render"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Box⁰/value²}:
//│                 qual = This of class:Box⁰
//│                 name = Ident of "value"
//│       rest = Assign: \
//│       lhs = tmp:tmp¹
//│       rhs = Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of StrLit of "new Box("
//│             Arg:
//│               value = SimpleRef of tmp:tmp⁰
//│       rest = Assign: \
//│       lhs = tmp:tmp²
//│       rhs = Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = SimpleRef of tmp:tmp¹
//│             Arg:
//│               value = Lit of StrLit of ")"
//│       rest = Assign: \
//│       lhs = ‹no symbol›
//│       rhs = Call:
//│         fun = Select{sym=term:Predef⁰/print⁰}:
//│           qual = MemberRef{disamb=module:Predef⁰}:
//│             bms = member:Predef¹
//│             disamb = module:Predef⁰
//│           name = Ident of "print"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = SimpleRef of tmp:tmp²

