//│   methods = Ls of
//│     FunDefn:
//│       sym = member:unapply⁴
//│       dSym = term:unapply⁵
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input⁴
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:transform¹, tmp:transformResult¹, member:lambda²}):
//│         body = Define:
//│           defn = FunDefn:
//│             sym = member:lambda²
//│             dSym = term:lambda³
//│             params = Ls of
//│               ParamList: ‹empty›
//│             body = Return of Lit of StrLit of "done"
//│           rest = Assign: \
//│           lhs = tmp:transform¹
//│           rhs = MemberRef{disamb=term:lambda³}:
//│             bms = member:lambda²
//│             disamb = term:lambda³
//│           rest = Match: \
//│           scrut = SimpleRef of input⁴
//│           arms = Ls of
//│             Tuple2:
