fun peelSlow(x) = if x is PeelToTag(x') then Some(x') else None

fun peelFast(x) = if x is @compile PeelToTag(x') then Some(x') else None

// The fast path: the normal form matches the alternative directly.
let boxedTag = Box(Box(Tag(5)))
//│ > new Tag(5)
//│ > new Box(Tag(5))
//│ > new Box(Box(Tag(5)))
//│ boxedTag = Box(Box(Tag(5)))

:expect Some(Tag(5))
peelSlow(boxedTag)
//│ = Some(Tag(5))

:expect Some(Tag(5))
peelFast(boxedTag)
//│ = Some(Tag(5))

// Neither the normal form `7` nor any intermediate is a tag: no match.
let boxedNum = Box(Box(7))
//│ > new Box(7)
//│ > new Box(Box(7))
//│ boxedNum = Box(Box(7))

:expect None
peelSlow(boxedNum)
//│ = None

:expect None
peelFast(boxedNum)
//│ = None

fun boxify(gem, depth) =
  let
    wrapped = gem
    remaining = depth
  set shouldPrint = false
  while remaining > 0 do
    set
      wrapped = Box(wrapped)
      remaining -= 1
  set shouldPrint = true
  wrapped

:silent
let excessiveWrapped42 =
  let temp = Tag(42)
  // This will definitely cause stack overflow in most settings.
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  set temp = boxify(temp, 1200)
  temp
//│ > new Tag(42)

// With no step to take, the alternative matches the scrutinee directly:
// `UnBox` cannot peel a bare `Tag`, so `Tag(_)` matches `Tag(5)` as-is.
:re
peelSlow(excessiveWrapped42)
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded

:expect Some(Tag(42))
// Becuase the refocusing machine uses `while` loop, even in simple cases where
// naive matchers don't construct unnecessary objects, the optimized compilation
// is still more efficient.
peelFast(excessiveWrapped42)
//│ = Some(Tag(42))


// ————— Overlapping virtual classes —————

// The Prelude declares the virtual class `Int` as extending `Num`, so the
// overlap check must know that every `Int` is a `Num` without a built-in
// special case. The step turns an integer into a string, on which the trailing
// `Num` alternative fails; the naive translation then backtracks to that
// alternative at the original integer. A machine would forget the original
// and incorrectly report no match, so this definition must fall back to the
// naive translation.

pattern IntToStr = Int => "done"
pattern KeepOriginalInt = IntToStr as KeepOriginalInt | Num
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = pattern:IntToStr⁰
//│   sym = member:IntToStr¹
