:w
:expect Lit(10)
if nested is @compile SumLits(r) then r else "<no match>"
//│ ╔══[WARNING] The recursive context must occur as exactly one direct constructor argument.
//│ ║  l.227: 	pattern TwoHoles(pattern H) = H | Pair(TwoHoles(H), TwoHoles(H))
//│ ║         	        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ║  l.228: 	pattern SumLits = TwoHoles(Pair(Lit(a), Lit(b)) => Lit(a + b)) as SumLits | _
//│ ╙──       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = Lit(10)


// ————— A context grammar without a redex alternative —————
//
// Every alternative of this context descends, so no rewriting step can ever
// fire. A compiled machine would search forever, so the compilation warns
// and falls back to the naive translation; with no step possible, the
// trailing `_` simply keeps the scrutinee.

// This never reduce because it doesn't use `H` at all.
pattern NoRedex(pattern H) =
  | Pair(NoRedex(H), _)
  | Pair(Lit(_), NoRedex(H))
