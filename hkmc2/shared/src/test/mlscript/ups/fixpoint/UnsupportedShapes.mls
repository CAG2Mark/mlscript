// ————— A chain to a pattern that is not part of a cycle —————
//
// `Rest` is an ordinary pattern, so `PeelOnce` is a chain, not a fixed
// point; under `@compile` it falls back to the naive translation.
pattern Rest = Lit(_)
pattern PeelOnce = UnBox as Rest | _
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = pattern:Rest⁰
//│   sym = member:Rest¹
//│   k = Pat
//│   methods = Ls of
//│     FunDefn:
//│       sym = member:unapply²
//│       dSym = term:unapply³
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input²
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:arg$Lit$0$⁰}):
//│         body = Match:
//│           scrut = SimpleRef of input²
//│           arms = Ls of
//│             Tuple2:
//│               _1 = Cls:
//│                 cls = class:Lit⁰
//│                 path = MemberRef{disamb=class:Lit⁰}:
//│                   bms = member:Lit¹
//│                   disamb = class:Lit⁰
//│               _2 = Assign:
//│                 lhs = tmp:arg$Lit$0$⁰
//│                 rhs = Select{sym=term:Lit⁰/value³}:
//│                   qual = SimpleRef of input²
//│                   name = Ident of "value"
//│                 rest = Return of Instantiate:
//│                   mut = false
//│                   cls = Select{sym=class:MatchSuccess⁰}:
//│                     qual = SimpleRef of tmp:runtime⁰
//│                     name = Ident of "MatchSuccess"
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of input²
//│                       Arg:
//│                         value = Lit of UnitLit of true
//│           dflt = S of Return of Instantiate:
//│             mut = false
//│             cls = Select{sym=class:MatchFailure⁰}:
//│               qual = SimpleRef of tmp:runtime⁰
//│               name = Ident of "MatchFailure"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Lit of UnitLit of true
//│     FunDefn:
//│       sym = member:unapplyStringPrefix²
//│       dSym = term:unapplyStringPrefix³
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input³
//│               modulefulness = Modulefulness of N
//│       body = Return of Instantiate:
//│         mut = false
//│         cls = Select{sym=class:MatchFailure⁰}:
//│           qual = SimpleRef of tmp:runtime⁰
//│           name = Ident of "MatchFailure"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of UnitLit of true

:expect Lit(7)
if Box(Lit(7)) is PeelOnce(r) then r else "<no match>"
//│ = Lit(7)

:w
:expect Lit(7)
if Box(Lit(7)) is @compile PeelOnce(r) then r else "<no match>"
//│ ╔══[WARNING] This fixed-point pattern is not supported by pattern compilation.
//│ ║  l.214: 	if Box(Lit(7)) is @compile PeelOnce(r) then r else "<no match>"
//│ ║         	                           ^^^^^^^^^^
//│ ╟── `Rest` does not recurse back, so this pattern applies once rather than repeatedly.
//│ ╙── Falling back to the naive translation.
//│ = Lit(7)


// ————— An unsupported context alternative —————
//
// The recursive context must occur as exactly one direct constructor
// argument, so a two-hole alternative is rejected with a warning.
pattern TwoHoles(pattern H) = H | Pair(TwoHoles(H), TwoHoles(H))
pattern SumLits = TwoHoles(Pair(Lit(a), Lit(b)) => Lit(a + b)) as SumLits | _
