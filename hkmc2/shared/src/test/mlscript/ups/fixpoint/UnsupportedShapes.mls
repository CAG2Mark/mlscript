:js

// Fixed-point-shaped patterns that the machine compilation does not support
// must not be handed to the regular efficient compilation, which cannot
// handle chains at all. Instead, they get a warning and fall back to the
// naive backtracking translation, so `@compile` never changes the meaning
// of a match.

open annotations { compile }

data class Box(val value)
data class Tag(val value)
data class Pair(val first, val second)
data class Lit(val value)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Box⁰/value²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Box⁰/value²
//│       sym = member:value¹
//│       rhs = SimpleRef of value⁰

pattern UnBox = Box(x) => x
pattern UnTag = Tag(x) => x
