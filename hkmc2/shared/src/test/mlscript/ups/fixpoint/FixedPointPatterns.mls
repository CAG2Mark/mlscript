fun add(a, b) =
  let c = a + b
  print("reduce " + a + " + " + b + " = " + c)
  Lit(c)

fun multiply(a, b) =
  let c = a * b
  print("reduce " + a + " + " + b + " = " + c)
  Lit(c)

pattern Redex =
