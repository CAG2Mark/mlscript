fun stepAtLeastOnceSlow(t) = if t is StepPlus(r) then Some(r) else None

fun stepAtLeastOnceFast(t) = if t is @compile StepPlus as r then Some(r) else None

stepAtLeastOnceSlow of Lit(3)
//│ > new Lit(3)
//│ = None

stepAtLeastOnceFast of Lit(3)
//│ > new Lit(3)
//│ = None

stepAtLeastOnceSlow of term3
//│ > reduce 1 + 2 = 3
//│ > new Lit(3)
//│ > new Add(Lit(3), Lit(3))
//│ > new Add(Add(Lit(3), Lit(3)), Lit(4))
//│ > new Add(Add(Add(Lit(3), Lit(3)), Lit(4)), Lit(5))
//│ > reduce 3 + 3 = 6
//│ > new Lit(6)
//│ > new Add(Lit(6), Lit(4))
//│ > new Add(Add(Lit(6), Lit(4)), Lit(5))
//│ > reduce 6 + 4 = 10
//│ > new Lit(10)
//│ > new Add(Lit(10), Lit(5))
//│ > reduce 10 + 5 = 15
//│ > new Lit(15)
//│ = Some(Lit(15))

stepAtLeastOnceFast of term3
//│ > reduce 1 + 2 = 3
//│ > new Lit(3)
//│ > new Add(Lit(3), Lit(3))
//│ > reduce 3 + 3 = 6
//│ > new Lit(6)
//│ > new Add(Lit(6), Lit(4))
//│ > reduce 6 + 4 = 10
//│ > new Lit(10)
//│ > new Add(Lit(10), Lit(5))
//│ > reduce 10 + 5 = 15
//│ > new Lit(15)
//│ = Some(Lit(15))


