//│               value = Lit of StrLit of "new Lit("
//│             Arg:
//│               value = SimpleRef of tmp:tmp³
//│       rest = Assign: \
//│       lhs = tmp:tmp⁵
//│       rhs = Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = SimpleRef of tmp:tmp⁴
//│             Arg:
//│               value = Lit of StrLit of ")"
//│       rest = Assign: \
//│       lhs = ‹no symbol›
//│       rhs = Call:
//│         fun = Select{sym=term:Predef⁰/print⁰}:
//│           qual = MemberRef{disamb=module:Predef⁰}:
//│             bms = member:Predef¹
