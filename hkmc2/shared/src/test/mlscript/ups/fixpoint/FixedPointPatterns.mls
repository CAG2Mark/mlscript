//│               value = Lit of UnitLit of true

pattern Ctx(pattern Hole) =
  | Hole
  | Add(Ctx(Hole), _)
  | Add(Value, Ctx(Hole))
  | Mul(Ctx(Hole), _)
  | Mul(Value, Ctx(Hole))
