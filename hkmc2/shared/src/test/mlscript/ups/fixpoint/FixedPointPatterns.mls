:js

// Fixed-point patterns are patterns that pipe their own output back into
// themselves through a chain, e.g. `pattern Steps = Step as Steps | _`.
// Since `as` binds tighter than `|`, this reads `(Step as Steps) | _`:
// stepping is iterated until it fails, and the trailing `_` keeps the normal
// form — so zero steps simply return the scrutinee unchanged.
//
// Like the rest of efficient pattern compilation, the iterative matcher
// machine (see `ups.FixedPointCompiler`) is opted into with the `@compile`
// pattern annotation — either on the definition's right-hand side, so that
// the generated `unapply` embeds the machine, or at an individual match
// site. The machine does not restart the redex search from the root of the
// scrutinee after each rewriting step.

open annotations { compile }

import "../../../mlscript-compile/Option.mls"

open Option { Some, None }


// ————— A flat fixed point: peeling nested wrappers —————
//
// No object construction in unwrapping only scenarios.

class Wrap(val value) with
  print("Wrapping " + render(value))
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Wrap⁰
//│   sym = member:Wrap¹
//│   ctorSym = S of term:Wrap²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Wrap⁰/value²
//│   ctor = Scoped(syms = {tmp:tmp⁰, tmp:tmp¹}):
//│     body = Define:
//│       defn = ValDefn:
//│         tsym = term:Wrap⁰/value²
//│         sym = member:value¹
//│         rhs = SimpleRef of value⁰
//│       rest = Assign: \
//│       lhs = tmp:tmp⁰
//│       rhs = Call:
//│         fun = Select{sym=term:Predef⁰/render⁰}:
//│           qual = MemberRef{disamb=module:Predef⁰}:
//│             bms = member:Predef¹
//│             disamb = module:Predef⁰
//│           name = Ident of "render"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Select{sym=term:Wrap⁰/value²}:
//│                 qual = This of class:Wrap⁰
//│                 name = Ident of "value"
//│       rest = Assign: \
//│       lhs = tmp:tmp¹
//│       rhs = Call:
//│         fun = SimpleRef of builtin:+⁰
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of StrLit of "Wrapping "
//│             Arg:
//│               value = SimpleRef of tmp:tmp⁰
//│       rest = Assign: \
//│       lhs = ‹no symbol›
//│       rhs = Call:
//│         fun = Select{sym=term:Predef⁰/print⁰}:
//│           qual = MemberRef{disamb=module:Predef⁰}:
//│             bms = member:Predef¹
//│             disamb = module:Predef⁰
//│           name = Ident of "print"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = SimpleRef of tmp:tmp¹

Wrap(100)
//│ > Wrapping 100
//│ = Wrap(100)

pattern Peel = (Wrap(x) => x) as Peel | _
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
