//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Lit⁰
//│   sym = member:Lit¹
//│   ctorSym = S of term:Lit²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value³
//│         sign = S of Resolved{sym=class:Int⁰}:
//│           t = Ref{sym=member:Int¹} of member:Int¹
