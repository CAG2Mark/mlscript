// The proper step adds two literals; the sloppy step gives up on the right
// operand. Both match `Add(Lit(1), Lit(2))`, so the result tells which one
// was prioritized.
pattern ProperStep = Ctx(Add(Lit(a), Lit(b)) => Lit(a + b))
pattern SloppyStep = Ctx(Add(Lit(a), _) => Lit(a))
