// A fixed-point pattern may have several recursive alternatives:
//
//   pattern P = (Q as P) | (R as P) | _
//
// The steps are tried in order at every iteration: an `R` step is taken
// only when no `Q` step applies, and after it, `Q` regains priority. Note
// that unlike the chain shape, the trailing alternatives are disjuncts of
// the whole chains rather than of their tails, so a match with zero steps
// is allowed: the alternatives then process the original scrutinee.

open annotations { compile }

data class Box(val value)
data class Tag(val value)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Box⁰
//│   sym = member:Box¹
//│   ctorSym = S of term:Box²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = value⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:value¹
//│       _2 = term:Box⁰/value²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Box⁰/value²
//│       sym = member:value¹
//│       rhs = SimpleRef of value⁰

pattern UnBox = Box(x) => x
pattern UnTag = Tag(x) => x
