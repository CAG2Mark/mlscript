//│                         value = SimpleRef of tmp:outputPair⁵
//│                       Arg:
//│                         value = Lit of IntLit of 0
//│                 rest = Assign: \
//│                 lhs = tmp:remaining⁵
//│                 rhs = Call:
//│                   fun = Select{sym=term:Tuple⁰/get⁰}:
//│                     qual = Select{sym=module:Tuple⁰}:
//│                       qual = SimpleRef of tmp:runtime⁰
//│                       name = Ident of "Tuple"
//│                     name = Ident of "get"
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of tmp:outputPair⁵
//│                       Arg:
//│                         value = Lit of IntLit of 1
//│                 rest = Assign: \
//│                 lhs = tmp:unapplyResult⁷
//│                 rhs = Call:
//│                   fun = Select:
//│                     qual = MemberRef{disamb=pattern:Steps⁰}:
//│                       bms = member:Steps¹
//│                       disamb = pattern:Steps⁰
//│                     name = Ident of "unapply"
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of tmp:output¹⁶
//│                 rest = Match: \
//│                 scrut = SimpleRef of tmp:unapplyResult⁷
//│                 arms = Ls of
//│                   Tuple2:
//│                     _1 = Cls:
//│                       cls = class:MatchSuccess⁰
//│                       path = Select{sym=class:MatchSuccess⁰}:
//│                         qual = SimpleRef of tmp:runtime⁰
//│                         name = Ident of "MatchSuccess"
//│                     _2 = Assign:
//│                       lhs = tmp:output¹⁷
//│                       rhs = Select{sym=term:MatchSuccess⁰/output⁴}:
//│                         qual = SimpleRef of tmp:unapplyResult⁷
//│                         name = Ident of "output"
//│                       rest = Assign: \
//│                       lhs = tmp:bindings¹⁶
//│                       rhs = Select{sym=term:MatchSuccess⁰/bindings⁴}:
//│                         qual = SimpleRef of tmp:unapplyResult⁷
//│                         name = Ident of "bindings"
//│                       rest = Assign: \
//│                       lhs = tmp:tmp⁶⁶
//│                       rhs = Tuple:
//│                         mut = false
//│                         elems = Ls of
//│                           Arg:
//│                             value = SimpleRef of tmp:output¹⁷
//│                           Arg:
//│                             value = SimpleRef of tmp:remaining⁵
//│                       rest = Return of Instantiate:
//│                         mut = false
//│                         cls = Select{sym=class:MatchSuccess⁰}:
//│                           qual = SimpleRef of tmp:runtime⁰
//│                           name = Ident of "MatchSuccess"
//│                         argss = Ls of
//│                           Ls of
//│                             Arg:
//│                               value = SimpleRef of tmp:tmp⁶⁶
//│                             Arg:
//│                               value = Lit of UnitLit of true
//│                 dflt = S of Match:
//│                   scrut = SimpleRef of input¹³
//│                   arms = Ls of
//│                     Tuple2:
//│                       _1 = Cls:
//│                         cls = class:Str⁰
//│                         path = Select{sym=term:Runtime⁰/unreachable⁰}:
//│                           qual = SimpleRef of tmp:runtime⁰
//│                           name = Ident of "unreachable"
//│                       _2 = Assign:
//│                         lhs = tmp:emptyString⁰
//│                         rhs = Lit of StrLit of ""
//│                         rest = Assign: \
//│                         lhs = tmp:tmp⁶⁷
//│                         rhs = Tuple:
//│                           mut = false
//│                           elems = Ls of
//│                             Arg:
//│                               value = SimpleRef of input¹³
//│                             Arg:
//│                               value = SimpleRef of tmp:emptyString⁰
//│                         rest = Return of Instantiate:
//│                           mut = false
//│                           cls = Select{sym=class:MatchSuccess⁰}:
//│                             qual = SimpleRef of tmp:runtime⁰
//│                             name = Ident of "MatchSuccess"
//│                           argss = Ls of
//│                             Ls of
//│                               Arg:
//│                                 value = SimpleRef of tmp:tmp⁶⁷
//│                               Arg:
//│                                 value = Lit of UnitLit of true
//│                   dflt = S of Return of Instantiate:
//│                     mut = false
//│                     cls = Select{sym=class:MatchFailure⁰}:
//│                       qual = SimpleRef of tmp:runtime⁰
//│                       name = Ident of "MatchFailure"
//│                     argss = Ls of
//│                       Ls of
//│                         Arg:
//│                           value = Lit of UnitLit of true
//│           dflt = S of Match:
//│             scrut = SimpleRef of input¹³
//│             arms = Ls of
//│               Tuple2:
//│                 _1 = Cls:
//│                   cls = class:Str⁰
//│                   path = Select{sym=term:Runtime⁰/unreachable⁰}:
//│                     qual = SimpleRef of tmp:runtime⁰
//│                     name = Ident of "unreachable"
//│                 _2 = Assign:
//│                   lhs = tmp:emptyString⁰
//│                   rhs = Lit of StrLit of ""
//│                   rest = Assign: \
//│                   lhs = tmp:tmp⁶⁸
//│                   rhs = Tuple:
//│                     mut = false
//│                     elems = Ls of
//│                       Arg:
//│                         value = SimpleRef of input¹³
//│                       Arg:
//│                         value = SimpleRef of tmp:emptyString⁰
//│                   rest = Return of Instantiate:
//│                     mut = false
//│                     cls = Select{sym=class:MatchSuccess⁰}:
//│                       qual = SimpleRef of tmp:runtime⁰
//│                       name = Ident of "MatchSuccess"
//│                     argss = Ls of
//│                       Ls of
//│                         Arg:
//│                           value = SimpleRef of tmp:tmp⁶⁸
//│                         Arg:
//│                           value = Lit of UnitLit of true
//│             dflt = S of Return of Instantiate:
//│               mut = false
//│               cls = Select{sym=class:MatchFailure⁰}:
//│                 qual = SimpleRef of tmp:runtime⁰
//│                 name = Ident of "MatchFailure"
//│               argss = Ls of
//│                 Ls of
//│                   Arg:
//│                     value = Lit of UnitLit of true

fun runSlow(ops) = if ops is Steps(result) then result

fun runFast(ops) = if ops is @compile Steps(result) then result

let items = Cons(Item(0), Cons(Item(1), Cons(Item(-1), Nil)))
//│ > new: 0
//│ > new: 1
//│ > new: -1
//│ > new: -1 :: Nil
//│ > new: 1 :: -1 :: Nil
//│ > new: 0 :: 1 :: -1 :: Nil
//│ items = 0 :: 1 :: -1 :: Nil

let pipeline = FilterNonZero(MapInc(items))
//│ > new: map (+ 1) (0 :: 1 :: -1 :: Nil)
//│ > new: filter (!= 0) (map (+ 1) (0 :: 1 :: -1 :: Nil))
//│ pipeline = filter (!= 0) (map (+ 1) (0 :: 1 :: -1 :: Nil))

:expect 1 :: 2 :: Nil
withCounting of () => runSlow(pipeline)
//│ > reduce(MapInc): 0 to 1
//│ > new: 1
//│ > new: map (+ 1) (1 :: -1 :: Nil)
//│ > new: 1 :: map (+ 1) (1 :: -1 :: Nil)
//│ > new: filter (!= 0) (1 :: map (+ 1) (1 :: -1 :: Nil))
//│ > reduce(FilterNonZero): keep 1
//│ > new: 1
//│ > new: filter (!= 0) (map (+ 1) (1 :: -1 :: Nil))
//│ > new: 1 :: filter (!= 0) (map (+ 1) (1 :: -1 :: Nil))
//│ > reduce(MapInc): 1 to 2
//│ > new: 2
//│ > new: map (+ 1) (-1 :: Nil)
//│ > new: 2 :: map (+ 1) (-1 :: Nil)
//│ > new: filter (!= 0) (2 :: map (+ 1) (-1 :: Nil))
//│ > new: 1 :: filter (!= 0) (2 :: map (+ 1) (-1 :: Nil))
//│ > reduce(FilterNonZero): keep 2
//│ > new: 2
//│ > new: filter (!= 0) (map (+ 1) (-1 :: Nil))
//│ > new: 2 :: filter (!= 0) (map (+ 1) (-1 :: Nil))
//│ > new: 1 :: 2 :: filter (!= 0) (map (+ 1) (-1 :: Nil))
//│ > reduce(MapInc): -1 to 0
//│ > new: 0
//│ > new: map (+ 1) (Nil)
//│ > new: 0 :: map (+ 1) (Nil)
//│ > new: filter (!= 0) (0 :: map (+ 1) (Nil))
//│ > new: 2 :: filter (!= 0) (0 :: map (+ 1) (Nil))
//│ > new: 1 :: 2 :: filter (!= 0) (0 :: map (+ 1) (Nil))
//│ > reduce(FilterNonZero): drop 0
//│ > new: filter (!= 0) (map (+ 1) (Nil))
//│ > new: 2 :: filter (!= 0) (map (+ 1) (Nil))
//│ > new: 1 :: 2 :: filter (!= 0) (map (+ 1) (Nil))
//│ > reduce(MapInc): done
//│ > new: filter (!= 0) (Nil)
//│ > new: 2 :: filter (!= 0) (Nil)
//│ > new: 1 :: 2 :: filter (!= 0) (Nil)
//│ > reduce: done
//│ > new: 2 :: Nil
//│ > new: 1 :: 2 :: Nil
//│ > Constructed 30 object(s)
//│ = 1 :: 2 :: Nil

:expect 1 :: 2 :: Nil
// Note that it doesn't build the entire expression.
withCounting of () => runFast(pipeline)
//│ > reduce(MapInc): 0 to 1
//│ > new: 1
//│ > new: map (+ 1) (1 :: -1 :: Nil)
//│ > new: 1 :: map (+ 1) (1 :: -1 :: Nil)
//│ > reduce(MapInc): 1 to 2
//│ > new: 2
//│ > new: map (+ 1) (-1 :: Nil)
//│ > new: 2 :: map (+ 1) (-1 :: Nil)
//│ > reduce(MapInc): -1 to 0
//│ > new: 0
//│ > new: map (+ 1) (Nil)
//│ > new: 0 :: map (+ 1) (Nil)
//│ > reduce(MapInc): done
//│ > new: 0 :: Nil
//│ > new: 2 :: 0 :: Nil
//│ > new: 1 :: 2 :: 0 :: Nil
//│ > new: filter (!= 0) (1 :: 2 :: 0 :: Nil)
//│ > reduce(FilterNonZero): keep 1
//│ > new: 1
//│ > new: filter (!= 0) (2 :: 0 :: Nil)
//│ > new: 1 :: filter (!= 0) (2 :: 0 :: Nil)
//│ > reduce(FilterNonZero): keep 2
//│ > new: 2
//│ > new: filter (!= 0) (0 :: Nil)
//│ > new: 2 :: filter (!= 0) (0 :: Nil)
//│ > reduce(FilterNonZero): drop 0
//│ > new: filter (!= 0) (Nil)
//│ > reduce: done
//│ > new: 2 :: Nil
//│ > new: 1 :: 2 :: Nil
//│ > Constructed 22 object(s)
//│ = 1 :: 2 :: Nil

// An already-normal list contains no stage nodes and cannot take a single
// step, so it matches itself. Plugging preserves identity: popping out of
// the `Cons` frames the machine descended through allocates nothing, because
// nothing below them changed.

items
//│ = 0 :: 1 :: -1 :: Nil

:expect true
withCounting of () => runSlow(items) is items
//│ > Constructed 0 object(s)
//│ = true

:expect true
withCounting of () => runFast(items) is items
//│ > Constructed 0 object(s)
//│ = true
