:js

// Integer list pipelines fused by a fixed-point pattern. `MapInc` and
// `FilterNonZero` stage nodes are pushed into the list until none remain.
//
// Note that the two compilations find redexes in different (both valid)
// orders: the naive matcher restarts from the root after every step, where
// the `Hole` alternative gives outermost redexes priority, so the two
// stages run interleaved; the machine resumes inside the freshly produced
// contractum, so it finishes all `MapInc` steps before popping back up to
// the `FilterNonZero` frame. The rules are confluent, so both reach the
// same normal form — but the machine allocates strictly less along the
// way, because the naive matcher also rebuilds the entire prefix above the
// redex after every step.

import "../../../mlscript-compile/Option.mls"

open annotations { compile }
open Option { Some, None }

// Construction prints make every allocation visible, so unnecessary
// reconstruction of list nodes shows up as extra `new ...` lines.

// Those `toString()` pretty-print nodes into Haskell expressions.

let numObjectConstructed = 0
//│ numObjectConstructed = 0

fun withCounting(f) =
  let before = numObjectConstructed
  let result = f()
  print("Constructed " + (numObjectConstructed - before) + " object(s)")
  result

object Nil
data class Cons(val head, val tail) with
  print("new: " + this.toString())
  set numObjectConstructed += 1
  fun toString() = render(head) + " :: " + tail.toString()
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:Nil⁰
//│   sym = member:Nil¹
//│   k = Obj

data class MapInc(val source) with
  print("new: " + this.toString())
  set numObjectConstructed += 1
  fun toString() = "map (+ 1) (" + source.toString() + ")"
