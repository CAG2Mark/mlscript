//│           lhs = tmp:transform⁰
//│           rhs = MemberRef{disamb=term:lambda¹}:
//│             bms = member:lambda⁰
//│             disamb = term:lambda¹
//│           rest = Match: \
//│           scrut = SimpleRef of input⁰
//│           arms = Ls of
//│             Tuple2:
//│               _1 = Cls:
//│                 cls = class:Pair⁰
//│                 path = MemberRef{disamb=class:Pair⁰}:
//│                   bms = member:Pair¹
//│                   disamb = class:Pair⁰
//│               _2 = Assign:
//│                 lhs = tmp:arg$Pair$0$⁰
//│                 rhs = Select{sym=term:Pair⁰/first²}:
//│                   qual = SimpleRef of input⁰
//│                   name = Ident of "first"
//│                 rest = Assign: \
//│                 lhs = tmp:arg$Pair$1$⁰
//│                 rhs = Select{sym=term:Pair⁰/second²}:
//│                   qual = SimpleRef of input⁰
//│                   name = Ident of "second"
//│                 rest = Assign: \
//│                 lhs = tmp:transformResult⁰
//│                 rhs = Call:
//│                   fun = SimpleRef of tmp:transform⁰
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of tmp:arg$Pair$0$⁰
//│                       Arg:
//│                         value = SimpleRef of tmp:arg$Pair$1$⁰
//│                 rest = Return of Instantiate:
//│                   mut = false
//│                   cls = Select{sym=class:MatchSuccess⁰}:
//│                     qual = SimpleRef of tmp:runtime⁰
//│                     name = Ident of "MatchSuccess"
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of tmp:transformResult⁰
//│                       Arg:
//│                         value = Lit of UnitLit of true
//│           dflt = S of Return of Instantiate:
//│             mut = false
//│             cls = Select{sym=class:MatchFailure⁰}:
//│               qual = SimpleRef of tmp:runtime⁰
//│               name = Ident of "MatchFailure"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Lit of UnitLit of true
//│     FunDefn:
//│       sym = member:unapplyStringPrefix⁰
//│       dSym = term:unapplyStringPrefix¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input¹
//│               modulefulness = Modulefulness of N
//│       body = Return of Instantiate:
//│         mut = false
//│         cls = Select{sym=class:MatchFailure⁰}:
//│           qual = SimpleRef of tmp:runtime⁰
//│           name = Ident of "MatchFailure"
