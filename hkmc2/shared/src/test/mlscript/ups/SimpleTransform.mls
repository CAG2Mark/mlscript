//│       else
//│         return new runtime⁰.MatchFailure⁰(null)
//│     end
//│   }
//│   method unapplyStringPrefix⁰ = fun unapplyStringPrefix¹(input) {
//│     return new runtime⁰.MatchFailure⁰(null)
//│   }
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

fun foo(value) = if value is
  SumPair as sum then print("sum: " + sum)
  else print("not a pair")

foo of Pair(1, 2)
foo of Pair(10, 25)
foo of ()
foo of 10
foo of "hello"
//│ > sum: 3
//│ > sum: 35
//│ > not a pair
//│ > not a pair
//│ > not a pair

