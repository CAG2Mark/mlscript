fun area(shape) = if shape is
  ShapeArea(area) then print("area: " + area)
  else print("invalid shape")

area of radius: 10
area of width: 10, height: 20
area of base: 10, height: 20
//│ > area: 314.1592653589793
//│ > area: 200
//│ > area: 100

