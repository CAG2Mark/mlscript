fun f(x) = if x is
  Bin as b then b
  ~Bin as c then [c]

f(0)
//│ = "false"

f(1)
//│ = "true"

f(2)
//│ = [2]

f([1])
//│ = "true!"

f([[[0]]])
//│ = "false!!!"



let arr = fromArray of [1, 2, 3]
//│ arr = Cons(1, Cons(2, Cons(3, Nil)))


pattern Find(pattern P) =
  | ((P as p) :: t) => [p, t]
  | (h :: (Find(P) as [res, t])) => [res, h :: t]
