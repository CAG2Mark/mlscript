fun action(x) =
  if x is (@compile Itch') as output then
    "Just " + output + "!"
  else
    "I don't know."

action of Some(Some(Some(Some(Some("scratch")))))
//│ = "Just scratch!"

// Test the semantics of biased disjunction.

