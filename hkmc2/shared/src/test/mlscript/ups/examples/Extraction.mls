fun isItch(x) = x is @compile Itch

:expect true
isItch of Some(Some(Some(Some(Some(Some(Some(42)))))))
//│ = true

:expect false
isItch of Some(Some(Some(Some(Some(Some(Some(Some(42))))))))
//│ = false

:expect false
isItch of 42
//│ = false

