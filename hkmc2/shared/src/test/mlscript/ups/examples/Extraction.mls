:noOpt
:checkIR
fun biasedOr2__compiled(x) = if x is (@compile BiasedOr2) as output then output
//│ ═══[INTERNAL ERROR] [BlockChecker] Invalid IR: symbol x⁴ is bound more than once

fun biasedOr2__naive(x) = if x is BiasedOr2(output) then output

