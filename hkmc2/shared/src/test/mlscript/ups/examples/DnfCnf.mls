:js

open annotations

class Formula with
  constructor
    Var(val name: Str)
    Pred(val name: Str, val arg: Formula)
    And(val left: Formula, val right: Formula)
    Or(val left: Formula, val right: Formula)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Formula⁰
