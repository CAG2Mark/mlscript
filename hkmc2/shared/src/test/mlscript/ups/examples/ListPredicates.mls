:js

open annotations

import "../../../mlscript-compile/Stack.mls"
import "../../../mlscript-compile/Iter.mls"

open Stack

fun contains(xs, x) = if xs is
  hd :: tl and { hd === x then true, else tl contains(x) }
  Nil then false

let list1 = 1 :: 2 :: 3 :: Nil
//│ list1 = Cons(1, Cons(2, Cons(3, Nil)))

list1 contains of 3
//│ = true

list1 contains of 4
//│ = false

// Apply a pattern to a list, returns a list of unique elements if the output of
// each element is unique, and rejects the list otherwise.
pattern Unique(pattern P) =
  Nil | (
    ((((P as hd) :: (Unique(P) as tl)) =>
      let there = tl contains(hd)
      [there, if there then tl else hd :: tl]) as [false, list]) => list)
