//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Lit of UnitLit of true

list1 is Unique(_)
//│ = true

:expect false
list1 is Unique((Num as x) => x.toString().length)
//│ = false

fun addProperty(obj, k, v) = (...obj, (k): v)
addProperty of (a: 1), "b", 2
//│ = {a: 1, b: 2}

// A workaround for the above issue.
fun addProperty(obj, k, v) =
  let newObj = Object.fromEntries of [[k, v]]
  (...obj, ...newObj)
addProperty of (a: 1), "b", 2
//│ = {a: 1, b: 2}

// I forgot the syntax of empty object.
fun emptyObject = Object.fromEntries of []

// Convert a list of pairs to a map-like object
pattern ListToObject = (Nil =>  emptyObject) | (([Str as k, v] :: (ListToObject as rest)) => addProperty(rest, k, v))
