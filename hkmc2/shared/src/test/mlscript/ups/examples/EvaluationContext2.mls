// This is an interesting experiment in evaluation context.
// Author: Lionel Parreaux


import "../../../mlscript-compile/Option.mls"

open annotations
open Option { Some, None }


class Ident(val name: Str)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Ident⁰
//│   sym = member:Ident¹
//│   ctorSym = S of term:Ident²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = name⁰
//│         sign = S of Resolved{sym=class:Str⁰}:
//│           t = Ref{sym=member:Str¹} of member:Str¹
//│           sym = class:Str⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:name¹
//│       _2 = term:Ident⁰/name²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Ident⁰/name²
//│       sym = member:name¹
//│       rhs = SimpleRef of name⁰

data class Term with
  constructor
    Lit(value: Int)
    Var(name: Ident)
    App(lhs: Term, rhs: Term)
    Abs(lhs: Ident, rhs: Term)
    Add(lhs: Term, rhs: Term)
  
  // A cached set of free variables
  let _freeVars = None
  
  // Compute free variables. Retrieve the cache if it exists.
  fun freeVars = if _freeVars is
    Some(fv) then fv
    None then
      let fv = if this is
        Var(name) then mkSet of name
        App(lhs, rhs) then lhs.freeVars.union(rhs.freeVars)
        Abs(name, body) then body.freeVars.difference(mkSet of name)
      set _freeVars = Some(fv)
      fv
  
  // Pretty-print the term.
  fun show =
    fun par(t) = if t is
      Lit | Var then t.show
      else "(" + t.show + ")"
    if this is
      Var(id) then id.name
      App(App as lhs, rhs) then lhs.show + par(rhs)
      App(lhs, rhs) then par(lhs) + " " + par(rhs)
      Abs(id, body) then "λ" + id.name + ". " + body.show
      Lit(value) then value.toString()
      Add(Add as lhs, rhs) then lhs.show + " + " + par(rhs)
      Add(lhs, rhs) then par(lhs) + " + " + par(rhs)
