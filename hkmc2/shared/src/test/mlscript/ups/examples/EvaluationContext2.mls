module CBV with
  
  pattern Ctx(pattern Hole) =
    | Hole
    | Add(Ctx(Hole), _)
    | Add(Value, Ctx(Hole))
    | App(Value, Ctx(Hole))
    | App(Ctx(Hole), _)
  
  pattern Redex =
    | Add(Lit(v1), Lit(v2)) => Lit(v1 + v2)
    | App(Abs(id, body), Value as arg) => body.subst(id, arg)
  
  pattern Step = Ctx(Redex)
  
  pattern Steps = Step as Steps | _
