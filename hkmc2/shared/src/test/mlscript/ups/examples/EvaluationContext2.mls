fun eval(term) =
  print("Evaluating:", term.show)
  if term is
    CBV.Step(next) then eval(next)
    Value then print("Done.")
    else print("Stuck!")

:silent
let
  a = Var(Ident("a"))
  b = Var(Ident("b"))
  x = Lit(2)
  y = Lit(3)
  z = Lit(4)
  t = Add(Add(x, y), z)

eval(t)
//│ > Evaluating: 2 + 3 + 4
//│ > Evaluating: 5 + 4
//│ > Evaluating: 9
//│ > Done.

eval(Add(t, t))
//│ > Evaluating: 2 + 3 + 4 + (2 + 3 + 4)
//│ > Evaluating: 5 + 4 + (2 + 3 + 4)
//│ > Evaluating: 9 + (2 + 3 + 4)
//│ > Evaluating: 9 + (5 + 4)
//│ > Evaluating: 9 + 9
//│ > Evaluating: 18
//│ > Done.

eval(Add(t, a))
//│ > Evaluating: 2 + 3 + 4 + a
//│ > Evaluating: 5 + 4 + a
//│ > Evaluating: 9 + a
//│ > Stuck!

assert Add(t, t) is CBV.Steps(res), res
//│ = Lit(18)

assert Lit(0) is CBV.Steps(res), res
//│ = Lit(0)


CBV.Step.unapply(x)
//│ = MatchFailure(null)

CBV.Step.unapply(t)
//│ = MatchSuccess(Add(Lit(5), Lit(4)), null)

eval(x)
//│ > Evaluating: 2
//│ > Done.


