fun isDoubleOrSum__naive(xs) = if xs is DoubleOrSum as output then output else "noop"

isDoubleOrSum__naive of _1234
//│ = Cons(1, Cons(2, Cons(3, Cons(4, Nil))))

isDoubleOrSum__naive of list(1, 2, 3)
//│ > 3 + 0 = 3
//│ > 2 + 3 = 5
//│ > 1 + 5 = 6
//│ = 6

fun isDoubleOrSum__compiled(xs) = if xs is (@compile DoubleOrSum) as output then output else "noop"

isDoubleOrSum__compiled of _1234
//│ > 4 + 0 = 4
//│ > 3 + 4 = 7
//│ > 2 + 7 = 9
//│ = Cons(1, Cons(2, Cons(3, Cons(4, Nil))))

isDoubleOrSum__compiled of _1234567
//│ > 7 + 0 = 7
//│ > 6 + 7 = 13
//│ > 5 + 13 = 18
//│ > 4 + 18 = 22
//│ > 3 + 22 = 25
//│ > 2 + 25 = 27
//│ > 1 + 27 = 28
