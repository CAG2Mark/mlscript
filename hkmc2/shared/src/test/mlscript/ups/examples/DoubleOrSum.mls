//│ > 5 + 13 = 18
//│ > 4 + 18 = 22
//│ > 3 + 22 = 25
//│ > 2 + 25 = 27
//│ > 1 + 27 = 28
//│ = 28

isSumOrDouble__compiled of Nil
//│ = 0

