:js

open annotations

import "../../../mlscript-compile/Stack.mls"
import "../../../mlscript-compile/Iter.mls"
import "../../../mlscript-compile/Option.mls"

open Stack
open Option { Some, None }

fun list(...elements) = elements Iter.toStack()

// This is a helper function to print the addition of two numbers.
fun (++) addWithPrint(x, y) =
  let result = x + y
  print of "" + x + " + " + y + " = " + result
  result

