:js

pattern NonZero = ~0
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = pattern:NonZero⁰
//│   sym = member:NonZero¹
//│   k = Pat
//│   methods = Ls of
//│     FunDefn:
//│       sym = member:unapply⁰
//│       dSym = term:unapply¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input⁰
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:output⁰}):
//│         body = Match:
//│           scrut = SimpleRef of input⁰
//│           arms = Ls of
//│             Tuple2:
//│               _1 = Lit of IntLit of 0
//│               _2 = Return of Instantiate:
//│                 mut = false
//│                 cls = Select{sym=class:MatchFailure⁰}:
//│                   qual = SimpleRef of tmp:runtime⁰
//│                   name = Ident of "MatchFailure"
//│                 argss = Ls of
//│                   Ls of
//│                     Arg:
//│                       value = Lit of UnitLit of true
//│           dflt = S of Assign:
//│             lhs = tmp:output⁰
//│             rhs = SimpleRef of input⁰
//│             rest = Return of Instantiate:
//│               mut = false
//│               cls = Select{sym=class:MatchSuccess⁰}:
//│                 qual = SimpleRef of tmp:runtime⁰
//│                 name = Ident of "MatchSuccess"
//│               argss = Ls of
//│                 Ls of
//│                   Arg:
//│                     value = SimpleRef of tmp:output⁰
//│                   Arg:
//│                     value = Lit of UnitLit of true
//│     FunDefn:
//│       sym = member:unapplyStringPrefix⁰
//│       dSym = term:unapplyStringPrefix¹
//│       params = Ls of
//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input¹
//│               modulefulness = Modulefulness of N
//│       body = Return of Instantiate:
//│         mut = false
//│         cls = Select{sym=class:MatchFailure⁰}:
//│           qual = SimpleRef of tmp:runtime⁰
//│           name = Ident of "MatchFailure"
//│         argss = Ls of
//│           Ls of
//│             Arg:
//│               value = Lit of UnitLit of true

0 is NonZero
//│ = false

1 is NonZero
//│ = true

-1 is NonZero
//│ = true

