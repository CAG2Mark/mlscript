data class Expr with
  constructor
    Id(name: Str)
    Op(lhs: Expr, op: Str, rhs: Expr)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Expr⁰
//│   sym = member:Expr¹
//│   k = Cls


pattern Parse =
  | ((Ident as name) :: rest)                     => Id(name) :: rest
  | ((Expr as e1) :: "+" :: (Expr as e2) :: rest) => Op(e1, "+", e2) :: rest
  | ((Expr as e1) :: "+" :: (Parse as rest))      => e1 :: "+" :: rest
  | ("(" :: (Expr as e) :: ")" :: rest)           => e :: rest
  | ("(" :: (Parse as rest))                      => "(" :: rest
