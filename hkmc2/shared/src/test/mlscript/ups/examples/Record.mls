//│                                 name = Ident of "Str"
//│                               name = Ident of "leave"
//│                             argss = Ls of
//│                               Ls of
//│                                 Arg:
//│                                   value = SimpleRef of tmp:remains⁴
//│                                 Arg:
//│                                   value = Lit of IntLit of 1
//│                           rest = Match: \
//│                           scrut = SimpleRef of tmp:remains⁵
//│                           arms = Ls of
//│                             Tuple2:
//│                               _1 = Cls:
//│                                 cls = class:Str⁰
//│                                 path = Select{sym=term:Runtime⁰/unreachable⁰}:
//│                                   qual = SimpleRef of tmp:runtime⁰
//│                                   name = Ident of "unreachable"
//│                               _2 = Assign:
//│                                 lhs = tmp:emptyString¹
//│                                 rhs = Lit of StrLit of ""
//│                                 rest = Assign: \
//│                                 lhs = tmp:transformResult¹⁵
//│                                 rhs = Call:
//│                                   fun = SimpleRef of tmp:transform¹³
//│                                   argss = Ls of
//│                                     Ls of
//│                                       Arg:
//│                                         value = SimpleRef of tmp:remains⁵
//│                                       Arg:
//│                                         value = SimpleRef of tmp:consumed⁵
//│                                 rest = Assign: \
//│                                 lhs = tmp:tmp¹³
//│                                 rhs = Tuple:
//│                                   mut = false
//│                                   elems = Ls of
//│                                     Arg:
//│                                       value = SimpleRef of tmp:transformResult¹⁵
//│                                     Arg:
//│                                       value = SimpleRef of tmp:emptyString¹
//│                                 rest = Return of Instantiate:
//│                                   mut = false
//│                                   cls = Select{sym=class:MatchSuccess⁰}:
//│                                     qual = SimpleRef of tmp:runtime⁰
//│                                     name = Ident of "MatchSuccess"
//│                                   argss = Ls of
//│                                     Ls of
//│                                       Arg:
//│                                         value = SimpleRef of tmp:tmp¹³
//│                                       Arg:
//│                                         value = Lit of UnitLit of true
//│                           dflt = S of Return of Instantiate:
//│                             mut = false
//│                             cls = Select{sym=class:MatchFailure⁰}:
//│                               qual = SimpleRef of tmp:runtime⁰
//│                               name = Ident of "MatchFailure"
//│                             argss = Ls of
//│                               Ls of
//│                                 Arg:
//│                                   value = Lit of UnitLit of true
//│                     dflt = S of Return of Instantiate:
//│                       mut = false
//│                       cls = Select{sym=class:MatchFailure⁰}:
//│                         qual = SimpleRef of tmp:runtime⁰
//│                         name = Ident of "MatchFailure"
//│                       argss = Ls of
//│                         Ls of
//│                           Arg:
//│                             value = Lit of UnitLit of true
//│           dflt = S of Return of Instantiate:
//│             mut = false
//│             cls = Select{sym=class:MatchFailure⁰}:
//│               qual = SimpleRef of tmp:runtime⁰
//│               name = Ident of "MatchFailure"
//│             argss = Ls of
//│               Ls of
//│                 Arg:
//│                   value = Lit of UnitLit of true

fun parseIntegerLiteral(value) = if
  value is IntegerLiteral as output then Some(output)
  else None

parseIntegerLiteral of "0x1234"
//│ = Some({radix: "x", digits: "1234"})

parseIntegerLiteral of "0b0000111100001111"
//│ = Some({radix: "b", digits: "0000111100001111"})

parseIntegerLiteral of "0o673264673"
//│ = Some({radix: "o", digits: "673264673"})

parseIntegerLiteral of "0k1234"
//│ = None
