:expect Some(23)
bmi of weight: 70, height: 1.75
//│ = Some(23)

bmi of height: 1.75
//│ = None

:todo // Make it happen!
fun bmi'(record) = if record is (@compile MatchOrNone(RoundedBMI)) as value then value
