fun max(ow, v) = if ow is
  Some(w) and w > v then w
  else v

fun min(ow, v) = if ow is
  Some(w) and w < v then w
  else v

// Extract the maximum value from a binary tree
pattern TreeMax =
  | Leaf => None
  | Node(x, TreeMax as left, TreeMax as right) => max(max(left, x), right)
pattern TreeMin =
  | Leaf => None
  | Node(x, TreeMin as left, TreeMin as right) => min(min(left, x), right)
