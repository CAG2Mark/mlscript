// Extract the path from root to a target value in a binary tree
pattern PathToValue(pattern Target) = 
  | Leaf => []
  | Node(PathToValue(Target) as left, Target, _) => [0] ::: left
  | Node(_, Target, PathToValue(Target) as right) => [1] ::: right
  | Node(PathToValue(Target) as left, _, _) => [0] ::: left
  | Node(_, _, PathToValue(Target) as right) => [1] ::: right
