//│                       Arg:
//│                         value = SimpleRef of tmp:tmp⁰
//│                       Arg:
//│                         value = Lit of UnitLit of true
//│           dflt = S of Assign:
//│             lhs = tmp:isLeading⁰
//│             rhs = Call:
//│               fun = Select{sym=term:Str¹/startsWith⁰}:
//│                 qual = Select{sym=module:Str¹}:
//│                   qual = SimpleRef of tmp:runtime⁰
//│                   name = Ident of "Str"
//│                 name = Ident of "startsWith"
