//│                       Ls of
//│                         Arg:
//│                           value = SimpleRef of input¹
//│                         Arg:
//│                           value = Lit of IntLit of 1
//│                   rest = Assign: \
//│                   lhs = tmp:remains⁰
//│                   rhs = Call:
//│                     fun = Select{sym=term:Str¹/leave⁰}:
