//│                       Ls of
//│                         Arg:
//│                           value = SimpleRef of tmp:tmp¹
//│                         Arg:
//│                           value = Lit of UnitLit of true
//│             dflt = S of Return of Instantiate:
//│               mut = false
//│               cls = Select{sym=class:MatchFailure⁰}:
//│                 qual = SimpleRef of tmp:runtime⁰
//│                 name = Ident of "MatchFailure"
//│               argss = Ls of
//│                 Ls of
//│                   Arg:
//│                     value = Lit of UnitLit of true

fun anything(x) = x is @compile WildcardOr

:expect true
anything("a")
//│ = true

:expect true
anything("b")
//│ = true

:expect true
anything(42)
//│ = true

:expect true
42 is WildcardOr
//│ = true


// An empty range — here from reversed bounds — matches nothing, on the
// compiled path and the plain one alike.

fun emptyIntRange(x) = x is @compile (5 ..= 3)

:expect false
emptyIntRange(4)
//│ = false

:expect false
emptyIntRange("q")
//│ = false

:expect false
4 is (5 ..= 3)
//│ = false

fun emptyStrRange(x) = x is @compile ("z" ..= "a")

:expect false
emptyStrRange("q")
//│ = false

:expect false
emptyStrRange("z")
//│ = false

:expect false
"q" is ("z" ..= "a")
//│ = false
