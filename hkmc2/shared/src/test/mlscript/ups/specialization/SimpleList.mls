//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = a⁰
//│         sign = S of Ref{sym=A⁰} of A⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = b⁰
//│         sign = S of Ref{sym=B⁰} of B⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:a¹
//│       _2 = term:Pair⁰/a²
