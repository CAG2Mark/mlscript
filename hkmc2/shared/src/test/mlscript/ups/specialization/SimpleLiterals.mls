print of Some("0") is Some(@compile ZeroLogged)
//│ > true

if Some("0") is Some((@compile ZeroLogged) as zero) then
  print("nested zero: " + zero)
//│ > zero 0
//│ > nested zero: 0

fun checkSomeZeroOneTwo(x) = if x is
  Some(@compile Zero) then 0
  Some(@compile One) then 1
  Some(@compile Two) then 2
  else ()

