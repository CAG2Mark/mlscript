let emails = [
  "example@example.com"
  "john.doe@guardian.co.uk"
  "alice_bob123@sub-domain.example.org"
  "user+mailbox@my-domain.net"
  "test.user%filter@service-provider.co.in"
  "foo-bar@company-name.io"
  "simple123@abc.xyz"
]

emails
  Iter.mapping of _ is Email
  Iter.folded of true, _ && _
