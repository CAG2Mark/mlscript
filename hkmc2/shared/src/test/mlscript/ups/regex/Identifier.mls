fun isDigit(x) = x is @compile Digit

check of isDigit, "digit"
//│ > 0 is digit
//│ > 1 is digit
//│ > 2 is digit
//│ > 3 is digit
//│ > 4 is digit
//│ > 5 is digit
//│ > 6 is digit
//│ > 7 is digit
//│ > 8 is digit
//│ > 9 is digit

