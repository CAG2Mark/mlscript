//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:And⁰/lhs²
//│       sym = member:lhs¹
//│       rhs = SimpleRef of lhs⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:And⁰/rhs²
//│       sym = member:rhs¹
//│       rhs = SimpleRef of rhs⁰

pattern Truthy =
  true | And(Truthy, Truthy) | Or(Truthy, Truthy) |
    Or(Truthy, Falsy) | Or(Falsy, Truthy) | Not(Falsy)
pattern Falsy =
  false | And(Falsy, Falsy) | And(Falsy, Truthy) |
    And(Truthy, Falsy) | Or(Falsy, Falsy) | Not(Truthy)
