:js

open annotations { compile }

data class Pair[S, T](val first: S, val second: T)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = class:Pair⁰
//│   sym = member:Pair¹
//│   ctorSym = S of term:Pair²
//│   k = Cls
//│   paramsOpt = S of ParamList:
//│     params = Ls of
//│       Param:
//│         flags = (val)
//│         sym = first⁰
//│         sign = S of Ref{sym=S⁰} of S⁰
//│         modulefulness = Modulefulness of N
//│       Param:
//│         flags = (val)
//│         sym = second⁰
//│         sign = S of Ref{sym=T⁰} of T⁰
//│         modulefulness = Modulefulness of N
//│   publicFields = Ls of
//│     Tuple2:
//│       _1 = member:first¹
//│       _2 = term:Pair⁰/first²
//│     Tuple2:
//│       _1 = member:second¹
//│       _2 = term:Pair⁰/second²
//│   ctor = Define:
//│     defn = ValDefn:
//│       tsym = term:Pair⁰/first²
//│       sym = member:first¹
//│       rhs = SimpleRef of first⁰
//│     rest = Define: \
//│     defn = ValDefn:
//│       tsym = term:Pair⁰/second²
//│       sym = member:second¹
//│       rhs = SimpleRef of second⁰

object A
object B
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
//│   isym = object:A⁰
//│   sym = member:A¹
//│   k = Obj

// The patterns generate exactly those trees whose leftmost leaf is labeled `A`
// and whose rightmost leaf is labeled `B`.

pattern LaRbTree = Pair(LaTree, RbTree)
pattern LaTree = A | Pair(A, AnyTree)
pattern RbTree = B | Pair(AnyTree, B)
pattern AnyTree = A | B | Pair(AnyTree, AnyTree)
//│ /!\ Warning: object identity between equal objects was not preserved by HandlerLowering
//│ /!\ Offending: ClsLikeDefn:
