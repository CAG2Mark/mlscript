//│         ParamList:
//│           params = Ls of
//│             Param:
//│               sym = input⁰
//│               modulefulness = Modulefulness of N
//│       body = Scoped(syms = {tmp:arg$Pair$0$⁰, tmp:arg$Pair$1$⁰, tmp:unapplyResult⁰, tmp:output⁰, tmp:bindings⁰, tmp:unapplyResult¹, tmp:output¹, tmp:bindings¹}):
