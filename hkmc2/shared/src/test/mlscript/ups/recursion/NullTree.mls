0 ## 1
//│ = Pair(0, 1)

// Positive Test Cases
// ===================

:global
:expect true

null is @compile Tree
//│ = true

null ## null is @compile Tree
//│ = true

((null ## null) ## null) is @compile Tree
//│ = true

null ## (null ## null) is @compile Tree
//│ = true

((null ## null) ## (null ## null)) is @compile Tree
//│ = true

// Negative Test Cases
// ===================

:global
:expect false

0 is @compile Tree
//│ = false

0 ## 0 is @compile Tree
//│ = false

0 ## null is @compile Tree
//│ = false

null ## 0 is @compile Tree
//│ = false
