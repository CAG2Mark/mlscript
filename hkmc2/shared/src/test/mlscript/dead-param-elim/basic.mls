// FIXME: Currently, Runtime⁰.Tuple¹.get¹ below resolves differently from runtime⁰.Tuple⁰.get⁰ above
//  This is because the latter is currently created in Elaborator's `createFunSymbolInMod` shim.
:lift
:sir
:effectHandlers
:stackSafe 100
import "../../mlscript-compile/Runtime.mls"
fun f(c) = Runtime.Tuple.get(c, 1) + 1
