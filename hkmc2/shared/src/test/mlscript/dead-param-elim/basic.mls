//│   let x, y, z, lastElement1$, lastElement2$, middleElements;
//│   match caseScrut
//│     Array(2+) =>
//│       set middleElements = runtime⁰.Tuple⁰.slice⁰(caseScrut, 0, 2);
//│       set lastElement2$ = runtime⁰.Tuple⁰.get²(caseScrut, -2);
//│       set lastElement1$ = runtime⁰.Tuple⁰.get²(caseScrut, -1);
//│       set y = lastElement1$;
//│       set z = lastElement2$;
//│       set x = middleElements;
//│       return x
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ define f²³ as fun f²⁴() { return lambda⁰ };
