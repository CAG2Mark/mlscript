import "./RuntimeJS.mjs"
import "./Rendering.mjs"
import "./LazyArray.mjs"
import "./Iter.mjs"

open annotations { mayNotRaiseEffects }


module Runtime with ...


object Unit with
  fun toString() = "()"

// This object is used as a marker for non-local label continues.
object Continue

// This object is used as a marker for the end of a while loop in the compiled codegen.
// It is possible for the loop body to contain a return statement,
// in which case we want to distinguish between returning from the loop body and loop termination.
object LoopEnd
val short_and = RuntimeJS.short_and
val short_or = RuntimeJS.short_or


fun unreachable = throw Error("unreachable")

fun assertFail(file, line) = throw Error("Assertion failed (" + file + ":" + line + ")")


fun checkArgs(functionName, expected, isUB, got) =
  if got < expected || isUB && got > expected do
    let name = if functionName.length > 0 then " '" + functionName + "'" else ""
    // throw globalThis.Error("Function" + name + " expected "
    //   + (if isUB then "" else "at least ")
    //   + expected
    //   + " argument(s) but got " + got)
    throw Error of "Function" + name + " expected "
      + (if isUB then "" else "at least " )
      + expected + " argument"
      + (if expected === 1 then "" else "s")
      + " but got " + got

fun checkSelect(sel, nme, qual) =
  if sel === undefined then
    throw Error("Access to required field '" + nme + "' yielded 'undefined'")
  else
    qual.(nme + "$__checkNotMethod")
    sel

fun safeCall(x) =
  if x is undefined then () else x

fun checkCall(x) =
  if x is undefined
  then throw Error("MLscript call unexpectedly returned `undefined`, the forbidden value.")
  else x

fun deboundMethod(mtdName, clsName) =
  throw Error of
    "[debinding error] Method '" + mtdName + "' of class '" + clsName + "' was accessed without being called."


val bitand = RuntimeJS.bitand
val bitnot = RuntimeJS.bitnot
val bitor = RuntimeJS.bitor
val shl = RuntimeJS.shl
val try_catch = RuntimeJS.try_catch

class EffectHandle(_reified) with
  val reified = _reified
  fun resumeWith(value) =
    _try(() => resume(reified.contTrace)(value))
  fun raise() =
    set curEffect = reified

fun _try(f) =
  let res = f()
  if curEffect !== null then
    let tmp = curEffect
    set curEffect = null
    EffectHandle(tmp)
  else res


// For `pattern` definitions
data class MatchSuccess(output, bindings)
data class MatchFailure(errors)

// For pattern matching on tuples
module Tuple with
  
  @mayNotRaiseEffects
  fun slice(xs, i, j) = xs.slice(i, xs.length - j)
  
  @mayNotRaiseEffects
  fun lazySlice(xs, i, j) = LazyArray.dropLeftRight(i, j)(xs)
  @mayNotRaiseEffects
  fun lazyConcat(...args) = LazyArray.__concat(...args)
  
  @mayNotRaiseEffects
  fun get(xs, i) =
    if i >= xs.length do
      throw RangeError("Tuple.get: index out of bounds")
    if i < -xs.length do
      throw RangeError("Tuple.get: negative index out of bounds")
    xs.[i]
  
  @mayNotRaiseEffects
  fun isArrayLike(xs) = Iter.isArrayLike(xs)
  val split = LazyArray.__split

module Str with
  
  @mayNotRaiseEffects
  fun startsWith(string, prefix) = string.startsWith(prefix)
  
  @mayNotRaiseEffects
  fun get(string, i) =
    if i >= string.length then
      throw RangeError("Str.get: index out of bounds")
    else string.at(i)
  
  @mayNotRaiseEffects
  fun take(string, n) = string.slice(0, n)
  
  @mayNotRaiseEffects
  fun leave(string, n) = string.slice(n)

// Re-export rendering functions
val render = Rendering.render

fun printRaw(x) = console.log(render(x, indent: 2, breakLength: 76))

// TraceLogger

module TraceLogger with
  mut val enabled = false
  mut val indentLvl = 0
  fun indent() =
    if enabled then
      let prev = indentLvl
      set indentLvl = prev + 1
      prev
    else ()
  fun resetIndent(n) =
    if enabled then
      set indentLvl = n
    else ()
  fun log(msg) =
    if enabled then
      console.log("| ".repeat(indentLvl) + msg.replaceAll("\n", "\n" + "  ".repeat(indentLvl)))
    else ()

// Private definitions for algebraic effects

data class ContTrace(next, last, nextHandler, lastHandler, resumed)

mut val curContTrace = new mut ContTrace(null, null, null, null, false)
mut val curEffect = null
mut val resumeValue = null
mut val resumeArr = null
mut val resumeIdx = null
mut val resumePc = -1

fun makeNewContTrace() =
  set curContTrace = new mut ContTrace(null, null, null, null, false)
  set
    curContTrace.last = curContTrace
    curContTrace.lastHandler = curContTrace

set
  curContTrace.last = curContTrace
  curContTrace.lastHandler = curContTrace

object FatalEffect
object PrintStackEffect

let fcfid = 0
data class FunctionContFrame(next, fn, varsClass) with
  val id = fcfid
  set fcfid += 1
  fun resume(value) =
    set resumeValue = value
    fn(varsClass)
  fun getLocals = ()
  fun getNme = ""
  fun getLoc = ""

data class HandlerContFrame(next, nextHandler, handler)

data class EffectSig(contTrace, handler, handlerFun, id)

class NonLocalReturn with
  fun ret(value)

data class FnLocalsInfo(fnName, locals)
data class LocalVarInfo(localName, value)
data class CustomStackError(stack) with
  fun toString() = stack


fun resetEffects() =
  set
    curEffect = null
    resumePc = -1

fun raisePrintStackEffect(showLocals) =
  mkEffect(PrintStackEffect, showLocals)

fun topLevelTrampoline(limit, body) =
  makeNewContTrace()
  if limit !== undefined then
    set curEffect = null
    set stackLimit = limit in...
    set stackDepth = 1 in...
    set stackHandler = StackDelayHandler in...
    let result = 
      RuntimeJS.try_catch(() => enterHandleBlock(StackDelayHandler, body), (err) =>
        checkUnhandledErr(err)
        handleEffects(curEffect)
      )
    while stackResume !== null do
      let saved = stackResume
      set
        stackResume = null
        stackDepth = 1
        result = RuntimeJS.try_catch(saved, checkUnhandledErr)
      if curEffect !== null do
        set result = handleEffects(curEffect)
    result
  else
    RuntimeJS.try_catch(body, (err) =>
      checkUnhandledErr(err)
      handleEffects(curEffect)
    )

fun topLevelEffect(debug) =
  let tr = curEffect
  let v = null
  while tr is EffectSig and tr.handler === PrintStackEffect do
    console.log(showStackTrace("Stack Trace:", tr, debug, tr.handlerFun))
    set
      curEffect = null
      v = resume(tr.contTrace)(())
      tr = curEffect
  if tr is EffectSig then
    set curEffect = null
    throw CustomStackError(showStackTrace("Error: Unhandled effect " + tr.handler.constructor.name, tr, debug, false))
  else
    v

fun illegalEffect(position) =
  let tmp = curEffect
  set curEffect = null
  throw CustomStackError(showStackTrace("Error: Effect " + tmp.handler.constructor.name + " is raised " + position, tmp, false, false))

fun showStackTrace(header, tr, debug, showLocals) =
  let
    msg = header
    curHandler = tr.contTrace
    atTail = true
  if debug do
    while curHandler !== null do
      let cur = curHandler.next
      while cur !== null do
        let curLocals = cur.getLocals
        let loc = cur.getLoc
        let localsMsg = if showLocals and curLocals.length > 0
          then " with locals: " + curLocals.map(l => l.localName + "=" + Rendering.render(l.value)).join(", ")
          else ""
        set
          msg += "\n\tat " + cur.getNme + " (" + loc + ")"
          msg += localsMsg
          cur = cur.next
          atTail = false
      set curHandler = curHandler.nextHandler
      if curHandler !== null do
        set
          msg += "\n\twith handler " + curHandler.handler.constructor.name
          atTail = false
    if atTail do
      set msg += "\n\tat tail position"
  msg

fun showFunctionContChain(cont, hl, vis, reps) =
  if cont is FunctionContFrame then
    let result = cont.constructor.name + "(" + cont.fn.name + ", pc=" + cont.varsClass.[0] + ", id=" + cont.id
    hl.forEach((m, marker) => if m.has(cont) do set result += ", " + marker)
    if vis.has(cont) then
      set reps = reps + 1
      if reps > 10 do
        throw Error("10 repeated continuation frame (loop?)")
      set result += ", REPEAT"
    else
      vis.add(cont)
    result + ") -> " + showFunctionContChain(cont.next, hl, vis, reps)
  else if cont === null then
    "(null)"
  else
    "(NOT CONT)"

fun showHandlerContChain(cont, hl, vis, reps) =
  if cont is HandlerContFrame then
    let result = cont.handler.constructor.name
    // hl.forEach((m, marker) => if m.has(cont) do set result += ", " + marker)
    if vis.has(cont) then
      set reps = reps + 1
      if reps > 10 do
        throw Error("10 repeated continuation frame (loop?)")
      set result += ", REPEAT"
    else
      vis.add(cont)
    result + " -> " + showFunctionContChain(cont.next, hl, vis, reps)
  else if cont === null then
    "(null)"
  else
    "(NOT HANDLER CONT)"

fun debugCont(cont) = myDebug(showFunctionContChain(cont, new Map(), new Set(), 0))
fun debugHandler(cont) = myDebug(showHandlerContChain(cont, new Map(), new Set(), 0))

fun debugContTrace(contTrace) =
  if contTrace is ContTrace then
    console.log("resumed: ", contTrace.resumed)
    if contTrace.last === contTrace do
      console.log("<last is self>")
    if contTrace.lastHandler === contTrace do
      console.log("<lastHandler is self>")
    let vis = new Set()
    let hl = new Map()
    hl.set("last", new Set([contTrace.last]))
    hl.set("last-handler", new Set([contTrace.lastHandler]))
    console.log("ContTrace -> " + showFunctionContChain(contTrace.next, hl, vis, 0))
    let cur = contTrace.nextHandler
    while cur !== null do
      console.log("v")
      console.log(showHandlerContChain(cur, hl, vis, 0))
      set cur = cur.nextHandler
    console.log()
  else
    console.log("Not a cont trace:")
    console.log(contTrace)

fun debugEff(eff) =
  if eff is EffectSig then
    console.log("Debug EffectSig:")
    console.log("handler: ", eff.handler.constructor.name)
    console.log("handlerFun: ", eff.handlerFun)
    debugContTrace(eff.contTrace)
  else
    console.log("Not an effect:")
    console.log(eff)

//
//  contTrace  --> f3 --> f4 --> ...
//      v
//      h1     --> f1 --> f2 --> ...
//
//  becomes:
// 
//  contTrace  --> newFn --> f3 --> f4 --> ...
//      v
//      h1     --> f1 --> f2 --> ...
//
fun pushFrame(fn, vars) =
  let newFrame = new mut FunctionContFrame(curContTrace.next, fn, vars)
  if curContTrace.last === curContTrace do
    set curContTrace.last = newFrame
  set curContTrace.next = newFrame
  validateContTrace(curContTrace, "pushFrame")
  
fun popFrame(id) =
  if curContTrace.next === null do
    throw "INVALID CONT TRACE: next was null when popping " + id
  if curContTrace.next === curContTrace.last do
    set curContTrace.last = curContTrace
  set curContTrace.next = curContTrace.next.next
  validateContTrace(curContTrace, "popFrame")

data class EffectRaised(str)

mut val latestId = 0
fun mkEffect(handler, handlerFun) =
  let res = new mut EffectSig(curContTrace, handler, handlerFun, latestId)
  set latestId += 1
  set curEffect = res
  makeNewContTrace()
  throw EffectRaised("mkEffect")


//
//  contTrace  --> null
//      v
//      h2     --> f3 --> f4 --> ...
//      v
//      h1     --> f1 --> f2 --> ...
//
//  becomes:
//
//  contTrace  --> f3 --> f4 --> ...
//      v
//      h1     --> f2 --> f1 --> ...
//
fun popHandler(tr) =
  if tr.lastHandler === tr.nextHandler do
    set tr.lastHandler = tr
    if tr.last === tr.nextHandler do
      set tr.last = tr
  set
    tr.next = tr.nextHandler.next
    tr.nextHandler = tr.nextHandler.nextHandler
  validateContTrace(tr, "popHandler")

fun countFramesInTrace(tr) =
  let cnt = 0
  let curSegment = tr
  fun cntSegment() =
    while curSegment.next !== null do
      set curSegment = curSegment.next
      set cnt += 1
  cntSegment()
  while tr.nextHandler !== null do
    set tr = tr.nextHandler
    set curSegment = tr
    cntSegment()
    set cnt += 1
  cnt

fun validateContTrace(tr, loc) =
  fun errorSep =
    console.log("--------------------------------")
    console.log("!!! HANDLER VALIDATION ERROR !!!")
    console.log("--------------------------------")
    console.log("at:", loc)
  let remainIter = 100000
  let realLastHandler = tr
  while remainIter >= 0 and realLastHandler.nextHandler !== null do
    set remainIter -= 1
    set realLastHandler = realLastHandler.nextHandler
  let realLast = realLastHandler
  while remainIter >= 0 and realLast.next !== null do
    set realLast = realLast.next
  if remainIter < 0 do
    errorSep
    throw "INVALID CONT TRACE: infinite loop"
  if realLast !== tr.last do
    errorSep
    console.log("expected last:", realLast)
    console.dir(tr)
    throw "INVALID CONT TRACE: last is incorrect"
  if realLastHandler !== tr.lastHandler do
    errorSep
    console.dir(tr)
    throw "INVALID CONT TRACE: lastHandler is incorrect"
  
//
//  contTrace  --> f3 --> f4 --> ...
//      v
//      h1     --> f2 --> f1 --> ...
//
//  becomes:
// 
//  contTrace  --> null
//      v
//  newHandler --> f3 --> f4 --> ...
//      v
//      h1     --> f1 --> f2 --> ...
//
fun enterHandleBlock(handler, body) =
  let handlerFrame = new mut HandlerContFrame(curContTrace.next, curContTrace.nextHandler, handler)
  set
    curContTrace.nextHandler = handlerFrame
    curContTrace.next = null
  if curContTrace.lastHandler === curContTrace do
    set curContTrace.lastHandler = handlerFrame
  if curContTrace.last === curContTrace do
    set curContTrace.last = handlerFrame
  validateContTrace(curContTrace, "enterHandleBlock")
  let ret = body()
  popHandler(curContTrace)
  ret

fun myDebug(arg) =
  if true then console.dir(arg, {depth:10})
  else ()

mut val handleEffectsCall = 0
fun handleEffects(cur) =
  let curCall = handleEffectsCall
  set handleEffectsCall += 1
  while cur is
    EffectSig then
      let nxt = handleEffect(cur)
      if cur === nxt then
        set curEffect = cur
        throw throw EffectRaised("handleEffects")
      else
        set cur = nxt
    else
      return cur

fun checkUnhandledErr(err) =
  if curEffect === null do
    // console.log("unhandled error")
    throw err

fun concatTraces(bottom, top) =
  let expected = countFramesInTrace(bottom) + countFramesInTrace(top)
  if bottom.next !== null do
    set top.last.next = bottom.next
  if bottom.last !== bottom do
    set top.last = bottom.last
  if bottom.nextHandler !== null do
    set top.lastHandler.nextHandler = bottom.nextHandler
  if bottom.lastHandler !== bottom do
    set top.lastHandler = bottom.lastHandler
  if countFramesInTrace(top) !== expected do
    throw "Concat is wrong: incorrect number of frames"

// calling conventions:
// resume, resumeContTrace: throw exceptions when raising an effect, will link the newly called functions to the existing cont trace if an effect is raised
// handleEffect: does not throw exceptions, returns either a value or a cont trace
// handleEffects: throws an exception if there is an unhandled effect

// return either new effect, final result or the same continuation if there is no handler
fun handleEffect(cur) =
  validateContTrace(cur.contTrace, "handleEffect start")
  // debugEff(cur)
  // find the handle block corresponding to the current effect
  let prevHandlerFrame = cur.contTrace
  while prevHandlerFrame.nextHandler !== null and prevHandlerFrame.nextHandler.handler !== cur.handler do
    set prevHandlerFrame = prevHandlerFrame.nextHandler

  // no matching handle block
  if prevHandlerFrame.nextHandler === null do
    return cur

  // the matching handle block
  let handlerFrame = prevHandlerFrame.nextHandler
  
  // unlink and save frames
  let saved = new mut ContTrace(
    handlerFrame.next,
    cur.contTrace.last,
    handlerFrame.nextHandler,
    cur.contTrace.lastHandler,
    false
  )
  if cur.contTrace.last === handlerFrame do set saved.last = saved
  if cur.contTrace.lastHandler === handlerFrame do set saved.lastHandler = saved
  
  validateContTrace(saved, "saved cont frame")
  
  set
    cur.contTrace.last = handlerFrame
    cur.contTrace.lastHandler = handlerFrame
    handlerFrame.next = null
    handlerFrame.nextHandler = null
  
  validateContTrace(cur.contTrace, "frames passed to handler")
  
  // handle the effect
  set curEffect = null
  let tmp = set stackDepth += 2 in RuntimeJS.try_catch(() => cur.handlerFun(resume(cur.contTrace)), checkUnhandledErr)
  if curEffect !== null then
    set cur = curEffect
    validateContTrace(cur.contTrace, "frames after handling and effect raised")
    // relink the saved frames
    concatTraces(saved, cur.contTrace)
    validateContTrace(cur.contTrace, "relinked")
    cur
  else
    // resume the unlinked handle blocks
    let retVal = RuntimeJS.try_catch(() => resumeContTrace(saved, tmp), checkUnhandledErr)
    if curEffect !== null then curEffect
    else retVal

fun resume(contTrace)(value) =
  if contTrace.resumed do
    throw Error("Multiple resumption")
  set contTrace.resumed = true
  resumeContTrace(contTrace, value)

fun resumeContTrace(contTrace, value) =
  // Append these onto the resume frames later
  let savedResumeFrames = curContTrace
  set curContTrace = contTrace
  
  while
    contTrace.next is FunctionContFrame then
      let curFrame = contTrace.next
      set curEffect = null
      set value = set stackDepth += 3 in
        RuntimeJS.try_catch(() => curFrame.resume(value), err => checkUnhandledErr)
      if curEffect !== null do
        set value = curEffect
      if value is EffectSig then
        // add savedResumeFrames to the *bottom* of the current cont trace
        set contTrace = curEffect.contTrace
        set
          contTrace.resumed = false
          contTrace.last.next = savedResumeFrames.next
          contTrace.lastHandler.nextHandler = savedResumeFrames.nextHandler
        concatTraces(savedResumeFrames, contTrace)
        validateContTrace(curEffect.contTrace, "resumeContTrace")
        throw EffectRaised("resumeContTrace")
      else () // The frame is popped by the function upon returning
    contTrace.nextHandler is HandlerContFrame then
      popHandler(contTrace)
    else
      set curContTrace = savedResumeFrames
      return value

// stack safety
mut val stackLimit = 0 // How deep the stack can go before heapifying the stack
mut val stackDepth = 0
mut val stackHandler = null
mut val stackResume = null

object StackDelayHandler with
  fun delay() = mkEffect of this, k =>
    set stackResume = k

fun checkDepth() =
  if stackDepth >= stackLimit && stackHandler !== null then
    // this is a tail call to effectful function
    stackHandler.delay()
  else
    ()

fun runStackSafe(limit, f) =
  set stackLimit = limit in...
  set stackDepth = 1 in...
  set stackHandler = StackDelayHandler in...
  let result = enterHandleBlock(StackDelayHandler, f)
  if curEffect !== null do
    throw new Error("Effect crossed through stack safe boundary")
  while stackResume !== null do
    let saved = stackResume
    set
      stackResume = null
      stackDepth = 1
      result = saved(())
    if curEffect !== null do
      throw new Error("Effect crossed through stack safe boundary")
  result

class Int31(v) with
  fun zext() = bitand(v, bitnot(shl(1, 31))) as Int
  fun sext() = bitor(v, shl(1, 31)) as Int

fun plus_impl(lhs, rhs) = if lhs is
  Int31 and rhs is Int31 then lhs + rhs
  else unreachable
