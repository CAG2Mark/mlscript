import "../../../hkmc2/shared/src/test/mlscript-compile/Runtime.mls"
import "../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
import "./NofibPrelude.mls"
import "benchmark"
open Predef
open NofibPrelude

let b = benchmark

module BenchmarkPrelude with ...

fun not(x) = x === false

fun print(s) = s

fun helper(f) =
  Runtime.runStackSafe(2000, f)
  true

fun benchmark(fn) =
  // print(helper(fn))
  // print("benchmarking...")
  let suite = new b.Suite()
  suite.add("main", () => helper(fn))
  let settings = {}
  set settings.async = false
  suite.run(settings)
  Predef.print("Time: " + suite.0.stats.mean * 1000 + "ms")
  // let start = globalThis.performance.now()
  // let res = helper(fn)
  // let end = globalThis.performance.now()
  // Predef.print("Time: " + (end - start) + "ms")

set globalThis.Predef = Predef
