import "../../../hkmc2/shared/src/test/mlscript-compile/Predef.mls"
import "../../../hkmc2/shared/src/test/mlscript-compile/Stack.mls"
import "../precompiled/BenchmarkPrelude.mls"

open Predef { print }
open BenchmarkPrelude { helper }
open Stack

import "fs"
import "benchmark"

open Stack

fun sum(n) =
  if n == 0 then 0 else n + sum(n - 1)

fun fill(n, x) =
  if n == 0 then
    Nil
  else
    x :: fill(n - 1, x)

fun map(list, fn) =
  if list is
    h :: t then fn(h) :: map(t, fn)
    Nil then Nil

fun toString(st) =
  let result = "["
  while st is
    h :: t then
      set
        result += h.toString()
        st = t
      if t is Nil then
        return result + "]"
      else
        set result += ", "
    Nil then
      return "[]"

fun main(n) =
  map(fill(n, 10), sum) toString()

fun do_benchmark(fn) =
  print("benchmarking...")
  let suite = new benchmark.Suite()
  let data = {}
  set
    data.x = []
    data.y = []
    data.log = []
  let i = 50
  while i <= 15000 do
    suite.add(i, fn.bind(null, i))
    set i += 50
  suite.add("main", fn)
  let settings = {}
  set settings.async = false
  suite.on("cycle", (event) =>
    print(String(event.target))
    data.y.push(event.target.hz)
    data.log.push(String(event.target))
  ).on("complete", () =>
    fs.writeFileSync("./benchmark/data.json", JSON.stringify(data))
  ).run(settings)

do_benchmark(x => helper(() => main(x)))
